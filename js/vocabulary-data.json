{
  "unit1": {
    "title_en": "Rububiyyah",
    "title_ar": "الرُّبُوبِيَّةُ",
    "words": [
      {"ar": "خَالِق", "en": "Creator", "root": "خ ل ق", "example_ar": "اللَّهُ الْخَالِقُ", "example_en": "Allah is the Creator"},
      {"ar": "رَازِق", "en": "Provider", "root": "ر ز ق", "example_ar": "اللَّهُ الرَّازِقُ", "example_en": "Allah is the Provider"},
      {"ar": "مَالِك", "en": "Owner/King", "root": "م ل ك", "example_ar": "اللَّهُ الْمَالِكُ", "example_en": "Allah is the Owner"},
      {"ar": "عَالِم", "en": "All-Knowing", "root": "ع ل م", "example_ar": "اللَّهُ الْعَالِمُ", "example_en": "Allah is the All-Knowing"},
      {"ar": "قَدِير", "en": "All-Powerful", "root": "ق د ر", "example_ar": "اللَّهُ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ", "example_en": "Allah is capable of all things"},
      {"ar": "خَلْق", "en": "Creation", "root": "خ ل ق", "example_ar": "خَلْقَ السَّمَاوَاتِ وَالْأَرْضِ", "example_en": "Creation of the heavens and earth"}
    ]
  },
  "unit2": {
    "title_en": "Uloohiyyah",
    "title_ar": "الْإِلَٰهِيَّةُ",
    "words": [
      {"ar": "عِبَادَة", "en": "Worship", "root": "ع ب د", "example_ar": "وَمَا خَلَقْتُ الْجِنَّ وَالْإِنسَ إِلَّا لِيَعْبُدُونِ", "example_en": "I did not create jinn and mankind except to worship Me"},
      {"ar": "دُعَاء", "en": "Supplication", "root": "د ع و", "example_ar": "ادْعُونِي أَسْتَجِبْ لَكُمْ", "example_en": "Call upon Me; I will respond to you"},
      {"ar": "تَوْحِيد", "en": "Monotheism", "root": "و ح د", "example_ar": "قُلْ هُوَ اللَّهُ أَحَدٌ", "example_en": "Say: He is Allah, the One"},
      {"ar": "صَلَاة", "en": "Prayer", "root": "ص ل و", "example_ar": "أَقِيمُوا الصَّلَاةَ", "example_en": "Establish prayer"},
      {"ar": "تَوَكُّل", "en": "Reliance on Allah", "root": "و ك ل", "example_ar": "تَوَكَّلْتُ عَلَى اللَّهِ", "example_en": "I put my trust in Allah"},
      {"ar": "خُشُوع", "en": "Humility", "root": "خ ش ع", "example_ar": "قَدْ أَفْلَحَ الْمُؤْمِنُونَ الَّذِينَ هُمْ فِي صَلَاتِهِمْ خَاشِعُونَ", "example_en": "Successful indeed are the believers who are humble in their prayers"}
    ]
  },
  "unit3": {
    "title_en": "Islam",
    "title_ar": "الإِسْلَامُ",
    "words": [
      {"ar": "إِسْلَام", "en": "Submission to Allah", "root": "س ل م", "example_ar": "إِنَّ الدِّينَ عِنْدَ اللَّهِ الْإِسْلَامُ", "example_en": "Indeed, the religion in the sight of Allah is Islam"},
      {"ar": "إِيمَان", "en": "Faith", "root": "أ م ن", "example_ar": "آمَنَ الرَّسُولُ بِمَا أُنزِلَ إِلَيْهِ", "example_en": "The Messenger has believed in what was revealed"},
      {"ar": "شَهَادَة", "en": "Testimony", "root": "ش ه د", "example_ar": "أَنْ لَا إِلَٰهَ إِلَّا اللَّهُ", "example_en": "That there is no deity except Allah"},
      {"ar": "إِحْسَان", "en": "Excellence/Beauty", "root": "ح س ن", "example_ar": "أَنْ تَعْبُدَ اللَّهَ كَأَنَّكَ تَرَاهُ", "example_en": "To worship Allah as though you see Him"},
      {"ar": "صَبْر", "en": "Patience", "root": "ص ب ر", "example_ar": "إِنَّ اللَّهَ مَعَ الصَّابِرِينَ", "example_en": "Indeed, Allah is with the patient"},
      {"ar": "قُرْآن", "en": "Quran", "root": "ق ر أ", "example_ar": "إِنَّ هَٰذَا الْقُرْآنَ يَهْدِي لِلَّتِي هِيَ أَقْوَمُ", "example_en": "Indeed, this Quran guides to that which is most suitable"}
    ]
  }
}
