{
    "lines":  [
                  {
                      "y":  210,
                      "x":  272,
                      "text":  "الدرس",
                      "y2":  210
                  },
                  {
                      "y":  295,
                      "x":  288,
                      "text":  "الأول",
                      "y2":  295
                  },
                  {
                      "y":  244,
                      "x":  668,
                      "text":  "التيمم",
                      "y2":  244
                  },
                  {
                      "y":  427,
                      "x":  169,
                      "text":  "وحان نسيارة، وقود نفد الطريق وأثناء مكة، إلى ويوسف خالد ابنيه مع محمد سافر",
                      "y2":  455
                  },
                  {
                      "y":  487,
                      "x":  168,
                      "text":  "ابنيه بسؤال الوالد فبادر الوقت خروج وخشوا مام، معهم يكن ول الفجر، صلاة وقت",
                      "y2":  502
                  },
                  {
                      "y":  559,
                      "x":  695,
                      "text":  "الموقف. هذا مثر في الصحيح التصرف عن",
                      "y2":  571
                  },
                  {
                      "y":  637,
                      "x":  486,
                      "text":  "الوقت. خرج وإن الماء، وجدنا ما متى نصلي يوسف: قال",
                      "y2":  663
                  },
                  {
                      "y":  699,
                      "x":  192,
                      "text":  "وإذا وقنها، عن الصلاة نؤخر أن لنا لايجوز أنه المدرسة في تعلمت خالد: فقال",
                      "y2":  724
                  },
                  {
                      "y":  760,
                      "x":  192,
                      "text":  "بهما وجهه يمس",
                      "y2":  772
                  },
                  {
                      "y":  762,
                      "x":  441,
                      "text":  "ثم واحدة، ضربة بيديه التراب يضرب فإنه الماء الإنسان فقد",
                      "y2":  778
                  },
                  {
                      "y":  821,
                      "x":  788,
                      "text":  "كفيه. ظاهر",
                      "y2":  830
                  },
                  {
                      "y":  832,
                      "x":  946,
                      "text":  "تت واحدة، مرة",
                      "y2":  837
                  },
                  {
                      "y":  878,
                      "x":  748,
                      "text":  "إجابته. لصحة خالد؛ على الوالد أثنى",
                      "y2":  891
                  },
                  {
                      "y":  962,
                      "x":  323,
                      "text":  "خالد؟ درسه الذي الموضوع عرفت هل قرأته: الذي الحوار هذا خلال من",
                      "y2":  980
                  },
                  {
                      "y":  1041,
                      "x":  486,
                      "text":  "مناسبا. تعريفا وعزفه عليه، التعرف في وزملاءك معلمك شارك",
                      "y2":  1061
                  },
                  {
                      "y":  1134,
                      "x":  1114,
                      "text":  "هو: التيمه",
                      "y2":  1154
                  },
                  {
                      "y":  1253,
                      "x":  708,
                      "text":  "التيمم جواز على الدليل",
                      "y2":  1253
                  },
                  {
                      "y":  1339,
                      "x":  216,
                      "text":  "هتـه وأيديكم هكم ابوجو اطيـبافأمحو فتيمموأصعيد تهدوام، فلم : تعالى الله قال",
                      "y2":  1365
                  },
                  {
                      "y":  1446,
                      "x":  626,
                      "text":  "التيمم فيها يشرع التي الحالات",
                      "y2":  1461
                  },
                  {
                      "y":  1553,
                      "x":  795,
                      "text":  "الماء. يجد لم إذا",
                      "y2":  1559
                  },
                  {
                      "y":  1629,
                      "x":  479,
                      "text":  "به: يتوضا أن يستطيع لا ماي عنده أوكان",
                      "y2":  1647
                  },
                  {
                      "y":  1689,
                      "x":  815,
                      "text":  "مريضا. لكونه",
                      "y2":  1697
                  },
                  {
                      "y":  1762,
                      "x":  833,
                      "text":  "جردح أو",
                      "y2":  1779
                  },
                  {
                      "y":  1808,
                      "x":  315,
                      "text":  "الماء. به يسخن ما يجد ولم شديد، برد هناك كان أو",
                      "y2":  1834
                  },
                  {
                      "y":  1873,
                      "x":  1069,
                      "text":  ". ؟ المائدة:أية سورة (١)",
                      "y2":  1888
                  },
                  {
                      "y":  1874,
                      "x":  1276,
                      "text":  "١٠٨",
                      "y2":  1874
                  }
              ],
    "image":  "page-109.png"
}