{
    "lines":  [
                  {
                      "y":  208,
                      "x":  577,
                      "text":  "المقدمة",
                      "y2":  208
                  },
                  {
                      "y":  388,
                      "x":  177,
                      "text":  "سيئات ومن أنفسنا شرور من بالله ونعوذ ونستغفره، ونستعينه نحمده، لله الحمد إن",
                      "y2":  403
                  },
                  {
                      "y":  471,
                      "x":  170,
                      "text":  "الله إلا زلة ألا وأشهد له، هادي فلا يشلل ومن له، مضل فلا الله يهده من أعمالنا،",
                      "y2":  486
                  },
                  {
                      "y":  555,
                      "x":  493,
                      "text":  "ورشولة. عبده محمدا أن وأشهد له، شريك لا وحده",
                      "y2":  570
                  },
                  {
                      "y":  640,
                      "x":  1130,
                      "text":  "بعد: أما",
                      "y2":  642
                  },
                  {
                      "y":  718,
                      "x":  177,
                      "text":  "الأمور وشر محمديو، هذي الهذي وخير الله، كتاب الحديث أصدق فإن",
                      "y2":  734
                  },
                  {
                      "y":  805,
                      "x":  274,
                      "text":  "النار. في ضلالة وكل ضلالة، بدعة وكل بدعة، محدثة وكل محدثاتها،",
                      "y2":  822
                  },
                  {
                      "y":  891,
                      "x":  1130,
                      "text":  "بعد: أما",
                      "y2":  893
                  },
                  {
                      "y":  971,
                      "x":  179,
                      "text":  "الله من هبة لاد فالأو لاد؛ الأو هبة عبده: عزوجل الله وهبها التي الهبات أعظم من فإن",
                      "y2":  984
                  },
                  {
                      "y":  1058,
                      "x":  270,
                      "text":  "الذني الحيوة زينة والبئون المال تعالئ: قال الدنيا، الحياة زينة وهم جوعلا،",
                      "y2":  1072
                  },
                  {
                      "y":  1153,
                      "x":  1073,
                      "text":  "٤٤٦. (الكهف:",
                      "y2":  1153
                  },
                  {
                      "y":  1224,
                      "x":  470,
                      "text":  "الفانية. الدنيا هذه زينة الكثيرون والبنون الوفير الكثير المال",
                      "y2":  1236
                  },
                  {
                      "y":  1303,
                      "x":  175,
                      "text":  "في ومبادئه أصوله وغرس تباروتعالل، الله دين تعليمهم لاد: الأو حقوقي أعظم ومن",
                      "y2":  1321
                  },
                  {
                      "y":  1385,
                      "x":  170,
                      "text":  "فيبدا التمييز، سن يبلغون عندما لاد الأو تعليم فـ«يبدا أظفارهم، نعومة مند نفوسهم",
                      "y2":  1396
                  },
                  {
                      "y":  1475,
                      "x":  965,
                      "text":  "الدينية. التربية تعليمهم",
                      "y2":  1477
                  },
                  {
                      "y":  1555,
                      "x":  178,
                      "text":  "علن يربيه وأن يعلمه، بأن والده يؤمر -جيتئذ- فإنه التمييز؛ سن الطفل بلغ فإذا",
                      "y2":  1568
                  },
                  {
                      "y":  1638,
                      "x":  172,
                      "text":  "التي الشرعية الأحكام ويعلمه الأحاديث، من تيسر وما القرآن، يعلمه بأن الخير؛",
                      "y2":  1653
                  },
                  {
                      "y":  1718,
                      "x":  171,
                      "text":  "الني الأذكار ويعلمه يصلي، وكيف يتوشا، كيف بعلمة بأن الطفل؛ هذا سن مناسب",
                      "y2":  1732
                  },
                  {
                      "y":  1803,
                      "x":  174,
                      "text":  "فإنه... التمبيز سن بلغ إذا لأنه والشرب؛ الأكل وعند الاستيقاظ، وبعد النوم، عند ثقال",
                      "y2":  1816
                  }
              ],
    "image":  "page-006.png"
}