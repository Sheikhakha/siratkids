                  },
                  {
                      "y":  439,
                      "x":  588,
                      "text":  "لختى الأسمة وينه تعالى: الله قال",
                      "y2":  453
                  },
                  {
                      "y":  516,
                      "x":  678,
                      "text":  "حسنى الله أسماء أن معنى",
                      "y2":  533
                  },
                  {
                      "y":  609,
                      "x":  586,
                      "text":  "ت الله دعاة العبادة لأ١",
                      "y2":  632
                  },
                  {
                      "y":  613,
                      "x":  835,
                      "text":  "وي افس بمن",
                      "y2":  625
                  },
                  {
                      "y":  699,
                      "x":  471,
                      "text":  "تعالى: الله أسماء من يناسبه بما دعاء كل اربط",
                      "y2":  721
                  },
                  {
                      "y":  920,
                      "x":  414,
                      "text":  "حلالا مالا رزقني",
                      "y2":  929
                  },
                  {
                      "y":  1040,
                      "x":  407,
                      "text":  "بطاعتك. أكرمني",
                      "y2":  1053
                  },
                  {
                      "y":  1153,
