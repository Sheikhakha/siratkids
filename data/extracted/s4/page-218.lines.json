                  {
                      "y":  753,
                      "x":  220,
                      "text":  ") لغانا». ولا فحاشا، ولا سبابا، ؤ: النبى يكن «له قال: رن مالك بن أنس عن",
                      "y2":  788
                  },
                  {
                      "y":  838,
                      "x":  205,
                      "text":  "ولامتفحشا فاحشا يو النبي يكن له قال: شتيه عمرو بن عبدالله عن",
                      "y2":  870
                  },
                  {
                      "y":  920,
                      "x":  531,
                      "text":  "، أخلاقا». أحسنكم خياركم من «إن يقول: وكان",
                      "y2":  951
                  },
                  {
                      "y":  1028,
                      "x":  751,
                      "text":  "الحديث معاني على أتعرف",
                      "y2":  1049
                  },
                  {
                      "y":  1133,
                      "x":  165,
                      "text":  "النبيؤ أن يخبرنا كثيرا وجالسه يجو الرسول خدم الذي مر مالك بن أنس",
                      "y2":  1163
                  },
                  {
                      "y":  1139,
                      "x":  1038,
                      "text":  "الله",
                      "y2":  1139
                  },
                  {
                      "y":  1208,
                      "x":  724,
                      "text":  ". يكر فلم الشي، بالكلام يتكلم يكن لم",
                      "y2":  1222
                  },
                  {
