                      "text":  "النشور؟ وإليه معنى: ما",
                      "y2":  189
                  },
                  {
                      "y":  246,
                      "x":  596,
                      "text":  "الموت. بعد القبور من والبعث الإحياء هو النشور:",
                      "y2":  265
                  },
                  {
                      "y":  315,
                      "x":  168,
                      "text":  "بيوم الله،وتذكير بعبادة منها نستفيد الحياة؛حتى بنعمة تذكير الدعاء هذا وفي",
                      "y2":  335
                  },
                  {
                      "y":  375,
                      "x":  708,
                      "text":  "الصالحة. بالأعمال له نستعد",
                      "y2":  381
                  },
                  {
                      "y":  392,
                      "x":  1203,
                      "text":  "القيامة",
                      "y2":  392
                  },
                  {
                      "y":  463,
                      "x":  561,
                      "text":  "حذيفة الجليل الصحابي على أتعرف",
                      "y2":  472
                  },
                  {
                      "y":  491,
                      "x":  482,
                      "text":  "اع",
                      "y2":  491
                  },
                  {
                      "y":  569,
                      "x":  806,
                      "text":  "العبسي اليمان بن حذيفة اسمه: د",
                      "y2":  593
                  },
                  {
                      "y":  636,
                      "x":  167,
                      "text":  "إليه أسر إذ يطؤ الله رسول سر صاحب يسمى: وكان للسر، حافظا أمينا كان صفاته: ى",
                      "y2":  649
                  },
                  {
                      "y":  701,
                      "x":  166,
                      "text":  "بن عمر الوسظي،وجعله آسيا في كثيرة بلادا فتح شجاع، فائد وهو المنافقين، بعض باسماء",
                      "y2":  734
                  },
                  {
                      "y":  786,
                      "x":  894,
                      "text":  "ائن. اثد على اميرا سي اخطاب",
                      "y2":  801
                  },
                  {
                      "y":  856,
                      "x":  838,
                      "text":  ". ميي هـ ٣٦ سنة توفي وفاته:",
                      "y2":  887
                  },
                  {
                      "y":  975,
                      "x":  200,
                      "text":  "للنوم؟ وتهيا فراشه، إلى ذهب إذا النوم أذكار يقول ؤ النبي كان لماذا",
                      "y2":  984
                  },
                  {
                      "y":  1199,
                      "x":  1061,
                      "text":  "اي قطي",
                      "y2":  1212
                  },
                  {
                      "y":  1305,
                      "x":  685,
                      "text":  "ن النبكي",
                      "y2":  1307
                  },
                  {
                      "y":  1466,
                      "x":  438,
                      "text":  "استيقظ إذا",
                      "y2":  1468
                  },
                  {
                      "y":  1579,
                      "x":  491,
                      "text":  "قال",
                      "y2":  1579
                  },
                  {
                      "y":  1681,
                      "x":  328,
                      "text":  "ما بعد أحيانا الذي لله احمد",
                      "y2":  1704
                  },
                  {
                      "y":  1767,
                      "x":  386,
                      "text":  "النشور وإليه أماتنا",
                      "y2":  1771
                  },
                  {
                      "y":  1864,
                      "x":  72,
                      "text":  "١٨٧",
                      "y2":  1864
                  },
                  {
                      "y":  1459,
                      "x":  849,
                      "text":  "فراشه إلى أوى إذا",
                      "y2":  1465
                  },
                  {
                      "y":  1575,
                      "x":  946,
                      "text":  "قال",
                      "y2":  1575
                  },
                  {
                      "y":  1688,
                      "x":  792,
                      "text":  "وأحيا أموت اللهم باسمك",
                      "y2":  1693
