                      "text":  "والطهارة الوضوء وحدة",
                      "y2":  101
                  },
                  {
                      "y":  392,
                      "x":  704,
                      "text":  "دورات ارتياد إلى الناس بعض يحتاج قد",
                      "y2":  408
                  },
                  {
                      "y":  462,
                      "x":  598,
                      "text":  "هس أاو المساجد، إلى ذهابهم عند العامة المياه",
                      "y2":  471
                  },
                  {
                      "y":  528,
                      "x":  577,
                      "text":  "إلف أن ويحب غيرها، أو الحدائق، أو الاسواق،",
                      "y2":  539
                  },
                  {
                      "y":  603,
                      "x":  705,
                      "text":  "النظافة، من حيدة حالة في وهى يدخلها،",
                      "y2":  622
                  },
                  {
                      "y":  665,
                      "x":  704,
                      "text":  "وأجهزة المياه، صنابير من مكوناتها وسلامة",
                      "y2":  688
                  },
                  {
                      "y":  740,
                      "x":  688,
                      "text":  "يسيء الناس بعض أن إلا وغيرها، التصريف،",
                      "y2":  761
                  },
                  {
                      "y":  806,
                      "x":  407,
                      "text":  "استعمالها. بعد العامة المياه بدورات عنايته بعدم المسلمين إخوانه إلى",
                      "y2":  818
                  },
                  {
                      "y":  982,
                      "x":  387,
                      "text":  "العـلاج",
                      "y2":  982
                  },
                  {
                      "y":  875,
                      "x":  725,
                      "text":  ". التالي الجدول املا زملائك، مع بالتعاون",
                      "y2":  894
                  },
                  {
                      "y":  972,
                      "x":  779,
                      "text":  "المياه بدورات العناية لعدم أمثلة",
                      "y2":  990
                  },
                  {
                      "y":  1130,
                      "x":  783,
                      "text":  "وأبوابها جدرانها على الكتابة",
                      "y2":  1140
                  },
