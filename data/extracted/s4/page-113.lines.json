{
    "lines":  [
                  {
                      "y":  90,
                      "x":  1015,
                      "text":  "التيمم وحدة",
                      "y2":  92
                  },
                  {
                      "y":  224,
                      "x":  370,
                      "text":  "سعرر لهه لم وإلدموم",
                      "y2":  275
                  },
                  {
                      "y":  418,
                      "x":  254,
                      "text":  "النيه: ممطلات منه واسنتغرح بتمعن، العوار هدا افرا «ه",
                      "y2":  462
                  },
                  {
                      "y":  514,
                      "x":  328,
                      "text":  "خير؟ لكل الله وفقك بسؤال لي أتاذن معلمي يا التلميذ:",
                      "y2":  531
                  },
                  {
                      "y":  596,
                      "x":  570,
                      "text":  "لك. بدا ما سل بني يا تفضل المعلم:",
                      "y2":  612
                  },
                  {
                      "y":  662,
                      "x":  169,
                      "text":  "وقت وحان كثير، ماء معي يكن ولم برية نزهة في كنت إذا التلميذ:",
                      "y2":  683
                  },
                  {
                      "y":  735,
                      "x":  169,
                      "text":  "صلاة وقت حضر حتى وبقيت الظهر، وصليت وتيممت، الصلاة",
                      "y2":  748
                  },
                  {
                      "y":  806,
                      "x":  445,
                      "text":  "السابق؟ بالتيمم أصلي أن لي يجوز فهل العصر،",
                      "y2":  815
                  },
                  {
                      "y":  871,
                      "x":  169,
                      "text":  "الماء لك تيسر إذا أما الماء، تجد لم ما به تصلي بني، يا نعم المعلم:",
                      "y2":  887
                  },
                  {
                      "y":  944,
                      "x":  174,
                      "text":  "العصر. لصلاة الوضوء عليك ويجب يبطل، التيمم فإن نه تتوضأ الذي",
                      "y2":  960
                  },
                  {
                      "y":  1011,
                      "x":  170,
                      "text":  "معلمي؟ يا تيممي ينتقص فهل إبل، لحم الغداء طعام في كان لو وماذا التلميذ:",
                      "y2":  1019
                  },
                  {
                      "y":  1080,
                      "x":  169,
                      "text":  "بني يا التيمم فإن السؤال، هذا بطرحك بني يا أحسنت المعلم:",
                      "y2":  1096
                  },
                  {
                      "y":  1150,
                      "x":  358,
                      "text":  "درستها. التي الوضوء نواقض بجميع ينتقض كالوضوء،",
                      "y2":  1166
                  },
                  {
                      "y":  1204,
                      "x":  174,
                      "text":  "سابقا. درسناها التي الوضوء بنواقض معلمي يا كرني تذ لعلك التلميذ:",
                      "y2":  1223
                  },
                  {
                      "y":  1285,
                      "x":  169,
                      "text":  "فإذا دراستها، لك سبق لأنه تذكرها، أن عليك الذي أنت بل المعلم:",
                      "y2":  1301
                  },
                  {
                      "y":  1354,
                      "x":  287,
                      "text":  "عرفتها. التي التيمم نواقض مع كتابك، في فسجلها تذكرتها",
                      "y2":  1373
                  },
                  {
                      "y":  1411,
                      "x":  191,
                      "text":  "خيرا. الله وجزاك معلمي، يا لك وشكرا الله، شاء إن سأدعل التلميذ:",
                      "y2":  1430
                  },
                  {
                      "y":  1480,
                      "x":  675,
                      "text":  ". بني با فيك الله بارك المعلم:",
                      "y2":  1522
                  },
                  {
                      "y":  1577,
                      "x":  177,
                      "text":  ": دفترك فى التالي المخطط إكمال خلال من فهمك من تحقق",
                      "y2":  1593
                  },
                  {
                      "y":  1853,
                      "x":  220,
                      "text":  "التيمم مبطلات",
                      "y2":  1855
                  },
                  {
                      "y":  1672,
                      "x":  571,
                      "text":  "التيمم",
                      "y2":  1672
                  },
                  {
                      "y":  1855,
                      "x":  551,
                      "text":  "التيمم شروط",
                      "y2":  1855
                  },
                  {
                      "y":  1847,
                      "x":  813,
                      "text":  "التيمم فيها يشرع التي الحالات",
                      "y2":  1856
                  },
