                      "y2":  703
                  },
                  {
                      "y":  754,
                      "x":  394,
                      "text":  "ويكثر عليه، يحافظ ؤؤ النبل كان رقد المرسلين، سن من السواك",
                      "y2":  789
                  },
                  {
                      "y":  822,
                      "x":  1059,
                      "text":  "عليه. الخث",
