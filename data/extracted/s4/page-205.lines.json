{
    "lines":  [
                  {
                      "y":  177,
                      "x":  661,
                      "text":  "بالدخول. الإذن طلب هو الاستئذان الوالد:",
                      "y2":  206
                  },
                  {
                      "y":  258,
                      "x":  893,
                      "text":  "ثلاثا؟ يكون وكيف خالد،",
                      "y2":  277
                  },
                  {
                      "y":  347,
                      "x":  138,
                      "text":  "مرات، ثلاث الجرس أو الباب على بالطرق أو بالكلام إما الإذن تطلب يعني الوالد:",
                      "y2":  375
                  },
                  {
                      "y":  427,
                      "x":  423,
                      "text":  "طويلا، الجرس على أصبعك وضعت عندما فعلت كما وليس",
                      "y2":  455
                  },
                  {
                      "y":  531,
                      "x":  809,
                      "text":  "متتابعة؟ الثلاث هذه هل محمد:",
                      "y2":  535
                  },
                  {
                      "y":  610,
                      "x":  442,
                      "text":  "حتى مناسب، فاصل بينها يكون أن الأفضل بل لا، الوالد:",
                      "y2":  629
                  },
                  {
                      "y":  612,
                      "x":  136,
                      "text":  "البيت في من يستعد",
                      "y2":  623
                  },
                  {
                      "y":  683,
                      "x":  1032,
                      "text":  "المكان. يرتب أو",
                      "y2":  698
                  },
                  {
                      "y":  772,
                      "x":  638,
                      "text":  "أحدب علي يرد ولم ثلاثا استاذنت وإذا خالد:",
                      "y2":  785
                  },
                  {
                      "y":  856,
                      "x":  135,
                      "text":  "مشغولا البيت صاحب يكون قد لأنه أتيت، حيث من وتعود ترجع الوالد:",
                      "y2":  886
                  },
                  {
                      "y":  1023,
                      "x":  718,
                      "text":  "يسمع ل أيضا يكون قد ولكن محمد:",
                      "y2":  1054
                  },
                  {
                      "y":  1034,
                      "x":  555,
                      "text":  ". الاستئذان",
                      "y2":  1064
                  },
                  {
                      "y":  1111,
                      "x":  133,
                      "text":  "تظن حتى الاستثذان في تزيد أن باس فلا يسمع، لم أنه ظنك على غلب إذا الوالد:",
                      "y2":  1140
                  },
                  {
                      "y":  1207,
                      "x":  1238,
                      "text":  "أنه",
                      "y2":  1207
                  },
                  {
                      "y":  1286,
                      "x":  512,
                      "text":  "؟ أبنائي يا نقف أين نستأذن ونحن ولكن محمد: والد",
                      "y2":  1297
                  },
                  {
                      "y":  1371,
                      "x":  1019,
                      "text":  ". الباب أمام خالد:",
                      "y2":  1403
                  },
                  {
                      "y":  1456,
                      "x":  866,
                      "text":  "صحيح. غير هذا ؛ لا الوالد:",
                      "y2":  1467
                  },
                  {
                      "y":  1544,
                      "x":  1044,
                      "text":  "أبن؟ إذا محمد:",
                      "y2":  1553
                  },
                  {
                      "y":  1623,
                      "x":  136,
                      "text":  "أن قبل المنزل، داخل إلى ننظر لا حتى يساره، أو الباب يمين عن الوالد:",
                      "y2":  1642
                  },
                  {
                      "y":  1703,
                      "x":  1137,
                      "text":  "لنا. يؤذن",
                      "y2":  1714
                  },
                  {
                      "y":  1782,
                      "x":  239,
                      "text":  "والاخرة. الدنيا في ووفقك إليك الله وأحسن خيرا الله جزاك ومحمد: خالد",
                      "y2":  1802
                  },
                  {
                      "y":  1855,
                      "x":  1299,
                      "text":  "٢٠٤",
                      "y2":  1855
                  }
              ],
    "image":  "page-205.png"
}