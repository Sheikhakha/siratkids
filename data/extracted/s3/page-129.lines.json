    "lines":  [
                  {
                      "y":  157,
                      "x":  387,
                      "text":  "- يؤ-١ النبي أوصاف",
                      "y2":  208
                  },
                  {
                      "y":  125,
                      "x":  1202,
                      "text":  "الدرس",
                      "y2":  125
                  },
                  {
                      "y":  463,
                      "x":  149,
                      "text":  "رأيته، كنث لو واتمنى يؤؤو، اسمائه على تعرفت وقد يهو، محمدا النبئ أحب",
                      "y2":  486
                  },
                  {
                      "y":  560,
                      "x":  995,
                      "text":  "يؤ؟ أوصافه فما",
                      "y2":  568
                  },
                  {
                      "y":  648,
                      "x":  906,
                      "text":  "أوصافا",
                      "y2":  648
                  },
                  {
                      "y":  732,
                      "x":  883,
                      "text":  "بيوم النبي بشرة لوت ما",
                      "y2":  754
                  },
                  {
                      "y":  825,
                      "x":  711,
                      "text":  "بحمرة. مشربا اللون أبيض يهو النبي كان",
                      "y2":  846
                  },
                  {
                      "y":  898,
                      "x":  710,
                      "text":  "قصيرا؟ أو طويلا يي النبي كان هل",
                      "y2":  925
                  },
                  {
                      "y":  998,
                      "x":  635,
                      "text":  "بالقصير. ولا بالطويل ليس ربعة يهو النبي كان",
                      "y2":  1014
                  },
                  {
                      "y":  1080,
                      "x":  841,
                      "text":  "ي؟ النبي وجه أوصاف ما",
                      "y2":  1090
                  },
                  {
                      "y":  1162,
                      "x":  567,
                      "text":  "مشربا أبيض وجهه كان وجها، الناس احسن يجو النبي",
                      "y2":  1175
                  },
                  {
                      "y":  1245,
                      "x":  646,
                      "text":  "وجماله. نوره في البدر ليلة القمر يشبه بحمرة،",
                      "y2":  1264
                  },
                  {
                      "y":  1322,
                      "x":  671,
                      "text":  "كثيفة. لخية له الشعر، سواد شديد كان",
                      "y2":  1338
                  },
                  {
                      "y":  1414,
                      "x":  567,
                      "text":  "ونبسم سر وإذا وجهه، احمر غضب إذا كان",
                      "y2":  1427
                  },
                  {
                      "y":  1490,
                      "x":  410,
                      "text":  "نبشما. الناس أكثر وكان ذهب، قطعة كانه حتى وجهه استنار",
                      "y2":  1521
                  },
                  {
                      "y":  1580,
                      "x":  184,
                      "text":  "النبي قدم الما : يريهن سلام بن عبدالله قال يكذب، لا أنه علم يؤ وجهه رأى من",
                      "y2":  1610
                  },
                  {
                      "y":  1666,
                      "x":  135,
                      "text":  "بوجه ليس وجهه أن عرفت وجهه رأيت فلما وجهه، لأنظر الناس في جئت المدينة",
                      "y2":  1679
                  },
                  {
                      "y":  1759,
                      "x":  1124,
                      "text":  ") »( كذا",
                      "y2":  1761
                  },
                  {
                      "y":  1835,
                      "x":  554,
                      "text":  "). (١٣٣٤ برقم: ماجه، وابن ٢٤٨٥)، ( برقم: الترمذي، أخرجه ) ١ (",
                      "y2":  1842
                  },
                  {
