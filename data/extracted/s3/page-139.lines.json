{
    "lines":  [
                  {
                      "y":  150,
                      "x":  404,
                      "text":  "الناس أفضل يو النبي",
                      "y2":  203
                  },
                  {
                      "y":  125,
                      "x":  1202,
                      "text":  "الدرس",
                      "y2":  125
                  },
                  {
                      "y":  600,
                      "x":  263,
                      "text":  ". الله عند وفضلهم وقدراتهم، صفاتهم، في يختلفون سواء؛ ليسوا الناس",
                      "y2":  638
                  },
                  {
                      "y":  683,
                      "x":  865,
                      "text":  "الله؟ عند الناس أفضل فمن",
                      "y2":  698
                  },
                  {
                      "y":  881,
                      "x":  738,
                      "text":  "الناس: أفضل على أتعرف",
                      "y2":  890
                  },
                  {
                      "y":  1002,
                      "x":  883,
                      "text":  "وأبيه: خالد بين حوار جرى",
                      "y2":  1019
                  },
                  {
                      "y":  1081,
                      "x":  676,
                      "text":  ". الناس أفضل فأنت أبي يا أحبك أنا خالد:",
                      "y2":  1120
                  },
                  {
                      "y":  1162,
                      "x":  509,
                      "text":  ". الناس أفضل لست ولكني خالد، يا أحبك وأنا الأب:",
                      "y2":  1201
                  },
                  {
                      "y":  1249,
                      "x":  298,
                      "text":  "على. وأنفقت تربيتي أحسنت فأنت ؟ الناس أفضل لست ولماذا خالد:",
                      "y2":  1263
                  },
                  {
                      "y":  1325,
                      "x":  134,
                      "text":  "فضل لي يكن ولم الناس، جميع على أنفق لم ولكني خالد؛ يا صحيح هذا : الأب",
                      "y2":  1351
                  },
                  {
                      "y":  1417,
                      "x":  1018,
                      "text":  ". الناس جميع على",
                      "y2":  1444
                  },
                  {
                      "y":  1484,
                      "x":  702,
                      "text":  ". الناس أفضل هو أحد يوجد لا إذا خالد:",
                      "y2":  1526
                  },
                  {
                      "y":  1567,
                      "x":  135,
                      "text":  "هداية في الله بعد الفضل فله الناس، أفضل يي محمد فنبينا خالد، يا بلى الأب:",
                      "y2":  1589
                  },
                  {
                      "y":  1662,
                      "x":  914,
                      "text":  "بدينهم. وتبصيرهم الناس",
                      "y2":  1669
                  },
                  {
                      "y":  1722,
                      "x":  469,
                      "text":  ". يه النبي فضائل من شيئا والدي يا لي ذكرت هلا خالد:",
                      "y2":  1761
                  },
                  {
                      "y":  1859,
                      "x":  1306,
                      "text":  "٣٨",
                      "y2":  1859
                  }
              ],
    "image":  "page-139.png"
}