{
    "lines":  [
                  {
                      "y":  195,
                      "x":  369,
                      "text":  "والصداقة الأخوة آداب ود",
                      "y2":  204
                  },
                  {
                      "y":  473,
                      "x":  269,
                      "text":  "المسلم، -ايها حياتك في مهم شيء والأخوة الصخبة",
                      "y2":  500
                  },
                  {
                      "y":  586,
                      "x":  267,
                      "text":  "بها، تتحلن أن لك ينبغي جميلة ادابا لهما فإن ولذلك",
                      "y2":  603
                  },
                  {
                      "y":  708,
                      "x":  920,
                      "text":  "الآداب: تلك ومن",
                      "y2":  714
                  },
                  {
                      "y":  809,
                      "x":  205,
                      "text":  "ا ويتخلق يصلي من تصاحب أن",
                      "y2":  830
                  },
                  {
                      "y":  940,
                      "x":  568,
                      "text":  "على سيعينك لآنه الحسنة؛ بالأخلاق",
                      "y2":  955
                  },
                  {
                      "y":  1067,
                      "x":  945,
                      "text":  "عرهجل. الله طاعة",
                      "y2":  1076
                  },
                  {
                      "y":  1168,
                      "x":  568,
                      "text":  "من ولا يصلي، لا من تصاحب ولا",
                      "y2":  1183
                  },
                  {
                      "y":  1281,
                      "x":  218,
                      "text":  "القبيح؛ الخلق صاحب ولا الناس، يشتم من ولا يكذب،",
                      "y2":  1298
                  },
                  {
                      "y":  1381,
                      "x":  741,
                      "text":  ". مثله سينا سيجعلك لأنه",
                      "y2":  1444
                  },
                  {
                      "y":  1387,
                      "x":  748,
                      "text":  "(ا) وم-و وه",
                      "y2":  1397
                  },
                  {
                      "y":  1523,
                      "x":  205,
                      "text":  "الصالح الجليس مثل «إنما قال: ج النبي عن يخي، الأشعري موسن أبي عن (١)",
                      "y2":  1539
                  },
                  {
                      "y":  1594,
                      "x":  206,
                      "text":  "وإما يخذيك، أن إما المشك: فحامل الكير، ونافخ المئك كحامل التوء والجليس",
                      "y2":  1609
                  },
                  {
                      "y":  1668,
                      "x":  207,
                      "text":  "أن وإما ثيابك، يخرق أن إما الكير: ونافخ طيبة، ربحا منه تجد أن وإما منه، تبتاع أن",
                      "y2":  1689
                  },
                  {
                      "y":  1754,
                      "x":  450,
                      "text":  "(٢٦٢٨). ومسلم (٢١٠١)، البخاري أخرجه خسثة». ريحا تجد",
                      "y2":  1763
                  },
                  {
                      "y":  1826,
                      "x":  904,
                      "text":  "يعطيك. (يحذيك): ومعنن",
                      "y2":  1839
                  }
              ],
    "image":  "page-232.png"
}