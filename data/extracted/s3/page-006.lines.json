{
    "lines":  [
                  {
                      "y":  164,
                      "x":  576,
                      "text":  "المقدمة",
                      "y2":  164
                  },
                  {
                      "y":  380,
                      "x":  421,
                      "text":  "شرور من بالله ونعوذ ونستغفره، ونستعينه نحمده، لله الحمد إن",
                      "y2":  398
                  },
                  {
                      "y":  381,
                      "x":  177,
                      "text":  "سيثات ومن أنفيتا",
                      "y2":  393
                  },
                  {
                      "y":  462,
                      "x":  170,
                      "text":  "الله إلا زلة ألا وأشهد له، هادي فلا يضلل ومن له، مضل فلا الله يهده من أعمالنا،",
                      "y2":  477
                  },
                  {
                      "y":  547,
                      "x":  493,
                      "text":  "يلنه. ورسوله عبده محمدا أن وأشهد له، شريك لا وحده",
                      "y2":  562
                  },
                  {
                      "y":  633,
                      "x":  1130,
                      "text":  "بعد: أما",
                      "y2":  635
                  },
                  {
                      "y":  710,
                      "x":  177,
                      "text":  "الأمور وشر ظ5، محمي هدي الهذي وخير الله، كتاب الحديث أصدق فإن",
                      "y2":  726
                  },
                  {
                      "y":  796,
                      "x":  274,
                      "text":  "النار. في ضلالة وكل ضلالة، بدعة وكل بدعة، محدثة وكل محدثاتها،",
                      "y2":  814
                  },
                  {
                      "y":  882,
                      "x":  1130,
                      "text":  "بعد: أما",
                      "y2":  884
                  },
                  {
                      "y":  962,
                      "x":  180,
                      "text":  "الله من هبة لاد فالأو لاد؛ الأو هبة عبده: عججل الله وهبها التي الهبات أعظم من فإن",
                      "y2":  977
                  },
                  {
                      "y":  1045,
                      "x":  270,
                      "text":  "الذني الحيوة زينة وألـئون المال تعالن: قال الدنيا، الحياة زينة وهم جؤوعلا،",
                      "y2":  1066
                  },
                  {
                      "y":  1144,
                      "x":  1073,
                      "text":  "٤٦). الكهف:",
                      "y2":  1144
                  },
                  {
                      "y":  1217,
                      "x":  470,
                      "text":  "الفانية. الدنيا هذه زينة الكثيرون والبنون الوفير الكثير المال",
                      "y2":  1226
                  },
                  {
                      "y":  1294,
                      "x":  175,
                      "text":  "في ومبادئه أصوله وغرس تباردوتعالل، الله دين تعليمهم لاد: الأو حقوق أغظم ومن",
                      "y2":  1313
                  },
                  {
                      "y":  1376,
                      "x":  170,
                      "text":  "فيبدا التمييز، سن يبلعون عندما لاد الأو تعليم فـ«يبدا أظفارهم، نعومة منذ نفوسهم",
                      "y2":  1395
                  },
                  {
                      "y":  1466,
                      "x":  965,
                      "text":  "الدينية. التربية تعليمهم",
                      "y2":  1468
                  },
                  {
                      "y":  1547,
                      "x":  178,
                      "text":  "على يربيه وأن يعلمه، بأن والده يؤمر -جينئذ- فإنه التمييز؛ سن الطفل بلغ فإذا",
                      "y2":  1559
                  },
                  {
                      "y":  1629,
                      "x":  172,
                      "text":  "التي الشرعية الأحكام ويعلمه الأحاديث، من تيسر وما القرآن، يعلمه بأن الخير؛",
                      "y2":  1657
                  },
                  {
                      "y":  1709,
                      "x":  171,
                      "text":  "الني الأذكار ويعلمه يصلي، وكيف يتوشا، كيف بعلمة بأن الطفل؛ هذا سن تناسب",
                      "y2":  1723
                  },
                  {
                      "y":  1794,
                      "x":  174,
                      "text":  "فإنه... الثمبيز سن بلغ إذا لأنه والشرب؛ الأكل وعند الاستيقاظ، وبعد التوم، عند ثقال",
                      "y2":  1807
                  }
              ],
    "image":  "page-006.png"
}