                      "y2":  495
                  },
                  {
                      "y":  565,
                      "x":  181,
                      "text":  "العلوم في والشنة التوحيد «منهاج سلسلة: إخراج في الاجتهاد كان البابة هذه ومن",
                      "y2":  582
                  },
                  {
                      "y":  643,
                      "x":  177,
                      "text":  "الله كلفهم التي الأمانة أداء على والأمهات والآباء المعلمين لإعانة للأطفال»؛ الشرعية",
                      "y2":  659
                  },
                  {
                      "y":  731,
                      "x":  301,
                      "text":  "وتدريجق. منتظم بشكل النافعة الشرعية العلوم لاد الأو بتعليم بها؛ تبارلدوتعالن",
                      "y2":  743
                  },
                  {
                      "y":  812,
                      "x":  177,
                      "text":  "السلسلة هذه أن ومعلوم السلسلة، مراجل من الأساسية النالنة المرحلة هي وهذه",
                      "y2":  838
                  },
                  {
                      "y":  900,
                      "x":  175,
                      "text":  "المرحلة وهذه أساسية، مستويات وست للأطفال، تمهيدية مستويات ثلاث من مكونة",
                      "y2":  909
                  },
                  {
                      "y":  984,
                      "x":  178,
                      "text":  "من المسلمين باد وجميع الله -حفظها التوحيد لبلاد الدراسية المناهج من مجموعة",
                      "y2":  995
                  },
                  {
                      "y":  1064,
                      "x":  175,
                      "text":  "أخونا أعده الذي والآداب الأذكار منهج وهو منها، الأخير الجزء غير وشر- سوء كل",
                      "y2":  1077
                  },
                  {
                      "y":  1149,
                      "x":  180,
                      "text":  "منهج هو -كما المرحلة وهذه الله، -حفظه جابر سيد بن محمود الفضل أبو الفاضل",
                      "y2":  1161
                  },
                  {
                      "y":  1232,
                      "x":  211,
                      "text":  "الجديدة. والمعلومات والدروس التفصيل من بمزيد سابقتها عن امتازث السليلة-",
                      "y2":  1249
                  },
                  {
                      "y":  1315,
                      "x":  182,
                      "text":  "أبناء في يبارك وأن والسماء، الأرض في القبول المناهج لهذه يجعل أن الله أسأل",
                      "y2":  1332
