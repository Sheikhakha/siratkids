                      "text":  "\u0026 الشرك عن النهم",
                      "y2":  225
                  },
                  {
                      "y":  511,
                      "x":  246,
                      "text":  "العبادة أنواع من نوع أي صرف",
                      "y2":  525
                  },
                  {
                      "y":  511,
                      "x":  962,
                      "text":  "هو: الشرك",
                      "y2":  511
                  },
                  {
                      "y":  628,
                      "x":  897,
                      "text":  "تعالئ. الله لغير",
                      "y2":  635
                  },
                  {
                      "y":  737,
                      "x":  244,
                      "text":  "ويطلب الله، غير يلذعو أو الله، لغير يسجد كالذي",
                      "y2":  760
                  },
                  {
                      "y":  856,
                      "x":  246,
                      "text":  "يصرف أو الله، لغير يذبح أو حاجاته، قضاء منه",
                      "y2":  874
                  },
                  {
                      "y":  972,
                      "x":  247,
                      "text":  "هذا كان سواء الله؛ لغير العبادة أنواع من نوع أي",
                      "y2":  989
                  },
                  {
                      "y":  1087,
                      "x":  249,
                      "text":  "ملكا، أو حجرا، أو صنما، أو مينا، أو حيا المدعو",
                      "y2":  1098
                  },
                  {
                      "y":  1202,
                      "x":  244,
                      "text":  "الشرك من هذا كل ذلك، غير أو وليا، أو نبيا، أو",
                      "y2":  1219
                  },
                  {
                      "y":  1314,
                      "x":  494,
                      "text":  "يتوب. أن إلا للعبد الله يغفره لا الذي",
                      "y2":  1332
                  },
                  {
                      "y":  1421,
                      "x":  249,
                      "text":  "ما ويغفر به يشرك أن يغفر لا الله إن تعالن: قال",
                      "y2":  1462
                  },
                  {
                      "y":  1544,
                      "x":  246,
                      "text":  "افترن فقد بالله يشرك ومن يشاء لمن ذلك دون",
                      "y2":  1566
                  },
                  {
