                      "text":  "الأخر باليوم الإيمان",
                      "y2":  229
                  },
                  {
                      "y":  574,
                      "x":  220,
                      "text":  "الخي يبذر فالذي المررعة، مثل فيها نعيش التي الدنيا الحياة هذه",
                      "y2":  602
                  },
                  {
                      "y":  666,
                      "x":  534,
                      "text":  "يحصده. الشز يبذر والذي الطيب، الثمر يجني",
                      "y2":  680
                  },
                  {
                      "y":  751,
                      "x":  221,
                      "text":  "أعدها فالجنة الآخر؛ اليؤم في يكون الأغمال كل على العظيم والجزاء",
                      "y2":  771
                  },
                  {
                      "y":  845,
                      "x":  672,
                      "text":  "للكافرين. أعدت والنار للمتقين، الله",
                      "y2":  855
                  },
                  {
                      "y":  1120,
                      "x":  804,
                      "text":  "الآخر باليوم الإيمان معنى",
                      "y2":  1129
                  },
                  {
                      "y":  1204,
                      "x":  227,
                      "text":  "الناس وبعث ، وعذابه القبر نعيم من الموت بعد يقع ما بكل التصديق",
                      "y2":  1230
                  },
                  {
                      "y":  1285,
                      "x":  581,
                      "text":  ". النار أو الجنة بدحول والجزاء للحساب،",
                      "y2":  1323
                  },
                  {
                      "y":  1464,
                      "x":  609,
                      "text":  "الآخر باليوم الإيمان وجوب على الدليل",
                      "y2":  1483
                  },
                  {
                      "y":  1552,
                      "x":  671,
                      "text":  "يوقون هر ويالاخر تعالى: الله قال",
                      "y2":  1572
                  },
