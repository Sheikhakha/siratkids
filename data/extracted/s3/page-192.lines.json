                      "text":  "الدرس",
                      "y2":  122
                  },
                  {
                      "y":  208,
                      "x":  145,
                      "text":  "٤",
                      "y2":  208
                  },
                  {
                      "y":  167,
                      "x":  529,
                      "text":  "يؤ اللبي أولاد",
                      "y2":  200
                  },
                  {
                      "y":  573,
                      "x":  180,
                      "text":  "ذلك حفظ وبعدما يطو، النبي على الصلاة صيغة وتعلم الثاني، التشهد خالد درس",
                      "y2":  601
                  },
                  {
                      "y":  652,
                      "x":  252,
                      "text":  "يؤؤل محمد أل هم فمن محمد، آل وعلى محمد على نصلي نحن : تساءل",
                      "y2":  681
                  },
                  {
                      "y":  819,
                      "x":  762,
                      "text":  "النبي أولاد على أتعرف",
                      "y2":  835
                  },
                  {
                      "y":  933,
                      "x":  421,
                      "text":  "التالي: الحوار بينهما ودار يخ محمد أل عن معلمه خالد سال",
                      "y2":  965
                  },
                  {
                      "y":  1019,
                      "x":  168,
                      "text":  "على الصلاة وفيه الثاني، التشهد في ي النبي على الصلاة أستاذ يا تعلمت خالد:",
                      "y2":  1041
                  },
                  {
                      "y":  1114,
                      "x":  818,
                      "text":  "ز؟ محمد آل هم فمن محمد، آل",
                      "y2":  1114
                  },
                  {
                      "y":  1182,
                      "x":  169,
                      "text":  "عليه، أشكل عما الطالب يسال أن وجميل جيد، سؤال خالد يا أحسنت المعلم:",
                      "y2":  1196
                  },
                  {
                      "y":  1268,
                      "x":  166,
                      "text":  "وأعمامه أحفاده من والمؤمنون وزوجاته، يي، النبي وبنات أبناء هم: يي محمد آل",
                      "y2":  1293
                  },
                  {
                      "y":  1352,
                      "x":  1179,
                      "text":  "وأبنائهم.",
                      "y2":  1352
                  },
                  {
                      "y":  1420,
                      "x":  781,
                      "text":  "يامعلمي؟ يؤ النبي أولاد وكم خالد:",
                      "y2":  1433
                  },
                  {
                      "y":  1498,
                      "x":  725,
                      "text":  "بنات. وأربع أبناء ثلاثة يؤ للنبي المعلم:",
                      "y2":  1511
                  },
                  {
                      "y":  1567,
                      "x":  369,
                      "text":  "ذلك. لمعرفة شوق في فانا أسماءهم معلمي يا لي ذكرت هلا خالد،",
                      "y2":  1593
                  },
                  {
                      "y":  1654,
                      "x":  167,
                      "text":  "ورقية زينب هن: والبنات سييه، وإبراهيم الله وعبد القاسم هم: الأبناء المعلم:",
                      "y2":  1678
                  },
                  {
                      "y":  1724,
                      "x":  945,
                      "text":  ". يكه وفاطمة كلثوم وأم",
                      "y2":  1775
                  },
                  {
                      "y":  1850,
                      "x":  75,
                      "text":  "١٩١",
                      "y2":  1850
                  }
              ],
