                  {
                      "y":  244,
                      "x":  923,
                      "text":  "بالله الإيمان معنى",
                      "y2":  267
                  },
                  {
                      "y":  331,
                      "x":  381,
                      "text":  "والصفات. والاسماء والالوهية بالربوبية تعالى الله إفراد",
                      "y2":  344
                  },
                  {
                      "y":  435,
                      "x":  839,
                      "text":  "بالربوبية الله إفراد معنى",
                      "y2":  455
                  },
                  {
                      "y":  521,
                      "x":  233,
                      "text":  "المخلوقات. لجميع والمدبر الرازق الخالق هو وحده الله باد والإقرار العلم",
                      "y2":  533
                  },
                  {
                      "y":  636,
                      "x":  839,
                      "text":  "بالألوهية الله إفراد مغنى",
                      "y2":  656
                  },
                  {
                      "y":  721,
                      "x":  450,
                      "text":  ". له شريك لا وحده لله العبادة أنواع جميع صرف",
                      "y2":  761
                  },
                  {
                      "y":  795,
                      "x":  646,
                      "text":  "والاستغائة. والدعاء الصلاة مثل:",
                      "y2":  812
                  },
                  {
                      "y":  931,
                      "x":  705,
                      "text":  "والضفات بالأسماء الله إفراد معنى",
                      "y2":  945
                  },
                  {
                      "y":  1006,
                      "x":  259,
                      "text":  "على النبوية والشنة الكريم القرآن في ورد كما وصفاته الله أسماء إثبات",
                      "y2":  1034
                  },
                  {
                      "y":  1080,
                      "x":  725,
                      "text":  ". سبحانه بجلاله يليق الذي الوجه",
                      "y2":  1116
                  },
                  {
                      "y":  1140,
                      "x":  256,
                      "text":  "والبصب الشبع مثل: الخشني الله أسماء : بها فالمراذ الأسماء أما",
                      "y2":  1171
                  },
                  {
                      "y":  1228,
                      "x":  661,
                      "text":  "وعيرها. والعظيم، والرحمن والعليم",
                      "y2":  1232
                  },
                  {
                      "y":  1297,
                      "x":  256,
                      "text":  "والبصر الشمع مثل: الخشنى الله صفات : بها فانمراد الضفات أما",
                      "y2":  1321
                  },
                  {
                      "y":  1384,
                      "x":  676,
                      "text":  "وغيرها. والعظمة، والرحمة والعلم",
                      "y2":  1388
                  },
                  {
                      "y":  1513,
                      "x":  443,
                      "text":  "تعالى: قوله السابقة، الثلاثة التوحي أنواع على الذليل",
                      "y2":  1531
                  },
                  {
                      "y":  1591,
                      "x":  253,
                      "text":  "وما بزفي فن ينهم أربد ما إي) ليعبدون إلا والإس أليلذن غلفت وما",
                      "y2":  1614
                  },
                  {
                      "y":  1676,
                      "x":  276,
                      "text":  "\". إيوه ألمتين القؤو ذو الرزاق هو أقه إن إه يطعمون أن أربد",
                      "y2":  1683
                  },
