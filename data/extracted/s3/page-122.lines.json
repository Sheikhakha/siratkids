{
    "lines":  [
                  {
                      "y":  125,
                      "x":  82,
                      "text":  "الدرس",
                      "y2":  125
                  },
                  {
                      "y":  148,
                      "x":  451,
                      "text":  "يؤ النبي أسماء معاني",
                      "y2":  173
                  },
                  {
                      "y":  473,
                      "x":  376,
                      "text":  "الله رسول تحمد",
                      "y2":  479
                  },
                  {
                      "y":  491,
                      "x":  833,
                      "text":  "تعالى: الله قال",
                      "y2":  498
                  },
                  {
                      "y":  962,
                      "x":  183,
                      "text":  "وما محمد؟ معني فما بالأمين، ويلقب وأحمد محمدا يسمي: يطؤ النبي كان",
                      "y2":  990
                  },
                  {
                      "y":  1057,
                      "x":  861,
                      "text":  "الأمين؟ معنى وما أحمد؟",
                      "y2":  1071
                  },
                  {
                      "y":  1144,
                      "x":  1016,
                      "text":  "محمد معنى",
                      "y2":  1149
                  },
                  {
                      "y":  1221,
                      "x":  167,
                      "text":  "الأمور يعمل الذي فهو بها، ويمدح وصفاته أعماله على يحمد الذي هو محمد:",
                      "y2":  1246
                  },
                  {
                      "y":  1303,
                      "x":  604,
                      "text":  "القبيحة. السيئة الأمور عن ويبتعد الطيبة، الحسنة",
                      "y2":  1311
                  },
                  {
                      "y":  1379,
                      "x":  1023,
                      "text":  "أحمد معنى",
                      "y2":  1390
                  },
                  {
                      "y":  1472,
                      "x":  904,
                      "text":  "لربه. الحمد كثير هو أحمد:",
                      "y2":  1494
                  },
                  {
                      "y":  1545,
                      "x":  1022,
                      "text":  "الأمين معنى",
                      "y2":  1545
                  },
                  {
                      "y":  1635,
                      "x":  169,
                      "text":  "مف الني الحسنة الصفات من الامانة وحفظ يخونها، ولا الأمانة يحفظ من هو الأمين:",
                      "y2":  1672
                  },
                  {
                      "y":  1724,
                      "x":  169,
                      "text":  "عنده تضع قريش وكانت بالأمين، يلقبونه أصبحوا حتى قومه عند محمد النبي بها",
                      "y2":  1750
                  },
                  {
                      "y":  1810,
                      "x":  1077,
                      "text":  "وأماناتها. ودائعها",
                      "y2":  1817
                  },
                  {
                      "y":  1859,
                      "x":  70,
                      "text":  "١٢٣",
                      "y2":  1859
                  }
              ],
    "image":  "page-122.png"
}