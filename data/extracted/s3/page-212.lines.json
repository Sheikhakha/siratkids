{
    "lines":  [
                  {
                      "y":  511,
                      "x":  235,
                      "text":  "فيستحب صديق؛ أو قريب المسلمين من لأحد مات إذا",
                      "y2":  523
                  },
                  {
                      "y":  615,
                      "x":  240,
                      "text":  "يصبره، ما له وتذكر تعزيه، أن الكريم المسلم ايها لك",
                      "y2":  633
                  },
                  {
                      "y":  728,
                      "x":  490,
                      "text":  "له: تقول أن مثل مصيبنه؛ عليه ونهون",
                      "y2":  740
                  },
                  {
                      "y":  927,
                      "x":  658,
                      "text":  "وكل أعطى، ما وله أخذ، ما الله",
                      "y2":  953
                  },
                  {
                      "y":  1042,
                      "x":  655,
                      "text":  "فلتصبر مسمن؛ بأجل عنده شيء",
                      "y2":  1051
                  },
                  {
                      "y":  1149,
                      "x":  804,
                      "text":  ". ولتحتسبا",
                      "y2":  1189
                  },
                  {
                      "y":  1480,
                      "x":  226,
                      "text":  "إحدى إليه فأرسلت طية، النبي عند كنا قال: زيجها زيد بن أسامة عن (١)",
                      "y2":  1497
                  },
                  {
                      "y":  1564,
                      "x":  223,
                      "text":  "أي: - للوسول فقال المؤت، في لها ابنا أو لها صبيا أن وتخبره تدعوه، بناته",
                      "y2":  1593
                  },
                  {
                      "y":  1641,
                      "x":  223,
                      "text":  "أخذ، ما لله أن فأخبرها إليها، «ارجع : النبي ابنة أرسلئه الذي للرجل",
                      "y2":  1667
                  },
                  {
                      "y":  1717,
                      "x":  227,
                      "text":  "ولتحتسب» فلتصبر فمزها متمن؛ بأجل عنده شيء وكل أعطن، ما وله",
                      "y2":  1742
                  },
                  {
                      "y":  1807,
                      "x":  367,
                      "text":  "له. واللفظ (٩٢٣)، ومسلم (١٢٨٤)، البخاري أخرجه الحديث.",
                      "y2":  1820
                  },
                  {
                      "y":  1816,
                      "x":  113,
                      "text":  "١١)",
                      "y2":  1816
                  }
