                      "text":  "١٩",
                      "y2":  224
                  },
                  {
                      "y":  705,
                      "x":  198,
                      "text":  "إ",
                      "y2":  705
                  },
                  {
                      "y":  599,
                      "x":  593,
                      "text":  "لدى الرياضي للنشاط مزاولته أثناء نقوده يودع خالد",
                      "y2":  627
                  },
                  {
                      "y":  688,
                      "x":  975,
                      "text":  ". مانة بالا يتصف لأنه صالح ميله",
                      "y2":  736
                  },
                  {
                      "y":  778,
                      "x":  686,
                      "text":  "بالأمانة. يتصف لانه أدواته أحمد زميله يعير فهد",
                      "y2":  794
                  },
                  {
                      "y":  868,
                      "x":  179,
                      "text":  ". مانة بالا تتصف لانها وأسرارها بمشكلاتها وتخبرها سلمى بزميلتها تثق هاجر",
                      "y2":  916
                  },
                  {
                      "y":  963,
                      "x":  172,
                      "text":  "يوسف لان دكانه من مشترياته قيمة تسديد يوسف يؤجل أن يقبل سليمان",
                      "y2":  994
                  },
                  {
                      "y":  1065,
                      "x":  1268,
                      "text":  ". مانة بالأ معروف",
                      "y2":  1095
                  },
                  {
                      "y":  1137,
                      "x":  172,
                      "text":  "وبعدها، البعثة قبل تج الرسول به واتصف الإسلام أوجبه رفيع خلق الأمانة",
                      "y2":  1163
                  },
                  {
                      "y":  1234,
                      "x":  1055,
                      "text":  ". شه سيرته من نماذج وإليك",
                      "y2":  1271
                  },
                  {
                      "y":  1343,
                      "x":  899,
                      "text":  "محدعسقفشى",
                      "y2":  1343
                  },
                  {
                      "y":  1478,
                      "x":  1076,
                      "text":  ". النبي أمانة من صور",
                      "y2":  1513
                  },
                  {
                      "y":  1572,
                      "x":  1305,
                      "text":  "البعثة: قبل",
                      "y2":  1572
                  },
                  {
                      "y":  1618,
                      "x":  231,
                      "text":  "ا لباد والسيول، الامطار بسب الكعبة بنياد •تساقط",
                      "y2":  1664
                  },
                  {
                      "y":  1736,
                      "x":  172,
                      "text":  "حتى اختلفوا الأسود الحجر وضع أرادوا فلما البناء، إعادة قريش قبيلة وهم مكة أهل",
                      "y2":  1773
                  },
                  {
                      "y":  1835,
                      "x":  175,
                      "text":  "فقالوا: الحجر، وضع شرف ينال أن يريد كل بالسيوف قتال بينهم يكون أن كاد",
                      "y2":  1861
                  },
                  {
                      "y":  1914,
                      "x":  175,
                      "text":  "فقالوا: ، بتمت الله رسول فدخل الباب؛ من يدخل رجل أول بينكم حكما اجعلوا",
                      "y2":  1956
                  },
                  {
                      "y":  2054,
                      "x":  1647,
                      "text":  "١٠٨",
                      "y2":  2054
                  }
