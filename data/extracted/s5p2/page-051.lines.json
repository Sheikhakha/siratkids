                      "y2":  285
                  },
                  {
                      "y":  443,
                      "x":  226,
                      "text":  "أن المنتظمين: وغير الوضوء في المنتظمين فحص بعد الحديث العلم أثبت",
                      "y2":  457
                  },
                  {
                      "y":  532,
                      "x":  226,
                      "text":  "طاهرا نظيفا غالبيتهم عند الأنف ظهر قد باستمرار.. يتوضؤون الذين",
                      "y2":  549
                  },
                  {
                      "y":  623,
                      "x":  316,
                      "text":  "أنواعا تحوي يتوضؤون لا من أنوف أن حين في الميكروبات، من خاليا",
                      "y2":  648
                  },
                  {
                      "y":  711,
                      "x":  226,
                      "text":  "أن ثبت وقد الأمراض، من العديد تسبب التي الميكروبات من متعددة",
                      "y2":  739
                  },
                  {
                      "y":  803,
                      "x":  233,
                      "text":  ". الأنف تجويفي في الضارة نموالميكروبات جراء من يحدث الذاتي التسمم",
                      "y2":  839
                  },
                  {
                      "y":  894,
                      "x":  226,
                      "text":  "الالتهابات، من والبلعوم الفم تحفظ أنها ثبت فقد ، للمضمضة بالنسبة أما",
                      "y2":  921
                  },
                  {
                      "y":  983,
                      "x":  224,
                      "text":  "تبقى قد التي الطعام بقايا بإزالة النخر من الأسنان وتقي اللثة تقيح ومن",
                      "y2":  1008
                  },
                  {
                      "y":  1075,
                      "x":  228,
                      "text":  "مستديرا. وتجعله الوجه في العضلات بعض المضمضة تنمي كما فيها،",
                      "y2":  1091
                  },
                  {
                      "y":  1164,
                      "x":  221,
                      "text":  "الغبار إزالة في فائدة والقدمين المرفقين إلى واليدين الوجه لغسل أن كما",
                      "y2":  1169
                  },
                  {
                      "y":  1258,
                      "x":  224,
                      "text":  "الدهنية المواد من البشرة تنظيف عن فضلا الجراثيم من عليه يحتوي وما",
                      "y2":  1278
                  },
                  {
                      "y":  1336,
                      "x":  226,
                      "text":  "أن علميا ثبت وقد العرق، إزالة إلى بالإضافة الجلدية الغدد تفرزها التي",
                      "y2":  1352
                  },
                  {
                      "y":  1433,
                      "x":  485,
                      "text":  "نظافته. أهمل إذا إلا الإنسان جلد تهاجم لا الميكروبات",
                      "y2":  1441
                  },
