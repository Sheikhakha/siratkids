                      "text":  "الحلم: معنى",
                      "y2":  223
                  },
                  {
                      "y":  297,
                      "x":  966,
                      "text":  "وتر، الأمور في والتثبت التعقل الحلم:",
                      "y2":  318
                  },
                  {
                      "y":  394,
                      "x":  214,
                      "text":  "نفوسهم وتعويد لاكتسابها العقلاء يسعى التي الرفيعة الحسنة خلاق الا من وهو",
                      "y2":  422
                  },
                  {
                      "y":  490,
                      "x":  214,
                      "text":  "حولك من مع تعاملك و واقعك في الحلم صفة فطبق أحد عليك أخطا فإذا عليها،",
                      "y2":  510
                  },
                  {
                      "y":  560,
                      "x":  679,
                      "text":  "حلما. وأكثرهم أخلاقا الناس أكمل ي النبى كان وقد",
                      "y2":  584
                  },
                  {
                      "y":  734,
                      "x":  426,
                      "text":  "؟ لدعوته الناس استجابة في النبيي حلم أثر ما",
                      "y2":  749
                  },
                  {
                      "y":  1041,
                      "x":  1347,
                      "text":  "ررفه",
                      "y2":  1041
                  },
                  {
                      "y":  1241,
                      "x":  1055,
                      "text":  ". حلما الناس أكثر انه النبي O",
                      "y2":  1283
                  },
                  {
                      "y":  1318,
                      "x":  866,
                      "text":  "الأمور. في والتنبت التعقل الحلم معنى",
                      "y2":  1356
                  },
                  {
                      "y":  1561,
                      "x":  279,
                      "text":  "يلي: ما وعلاجه المشينة الصفات من وهو الغضب، الحلم ضد",
                      "y2":  1579
                  },
                  {
                      "y":  1640,
                      "x":  490,
                      "text":  "الغضب. عند الرجيم الشيطان من بالله الاستعاذة",
                      "y2":  1661
                  },
                  {
                      "y":  1717,
                      "x":  276,
                      "text":  "فليضطجع. جالسا كان وإذا فليجلس قائما كان فإذا الهيئة تغيير",
                      "y2":  1721
                  },
                  {
                      "y":  1787,
                      "x":  577,
                      "text":  "الغضب. يذهب حتى الكلام وعدم الصمت",
