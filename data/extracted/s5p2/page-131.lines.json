                      "text":  "والإسراف: الكرم بين الفرق",
                      "y2":  238
                  },
                  {
                      "y":  300,
                      "x":  174,
                      "text":  "الضيف، وإكرام كالصدقات، المشروعة، الأمور من مواضعه في مالة يضع الكريم",
                      "y2":  329
                  },
                  {
                      "y":  384,
                      "x":  941,
                      "text":  "نفسه بذلك طيبة الجار إلى والإحسان",
                      "y2":  395
                  },
                  {
                      "y":  389,
                      "x":  168,
                      "text":  "مبذر فهو المسرف وأما ربه، مرضاة يبتغي",
                      "y2":  404
                  },
                  {
                      "y":  468,
                      "x":  500,
                      "text":  "المصارف. ولا المصالح يقدر ولا وهواه، شهواته في ماله يهدر",
                      "y2":  486
                  },
                  {
                      "y":  639,
                      "x":  289,
                      "text":  "وأصدقائي وأخواتي إخواني مع الكرم صفة أحقق كيف",
                      "y2":  659
                  },
                  {
                      "y":  737,
                      "x":  1147,
                      "text":  "وجيراني؟",
                      "y2":  737
                  },
                  {
                      "y":  1066,
                      "x":  1209,
                      "text":  "ورز",
                      "y2":  1066
                  },
                  {
                      "y":  1279,
                      "x":  698,
                      "text":  "والسخاء. والجود العطاء كثرة الكرم معنى",
                      "y2":  1314
                  },
                  {
