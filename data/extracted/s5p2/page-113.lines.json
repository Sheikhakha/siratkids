    "lines":  [
                  {
                      "y":  187,
                      "x":  910,
                      "text":  "الحديث معاني على أتعرف",
                      "y2":  196
                  },
                  {
                      "y":  303,
                      "x":  485,
                      "text":  "صاحبه. إلى القرض إرجاع يريل وهو اقترض أي أداءها: يريد O",
                      "y2":  331
                  },
                  {
                      "y":  391,
                      "x":  184,
                      "text":  "رزقه. وتوسيع له المال بتيسير وذلك دينه، لسداد ووفقه الله أعانه أي عنه: الله أدى لد",
                      "y2":  423
                  },
                  {
                      "y":  483,
                      "x":  519,
                      "text":  "لصاحبه. المال إعادة يريد لا وهو اقترض أي إتلافها: يريد د",
                      "y2":  511
                  },
                  {
                      "y":  571,
                      "x":  178,
                      "text":  "الاخرة. لعذاب وعرضه المصائب بكثرة الدنيا في ماله الله أتلف أي الله: أتلفه O",
                      "y2":  590
                  },
                  {
                      "y":  695,
                      "x":  986,
                      "text":  "الحديث من يستفاد مما",
                      "y2":  711
                  },
                  {
                      "y":  828,
                      "x":  555,
                      "text":  "المحدد. الوقت في أصحابها إلى الديون رد الأمانة",
                      "y2":  838
                  },
                  {
                      "y":  922,
                      "x":  342,
                      "text":  ". الناس أموال أخذ في الصالحة والنية الأمانة الرزق سعة أسباب من",
                      "y2":  956
                  },
                  {
                      "y":  994,
                      "x":  323,
                      "text":  ". الناس أموال أخذ في الفاسدة والنية الخيانة المال هلاك أسباب من",
                      "y2":  1045
                  },
                  {
                      "y":  1288,
                      "x":  782,
                      "text":  "؟ الرزق بركة في الأمانة أثر ما",
                      "y2":  1302
                  },
                  {
                      "y":  1556,
                      "x":  1303,
                      "text":  "رالياه",
                      "y2":  1556
                  },
                  {
                      "y":  1751,
                      "x":  833,
                      "text":  "ووفرته. الرزق بركة الأمانة ثمرات من",
                      "y2":  1777
                  },
                  {
                      "y":  1834,
                      "x":  207,
                      "text":  "لهم. إعادتها على يعينه الله فإن الناس، أموال أخذ في بالأمانة اتصف من",
                      "y2":  1866
                  },
                  {
                      "y":  2054,
