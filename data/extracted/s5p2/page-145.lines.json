{
    "lines":  [
                  {
                      "y":  207,
                      "x":  171,
                      "text":  "الإيمان في لاشتراكهما خير، والضعيف القوي المؤمن من كل في : خير كل وفي",
                      "y2":  240
                  },
                  {
                      "y":  293,
                      "x":  308,
                      "text":  ". الله من قربا أكثر إيمانه في القوي المؤمن كان وإن الصالحات، وعمل",
                      "y2":  336
                  },
                  {
                      "y":  368,
                      "x":  171,
                      "text":  "وصادقا قويا والاخرة الددنيا أمور في عزمك ليكن أي : ينفعك ما على احرص ر",
                      "y2":  403
                  },
                  {
                      "y":  467,
                      "x":  803,
                      "text":  "وتكسل. تتخاذل ولا ينفعك، ما طلب في",
                      "y2":  477
                  },
                  {
                      "y":  545,
                      "x":  669,
                      "text":  "الله. من والمساعدة العون اطلب : بالله واستعن",
                      "y2":  577
                  },
                  {
                      "y":  634,
                      "x":  414,
                      "text":  "الكسل. أو الخوف أو الضعف بسبب العمل تترك لا : تعجز ولا",
                      "y2":  662
                  },
                  {
                      "y":  708,
                      "x":  170,
                      "text":  "فلا مكروه، أصابك وإن وكذا: كذا كان فعلت أني لو تقل فلا شيء أصابك وإن O",
                      "y2":  727
                  },
                  {
                      "y":  791,
                      "x":  181,
                      "text":  "عليه. هو ما بخلاف الواقع لكان فعلت ما تركت أو الفعل على أقدمت أني لو تقل:",
                      "y2":  823
                  },
                  {
                      "y":  882,
                      "x":  220,
                      "text":  "والقد بالقضاء الرضا وعدم التسخط في كانت إذا : الشيطان عمل تفتح لو فإن O",
                      "y2":  905
                  },
                  {
                      "y":  1061,
                      "x":  986,
                      "text":  "الحديث من يستفاد مما",
                      "y2":  1074
                  },
                  {
                      "y":  1174,
                      "x":  466,
                      "text":  "العزيمة. وقوة الصبر واكتساب إيمانه لتقوية يسعى المؤمن",
                      "y2":  1203
                  },
                  {
                      "y":  1255,
                      "x":  498,
                      "text":  ". الله من قربا وأكثر عبادة أحسن إيمانه في القوي المؤمن",
                      "y2":  1303
                  },
                  {
                      "y":  1343,
                      "x":  397,
                      "text":  ": يقول أن يكره ما أصابه أو مراده على يحصل لم لمن",
                      "y2":  1373
                  },
                  {
                      "y":  1376,
                      "x":  1353,
                      "text":  "يسستعص",
                      "y2":  1376
                  },
                  {
                      "y":  1528,
                      "x":  168,
                      "text":  "لو لان ،",
                      "y2":  1544
                  },
                  {
                      "y":  1529,
                      "x":  542,
                      "text":  "لكان فعلت أني لو المصيبة عند المؤمن يقول أن يكره",
                      "y2":  1544
                  },
                  {
                      "y":  1625,
                      "x":  1318,
                      "text":  "عمل تفتح",
                      "y2":  1633
                  },
                  {
                      "y":  1845,
                      "x":  805,
                      "text":  "القوي. المؤمن صفات أستنبط",
                      "y2":  1870
                  },
                  {
