                  {
                      "y":  161,
                      "x":  1032,
                      "text":  "الحديث من يستفاد مما",
                      "y2":  174
                  },
                  {
                      "y":  289,
                      "x":  444,
                      "text":  "الكثير. الأجر اليسير العمل على رتب حيث وجل عز الله فضل عظم",
                      "y2":  317
                  },
                  {
                      "y":  416,
                      "x":  194,
                      "text":  "ورسوله. الله عبد محمدا وأن الله إلا إله لا أن أشهد الوضوء: بعد المسلم يقول أن استحباب",
                      "y2":  438
                  },
                  {
                      "y":  532,
                      "x":  1203,
                      "text":  "أبواب. ثمانية لها الجنة",
                      "y2":  550
                  },
                  {
                      "y":  650,
                      "x":  871,
                      "text":  "الجنة. لدخول سبب وأنه الوضوء إسباغ فضل",
                      "y2":  684
                  },
                  {
                      "y":  779,
                      "x":  790,
                      "text":  "الخطاب بن عمر على أتعرف",
                      "y2":  791
                  },
                  {
                      "y":  917,
                      "x":  467,
                      "text":  "بالفاروق، يلقب وكان القرشي، الخطابت بن عمر حفص أبو نسبه:",
                      "y2":  935
                  },
                  {
                      "y":  1012,
                      "x":  161,
                      "text":  "وهو بالشهادة، النبي بشره المسلمين، خلفاء ثاني الجليل والصحابي المؤمنين أمير فضائله: من",
                      "y2":  1033
                  },
                  {
                      "y":  1099,
                      "x":  431,
                      "text":  "ويستشيره. يقربه جو النبي وكان بالجنة، المبشرين العشرة أحد",
                      "y2":  1112
                  },
                  {
                      "y":  1186,
                      "x":  387,
                      "text":  "الزهذ. العلم، التواضع، العدل، والشجاعة، القوة بالحق، الصدع صفاته: من",
                      "y2":  1200
                  },
                  {
                      "y":  1279,
                      "x":  168,
                      "text":  ". بكر وابي ة النبي بجوار كتيفا عائشة حجرة في ودفن للهجرة ٢٣ سنة استشهد وفاته:",
                      "y2":  1314
                  },
                  {
                      "y":  1445,
                      "x":  337,
                      "text":  "لانهاواكاالنيلاتويسخلائق ؤندرونو ونوا لنرتف إذا",
                      "y2":  1452
                  },
                  {
                      "y":  1537,
                      "x":  613,
                      "text":  "واجرعطنيم مفو مه",
                      "y2":  1537
                  },
                  {
                      "y":  1833,
                      "x":  1323,
                      "text":  "ياو",
                      "y2":  1833
                  },
