{
    "lines":  [
                  {
                      "y":  187,
                      "x":  911,
                      "text":  "الحديث معاني على أتعرف",
                      "y2":  196
                  },
                  {
                      "y":  306,
                      "x":  1393,
                      "text":  ". كالحياء:",
                      "y2":  352
                  },
                  {
                      "y":  383,
                      "x":  174,
                      "text":  "الحياء، أجل من تركه أو أمرا فعل إذا بالحياء المتصف أن أي : بخير إلا يأتى لا د",
                      "y2":  415
                  },
                  {
                      "y":  461,
                      "x":  958,
                      "text":  "والاخرة. الدنيا في له خير ذلك فإن",
                      "y2":  476
                  },
                  {
                      "y":  580,
                      "x":  986,
                      "text":  "الحديث من يستفاد مما",
                      "y2":  593
                  },
                  {
                      "y":  692,
                      "x":  971,
                      "text":  "الإيمان شعب من شعبة الحياء",
                      "y2":  731
                  },
                  {
                      "y":  695,
                      "x":  292,
                      "text":  ". الطاعة في ويزيد المعاصي من يمنع",
                      "y2":  740
                  },
                  {
                      "y":  771,
                      "x":  494,
                      "text":  "، الحسن القول مثل: الحسنة، الأمور فعل على يبعث الحياء",
                      "y2":  806
                  },
                  {
                      "y":  857,
                      "x":  498,
                      "text":  "، السيئة بالألفاظ التلفظ : مثل القبيحة، الأمور من يمنع الحياء",
                      "y2":  884
                  },
                  {
                      "y":  932,
                      "x":  169,
                      "text":  "مجمع أمام الحديث من الخوف أو نعلمه، لا عما السؤال ترك الحياء من ليس",
                      "y2":  964
                  },
                  {
                      "y":  1010,
                      "x":  544,
                      "text":  "حر كله الحياء لأن مذموم خجل هذا وإنما الناس، من",
                      "y2":  1042
                  },
                  {
                      "y":  1079,
                      "x":  483,
                      "text":  "و. المؤمنين محبة الدنيا ففي والاخرة، الدنيا في حسنة الحياه ثمرة",
                      "y2":  1120
                  },
                  {
                      "y":  1161,
                      "x":  725,
                      "text":  ". الدرجات ورفعة الحسنات كثرة الاخرة وفي",
                      "y2":  1209
                  },
                  {
                      "y":  1267,
                      "x":  743,
                      "text":  "ميتي حصين بن عمران على أتعرف",
                      "y2":  1294
                  },
                  {
                      "y":  1402,
                      "x":  847,
                      "text":  "ييا. الخزاعي حصين بن عمران نسبه:",
                      "y2":  1440
                  },
                  {
                      "y":  1485,
                      "x":  172,
                      "text":  "البصرة أهل إلى عمر بعثه الفتح، يوم خزاعة راية يحمل كان فضائله: من",
                      "y2":  1514
                  },
                  {
                      "y":  1558,
                      "x":  169,
                      "text":  "من لهم خير البصرة عليهم قدم ما يحلف البصري الحسن فكان ليفقههم،",
                      "y2":  1593
                  },
                  {
                      "y":  1652,
                      "x":  1110,
                      "text":  ". يائيا الحصين بن عمران",
                      "y2":  1685
                  },
                  {
                      "y":  1730,
                      "x":  991,
                      "text":  "الدعوة. مجاب كان صفاته: من",
                      "y2":  1745
                  },
                  {
                      "y":  1867,
                      "x":  674,
                      "text":  "الخلق؟ وحسن الحياء بين العلاقة ما",
                      "y2":  1876
                  },
                  {
                      "y":  1934,
                      "x":  1410,
                      "text":  "د",
                      "y2":  1934
                  },
                  {
                      "y":  2053,
                      "x":  1648,
                      "text":  "١٦٤",
                      "y2":  2053
                  }
              ],
