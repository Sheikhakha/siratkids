                      "text":  "١٧",
                      "y2":  228
                  },
                  {
                      "y":  469,
                      "x":  204,
                      "text":  "يكونوا لم فلو الدين، الله عن يبلغون الذين فهم الصدق، الأنبياء صفات أهم من إن",
                      "y2":  502
                  },
                  {
                      "y":  561,
                      "x":  201,
                      "text":  "من كان لذا ؟ الناس سيصدقهم وكيف ؟ دينه على الله ياتمنه فكيف صادقين",
                      "y2":  590
                  },
                  {
                      "y":  652,
                      "x":  525,
                      "text":  "ب يسمى كان حتى الصدق الإسلام قبل كخه النبي صفات أبرز",
                      "y2":  682
                  },
                  {
                      "y":  747,
                      "x":  834,
                      "text":  ": يلي ما صدقه على الدالة المواقف ومن",
                      "y2":  769
                  },
                  {
                      "y":  840,
                      "x":  1099,
                      "text":  "ي صدقه من صور",
                      "y2":  850
                  },
                  {
                      "y":  947,
                      "x":  171,
                      "text":  "راى لنا تك للنبي سكا خديجة قالت الإسلام، قبل ي النبي صفات من •الصدق",
                      "y2":  983
                  },
                  {
                      "y":  1023,
                      "x":  172,
                      "text":  "إنك فوالله أبدا، الله يخزيك لا فوالله أبشر، : الوحي عليه نزل عندما مت جبريل",
                      "y2":  1059
                  },
                  {
                      "y":  1120,
                      "x":  282,
                      "text":  "الحق نوائب على وتعين الضيف، وتقري الحديث، وتصدق الرحم، لتصل",
                      "y2":  1133
                  },
                  {
                      "y":  1192,
                      "x":  171,
                      "text":  "وإنر نزلت: لما قال: يتي عباس ابن فعن بالصدق، أعداؤه له شهد وقد",
                      "y2":  1214
                  },
                  {
                      "y":  1275,
                      "x":  1338,
                      "text":  "م٩",
                      "y2":  1275
                  },
                  {
                      "y":  1277,
                      "x":  174,
                      "text":  "فهر، بني يا ينادي فجعل الصفا على طيه النبي صعد الاقريب\" عشيرتك",
                      "y2":  1306
                  },
                  {
                      "y":  1370,
                      "x":  170,
                      "text":  "يخرج أن يستطع لم إذا الرجل فجعل اجتمعوا، حتى قريش لبطون عدي، بني يا",
                      "y2":  1387
                  },
                  {
                      "y":  1429,
                      "x":  172,
                      "text":  "أن أخبرتكم لو أرأيتكم : فقال وقريش، لهب أبو فجاء هو، ما لينظر رسولا أرسل",
                      "y2":  1464
                  },
                  {
                      "y":  1512,
                      "x":  171,
                      "text":  "إلا عليك جربنا ما نعم قالوا: مصدقي أكنتم عليكم تغير أن تريد بالوادي خيلا",
                      "y2":  1540
                  },
                  {
                      "y":  1595,
                      "x":  660,
                      "text":  "شديد، عذاب يدي بين لكم نذير فإني : قال صدقا،",
                      "y2":  1633
                  },
                  {
                      "y":  1678,
                      "x":  658,
                      "text":  "جمعتنا الهذا اليوم سائر لك تبا لهب: أبو فقال",
                      "y2":  1697
                  },
                  {
