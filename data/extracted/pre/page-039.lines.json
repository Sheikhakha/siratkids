                      "text":  "ينبغي تما الشريف، العلم هذا تعله على يخرص أن ملم ل فعلى",
                      "y2":  361
                  },
                  {
                      "y":  406,
                      "x":  285,
                      "text":  "هو الذي العلم هذا ويناتهم أولادهم تغليم على يحرضوا أن الأمور لولاة",
                      "y2":  419
                  },
                  {
                      "y":  475,
                      "x":  285,
                      "text":  "فإن الرفيع؛ بالمقام القدر من هو والذي العالية، بالمنزلة الأهمية من",
                      "y2":  491
                  },
                  {
                      "y":  533,
                      "x":  285,
                      "text":  "المؤدية الوسائل أغظ من نهى نبيهم- سيرة تعلم على الأطفال تربية",
                      "y2":  554
                  },
                  {
                      "y":  602,
                      "x":  285,
                      "text":  "أسباب أعظم من أنها كما لغيرهم، وإصلاحهم أنفسهم ف صلاحهم إلى",
                      "y2":  613
                  },
                  {
                      "y":  659,
                      "x":  285,
                      "text":  "عن والابتعاد بها، والتمك الأمور، بمعالى الاهتمام على حرصهم",
                      "y2":  681
                  },
                  {
                      "y":  729,
                      "x":  893,
                      "text":  "واجتنابها. سفسافها،",
                      "y2":  738
                  },
                  {
                      "y":  806,
                      "x":  285,
                      "text":  "سن من للأطفال التمهيدية المستويات من الأول) (المستوى هو وهذا",
                      "y2":  827
                  },
                  {
                      "y":  867,
                      "x":  285,
                      "text":  "لأطفائتا أقدمها الشريف، العلم هذا فى سنوات أربع إلى سنوات ثلاث",
                      "y2":  880
                  },
                  {
                      "y":  933,
                      "x":  285,
                      "text":  "تكون وأن أجمعين، الملمين يها ينفع أن الله وأسأل وبنات، بنين",
                      "y2":  950
                  },
                  {
                      "y":  996,
                      "x":  285,
                      "text":  "يجعلها وأن أجمع، العالم أقطار كل فق المسلمين لأطفال اشا ونبر منهاجا",
                      "y2":  1009
                  },
                  {
                      "y":  1063,
                      "x":  285,
                      "text":  "من لكل يكتب وأن شينا، فيها لأحد يجعل وألا الكريم، لوجهه خائصة",
                      "y2":  1072
                  },
                  {
                      "y":  1120,
                      "x":  285,
                      "text":  "ذلك على ينيبة وأن العظيم، الأجر وتغليما وتعلما ودعوة نشرا عنيها قام",
                      "y2":  1136
                  },
                  {
                      "y":  1186,
                      "x":  971,
                      "text":  "الجزيل. الثواب",
                      "y2":  1192
                  },
                  {
                      "y":  1267,
                      "x":  285,
                      "text":  "والصخب الآل وعلى والآخرين، الأولين سيد على ويارلا وسل اللة وصلى",
                      "y2":  1281
                  },
                  {
                      "y":  1330,
                      "x":  1049,
                      "text":  "ل",
                      "y2":  1330
                  },
                  {
