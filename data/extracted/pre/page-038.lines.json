                      "text":  "الفقدقة",
                      "y2":  325
                  },
                  {
                      "y":  648,
                      "x":  285,
                      "text":  "شرور من بالله وبغود ونستغفره، ونستعينه نخمده، له الحمد إن",
                      "y2":  663
                  },
                  {
                      "y":  708,
                      "x":  285,
                      "text":  "فلا يضئن ومن له، مضل فلا الله يهده من أعمالنا، سينات ومن أنفسنا",
                      "y2":  721
                  },
                  {
                      "y":  777,
                      "x":  1049,
                      "text":  "له. هادي",
                      "y2":  783
                  },
                  {
                      "y":  847,
                      "x":  285,
                      "text":  "عبده محمدا أن وأشهد له، شريك لا وحده الله إلا إله ألا وأشهد",
                      "y2":  856
                  },
                  {
                      "y":  907,
                      "x":  1006,
                      "text":  "يو. ورسوله",
                      "y2":  922
                  },
                  {
                      "y":  991,
                      "x":  1003,
                      "text":  "يعد» أما",
                      "y2":  991
                  },
                  {
                      "y":  1054,
                      "x":  285,
                      "text":  "على الحرض مسلم لكل ينبغي التى النافعة الغنوم من ة النبن سيرة فإن",
                      "y2":  1070
                  },
                  {
                      "y":  1114,
                      "x":  285,
                      "text":  "وتمارها؛ انده فو على الحصول أجل من وب الدغ والشعن وتخصينها، تعلمها",
                      "y2":  1133
                  },
                  {
                      "y":  1175,
                      "x":  424,
                      "text":  "فخيم. العين وفرة للطمأنينة ومنبع عظية، للعادة مصدر فنها",
                      "y2":  1191
                  },
                  {
                      "y":  1256,
                      "x":  285,
                      "text":  "كلها النبيئ حياة فإن وعلا؛ جل الله دين من كبير جزء والسيرة",
                      "y2":  1274
                  },
                  {
                      "y":  1319,
                      "x":  285,
                      "text":  "لا وهمة الكثل، تغرف لا وعزيمة وتعب، واجتهاد ونصب، كد عن عبارة",
                      "y2":  1327
                  },
                  {
                      "y":  1379,
                      "x":  285,
                      "text":  "انعه شر وتغئيمهم العالمين، رب الله دين إلى الناس هداية أجل من املل تغرف",
                      "y2":  1393
                  },
                  {
                      "y":  1437,
                      "x":  285,
                      "text":  "العبد تعلم فاذا وأخلاق، وسنوكا وآدابا، وففها ومنهاجا، عقيدة وأخكامه؛",
                      "y2":  1447
                  },
                  {
                      "y":  1500,
                      "x":  1095,
                      "text":  "ال",
                      "y2":  1500
                  },
                  {
                      "y":  1503,
                      "x":  285,
                      "text":  "وفاز ، وتعالى تبارك ريه دين من كبيرا قدرا حار فقد ؛ تبيه سيرة",
                      "y2":  1518
                  },
                  {
                      "y":  1558,
                      "x":  738,
                      "text":  "وعلا. جل شريعته من وفير بحظ",
                      "y2":  1573
                  },
                  {
                      "y":  1636,
                      "x":  285,
                      "text":  "الأعمال صلاح على المعينة الوسائل أغطم من يج الله رسول سيرة وتعلم",
                      "y2":  1650
                  },
                  {
                      "y":  1690,
                      "x":  285,
                      "text":  "العمل كان فإن الأعمال، ميزان هو يفة التبي هذي فإن وصوابه؛ والأفوال،",
                      "y2":  1709
                  },
                  {
                      "y":  1757,
                      "x":  285,
                      "text":  "خطا كان له؛ موافق غير كان وإن صوابا، كان ول؛ الله رسول لهدي موافق",
                      "y2":  1768
                  },
                  {
                      "y":  1817,
                      "x":  285,
                      "text":  "يجنيها التي الغزيرة والثمرات الكثيرة الفوائد من ذلك غير إلى مرذودا،",
                      "y2":  1837
                  },
                  {
                      "y":  1875,
                      "x":  398,
                      "text":  "اله رسون سيرة وتعلم بدراسة نفه عنى من عليها وبتحضل",
                      "y2":  1891
                  }
              ],
