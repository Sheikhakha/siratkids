                      "text":  "يخطه. فلم رعية الله استرعاه عبد من «ما عيه: الله رسول وقال",
                      "y2":  360
                  },
                  {
                      "y":  406,
                      "x":  856,
                      "text":  "، الحتة.\" رائحة يجد له إلا",
                      "y2":  423
                  },
                  {
                      "y":  487,
                      "x":  285,
                      "text":  "تعليمهم وأهمها لهم، نودى أن ينبغي خقوق والديهم على لهم فالأطقل",
                      "y2":  504
                  },
                  {
                      "y":  553,
                      "x":  285,
                      "text":  "التجمن يخيى بن أحمد العلامة الشيخ قال كما العالمين، رب الله دين",
                      "y2":  564
                  },
                  {
                      "y":  613,
                      "x":  285,
                      "text":  "وعلموا حنقات، افتخوا التوحيد، على إلا تقوم لا «فالعبادة : اللة رحمة",
                      "y2":  628
                  },
                  {
                      "y":  677,
                      "x":  718,
                      "text":  ". التوحيد.\" وعلموهم القرآن، النشء",
                      "y2":  682
                  },
                  {
                      "y":  754,
                      "x":  285,
                      "text":  "وأن الضحيح، الدين أطفائهة تغلي ينذنواخهدهدفي أن والأمهات الاياء فعلى",
                      "y2":  769
                  },
                  {
                      "y":  821,
                      "x":  285,
                      "text":  "إنما «أخلص؛ غلماؤنا: قال كما الإخلاص، على الأضر مدار لأن ذلك؛ ف يخلضوا",
                      "y2":  832
                  },
                  {
                      "y":  884,
                      "x":  922,
                      "text":  "لميخلص». من يتعثر",
                      "y2":  884
                  },
                  {
                      "y":  965,
                      "x":  288,
                      "text":  "للأطفل-؛ الشرعية الغلوم ى والشنة التوحيد «منهاج سلستة وهذه",
                      "y2":  976
                  },
                  {
                      "y":  1025,
                      "x":  285,
                      "text":  "ثناسب حش مراحل؛ على مم لكل نقدمها ومنته الله بتوفيق",
                      "y2":  1037
                  },
                  {
                      "y":  1091,
                      "x":  285,
                      "text":  "الللة هذه فى استفدتا وقد أيضا، والمبتدئين المختلفة الأعمار فى الأطفال",
                      "y2":  1103
                  },
                  {
                      "y":  1155,
                      "x":  285,
                      "text":  "الغودية العريية المملكت التوحيد بلاد ف المناركة الدراسية المناهج من",
                      "y2":  1172
                  },
                  {
                      "y":  1215,
                      "x":  285,
                      "text":  "جليلة، بميزات تتمتغ اللمتاهج هذه إن إذ المسئمين؛ بلاد وسائر اللة حرسها",
                      "y2":  1229
                  },
                  {
                      "y":  1276,
                      "x":  285,
                      "text":  "فى الشرخ منها: غيره؛ فى مثلها تجد لا زئم جميلة تعيمية وطرق",
                      "y2":  1291
                  },
                  {
                      "y":  1342,
                      "x":  285,
                      "text":  "الشيقة، العزض وطريقة الدارسين، أعمار يناسب تدرجا الدروس",
                      "y2":  1353
                  },
                  {
                      "y":  1402,
                      "x":  285,
                      "text":  "وتعجز يذكره، المقام يطول مما ذلك وغيز الميسرة، امفيدة والمعنوماث",
                      "y2":  1415
                  },
                  {
                      "y":  1469,
                      "x":  285,
                      "text":  "لا كامنة دروت استفدئا قد المواضع بعض ف إننا حتى وضفه؛ عن الكئماث",
                      "y2":  1477
                  },
                  {
                      "y":  1529,
                      "x":  285,
                      "text":  "كنب من استفدنا وكذئك والفقه، التوحيد هاذتي فى خاصة عنها؛ غنى",
