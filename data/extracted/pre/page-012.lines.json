                      "y2":  325
                  },
                  {
                      "y":  648,
                      "x":  285,
                      "text":  "شرور من بالله ونغود ونستغفره، ونستعينه نخمده، له الحمد إن",
                      "y2":  663
                  },
                  {
                      "y":  720,
                      "x":  285,
                      "text":  "فلا يضئن ومن له، مضل فلا الله يهده من آغمالنا، سينات ومن أنفتا",
                      "y2":  740
                  },
                  {
                      "y":  798,
                      "x":  1049,
                      "text":  "له. هادي",
                      "y2":  798
                  },
                  {
                      "y":  864,
                      "x":  285,
                      "text":  "عبده محمدا أن وأشهد له، شريك لا وحده الله إلا إله ألا وأشهد",
                      "y2":  874
                  },
                  {
                      "y":  936,
                      "x":  1006,
                      "text":  "ييو. ورسوله",
                      "y2":  950
                  },
                  {
                      "y":  1011,
                      "x":  1003,
                      "text":  "يعد: أما",
                      "y2":  1013
                  },
                  {
                      "y":  1077,
                      "x":  285,
                      "text":  "وشر ت، محمد هدي الهدى وخير الله، كتاب الحديث أصدق فإن",
                      "y2":  1092
                  },
                  {
                      "y":  1149,
                      "x":  291,
                      "text":  "النار. ى ضلالة وكل ضلالة، بدعة وكل بدعة، مخدثة وكل مخدئثها، الأمور",
                      "y2":  1159
                  },
                  {
                      "y":  1227,
                      "x":  1000,
                      "text":  "بعد: أها",
                      "y2":  1229
                  },
                  {
                      "y":  1296,
                      "x":  285,
                      "text":  "كل على وتعالى سبحائه ربنا فرضها التي العظيمة الواجبات من فإن",
                      "y2":  1314
                  },
                  {
                      "y":  1359,
                      "x":  285,
                      "text":  "عذاب من لوقايتهم وذلك صحيحة؛ إسلامية تزبية أبنائهم تربية وأم، أب",
                      "y2":  1379
                  },
                  {
                      "y":  1437,
                      "x":  288,
                      "text":  "بتابه تعالى: الله قال إياها، العالين رب الله حملهم التي اللأمانة وأداء النار،",
                      "y2":  1452
                  },
                  {
                      "y":  1509,
                      "x":  744,
                      "text":  "ناره\". وأهلي أبمس ءامموافرا أليبن",
                      "y2":  1509
                  },
                  {
                      "y":  1575,
                      "x":  285,
                      "text":  "واتبعوا الله صدفوا الذين أيها يا ، الايد. هذه تفير عتد يجأن العدي قال",
                      "y2":  1592
                  },
                  {
                      "y":  1644,
                      "x":  285,
                      "text":  "عنه، نهاكم ما وترك يه، اللة كم أمر ما بفعل أنفسكم اخفظوا رسوله؛",
                      "y2":  1667
                  },
                  {
                      "y":  1713,
                      "x":  285,
                      "text":  "الناس وقوذه نار من انفسكم به تحفظون بما أهليكم واحفظوا",
                      "y2":  1736
                  },
                  {
