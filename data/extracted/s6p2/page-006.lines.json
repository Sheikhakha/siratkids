{
    "lines":  [
                  {
                      "y":  383,
                      "x":  519,
                      "text":  "التقمزاليو الله يتمم",
                      "y2":  388
                  },
                  {
                      "y":  585,
                      "x":  549,
                      "text":  "محمد. نبينا عل والسلام والصلاة العالمين، رب لله الحمد",
                      "y2":  601
                  },
                  {
                      "y":  704,
                      "x":  1539,
                      "text":  "بعد: أما",
                      "y2":  707
                  },
                  {
                      "y":  806,
                      "x":  237,
                      "text":  "خليل يه، الله إلى وأحبهم الله، عباد أفضل هو ل محمدا نبيتا فإن",
                      "y2":  828
                  },
                  {
                      "y":  913,
                      "x":  237,
                      "text":  "خلقا، وازكاهم عبادة، الله عباد أكمل ومجتباه، ومصطفاه الله",
                      "y2":  931
                  },
                  {
                      "y":  1022,
                      "x":  237,
                      "text":  "وتحقيقا ، بالله معرفة وأعظمهم معاملة، وأحسنهم نفسا، وأطيبهم",
                      "y2":  1029
                  },
                  {
                      "y":  1131,
                      "x":  238,
                      "text":  "وواسطة عباده، وبين بينه سفيرا ليكون يخ الله اصطفاه لعبوديته،",
                      "y2":  1152
                  },
                  {
                      "y":  1233,
                      "x":  239,
                      "text":  "واحتار: الهدى، إلى والدعوة الخـير عل الدلالة في التاس وبين بيته",
                      "y2":  1261
                  },
                  {
                      "y":  1344,
                      "x":  237,
                      "text":  "من البشر صفات بأكمل وخصه نسبا، البشرية واعرق أفضل من",
                      "y2":  1363
                  },
                  {
                      "y":  1449,
                      "x":  238,
                      "text":  "وطلعته البهية، هيئيه في الصفات بأجمل وخصه والحلق، الخلق حيث",
                      "y2":  1477
                  },
                  {
                      "y":  1557,
                      "x":  239,
                      "text":  "الله -صلوات الرفيعة العالية وصفاته المشرق، ومحياه الجميلة،",
                      "y2":  1573
                  },
                  {
                      "y":  1665,
                      "x":  238,
                      "text":  "وأطيب الأخلاقي، وأجمل الفلال، بأكمل وخصه عليه، وسلامه",
                      "y2":  1677
                  },
                  {
                      "y":  1773,
                      "x":  237,
                      "text":  "قال أجمعين، الله لعباد وقدوة للعالمين، أسوة وجعله الاداب،",
                      "y2":  1793
                  },
                  {
                      "y":  1883,
                      "x":  230,
                      "text":  "اللهه يرجو كان لمن حسنة أسوة اللهه رسول في لكم كان لقد",
                      "y2":  1911
                  },
                  {
                      "y":  1889,
                      "x":  1523,
                      "text":  "! تعالى:",
                      "y2":  1911
                  },
                  {
                      "y":  1996,
                      "x":  839,
                      "text":  "21). (الأحزاب: كثيرا الله وذكر الآخر واليوم",
                      "y2":  2027
                  }
