{
    "lines":  [
                  {
                      "y":  352,
                      "x":  244,
                      "text":  "بالتأكيد الإسلام وجاء الجاهلية في كانت التي الأخلاق مكارم من الجار حق",
                      "y2":  375
                  },
                  {
                      "y":  509,
                      "x":  246,
                      "text":  "فبيننا ، لا قلتم: فإن جوارا، منكم أحسن الجاهلية أهل كان حازم: أبو قال",
                      "y2":  539
                  },
                  {
                      "y":  590,
                      "x":  1016,
                      "text":  ": شاعرهم قول وبينكم",
                      "y2":  600
                  },
                  {
                      "y":  650,
                      "x":  380,
                      "text":  "القدر تنزل قبلي وإلـيه",
                      "y2":  657
                  },
                  {
                      "y":  657,
                      "x":  884,
                      "text":  "واحدة الجار ونار ناري",
                      "y2":  659
                  },
                  {
                      "y":  714,
                      "x":  884,
                      "text":  "أجاوره لي جارا ضر ما",
                      "y2":  726
                  },
                  {
                      "y":  717,
                      "x":  380,
                      "text":  "ستر لبيته يكون ألا",
                      "y2":  724
                  },
                  {
                      "y":  782,
                      "x":  380,
                      "text":  "الخدر جارتي يواري حتى",
                      "y2":  800
                  },
                  {
                      "y":  783,
                      "x":  1010,
                      "text":  "- جا ما إذا أعمى",
                      "y2":  797
                  },
                  {
                      "y":  800,
                      "x":  884,
                      "text":  "مررت ري",
                      "y2":  807
                  },
                  {
                      "y":  868,
                      "x":  246,
                      "text":  "الجوار، بحسن ويتفاخرون الذمار، يحمون الجاهلية في العرب كان لقد",
                      "y2":  898
                  },
                  {
                      "y":  947,
                      "x":  862,
                      "text":  ". الدار ثمن يكون الجار قدر وعلى",
                      "y2":  974
                  },
                  {
                      "y":  999,
                      "x":  299,
                      "text":  "الجار يصلح حتى الدار لاتصلح تجاورهم جيرانا لنفسك اطلب",
                      "y2":  1027
                  },
                  {
                      "y":  1097,
                      "x":  1110,
                      "text":  ": آخر وقال",
                      "y2":  1121
                  },
                  {
                      "y":  1169,
                      "x":  365,
                      "text":  "ينفص هناك جارا يعرفوا ولم منزلي بالرخص بعت أن يلومونني",
                      "y2":  1186
                  },
                  {
                      "y":  1237,
                      "x":  365,
                      "text":  "وترخص الديار تغلو بجيرانها فإنها الملام كفوا لهم فقلت",
                      "y2":  1256
                  },
                  {
                      "y":  306,
                      "x":  1415,
                      "text":  "معلومة",
                      "y2":  306
                  },
                  {
                      "y":  378,
                      "x":  1410,
                      "text":  "إثرائية",
                      "y2":  378
                  },
                  {
                      "y":  2053,
                      "x":  1650,
                      "text":  "٥٨",
                      "y2":  2053
                  }
              ],
