                      "text":  "أجله بدنو إشعار هذا وفي الموت، ملك أي : ربي رسول يأتيني أن يوشك",
                      "y2":  428
                  },
                  {
                      "y":  577,
                      "x":  253,
                      "text":  ". الموت عند تستاذن الأنبياء لأن روحي؛ قبض على بالموافقة فأجيبه فأجيب: ر",
                      "y2":  624
                  },
                  {
                      "y":  672,
                      "x":  840,
                      "text":  "عظيمين. أمرين أي ثقلين: فيكم تارك وأنا O",
                      "y2":  683
                  },
                  {
                      "y":  768,
                      "x":  806,
                      "text":  "وهم: بيتي أهل الأمرين ثاني أي بيتي: وأهل",
                      "y2":  792
                  },
                  {
                      "y":  859,
                      "x":  261,
                      "text":  "حقوقهم. وأداء بمحبتهم بيتي أهل في أوصيكم بيتي: أهل في الله أذكركم",
                      "y2":  883
                  },
                  {
                      "y":  1023,
                      "x":  1029,
                      "text":  "الحديث من يستفاد مما",
                      "y2":  1039
                  },
                  {
                      "y":  1178,
                      "x":  783,
                      "text":  ". الحق على للاستقامة وأهميته القرآن شرف",
                      "y2":  1209
                  },
                  {
                      "y":  1264,
                      "x":  984,
                      "text":  ". مطته النبي بيت أهل منزلة عظم",
                      "y2":  1305
                  },
                  {
                      "y":  1367,
                      "x":  1017,
                      "text":  "بيته. باهل الرسول ■اهتمام",
                      "y2":  1384
                  },
                  {
                      "y":  1454,
                      "x":  213,
                      "text":  "أهل حق ورعاية بالقرآن، الاستمساك في بفه نبينا وصية حفظ علينا",
                      "y2":  1481
                  },
                  {
                      "y":  1559,
                      "x":  1112,
                      "text":  "جفاء. ولا غلو بدون بيته",
                      "y2":  1578
                  },
                  {
                      "y":  1645,
                      "x":  794,
                      "text":  "،ثددر",
                      "y2":  1645
                  },
                  {
                      "y":  1656,
                      "x":  426,
                      "text":  "وذمهم. واحتقارهم شيز البيت آل في الجفاء من الحذر",
                      "y2":  1679
                  },
                  {
                      "y":  1678,
                      "x":  1451,
                      "text":  "يس",
                      "y2":  1678
                  },
                  {
                      "y":  1739,
                      "x":  873,
                      "text":  "\") اثدد",
                      "y2":  1739
                  },
                  {
                      "y":  1753,
                      "x":  213,
                      "text":  "يجري بشر لأنهم منزلتهم فوق ورفعهم عيز البيت آل في الغلو من الحذر",
                      "y2":  1775
                  },
                  {
