{
    "lines":  [
                  {
                      "y":  305,
                      "x":  1418,
                      "text":  "معلومة",
                      "y2":  305
                  },
                  {
                      "y":  334,
                      "x":  947,
                      "text":  "المسلمين: غير معاملة أحكام من",
                      "y2":  352
                  },
                  {
                      "y":  378,
                      "x":  1413,
                      "text":  "إثرائية:",
                      "y2":  378
                  },
                  {
                      "y":  420,
                      "x":  259,
                      "text":  "ويجري المالية، العقود وسائر والإيجار والشراء بالبيع المسلمين غير مع التعامل يجوز - ١",
                      "y2":  436
                  },
                  {
                      "y":  495,
                      "x":  485,
                      "text":  "المسلمين. مع التعامل على يجري ما والضوابط الأحكام من عليهم",
                      "y2":  516
                  },
                  {
                      "y":  576,
                      "x":  258,
                      "text":  "في يجري أن شريطة شركة، عقد المحارب غير الكافر مع يعقد أن للمسلم يجوز ٢-",
                      "y2":  596
                  },
                  {
                      "y":  663,
                      "x":  757,
                      "text":  "الإسلامية. الشربعة قواعد وفق على الشركة",
                      "y2":  666
                  },
                  {
                      "y":  744,
                      "x":  780,
                      "text":  "منه. والاقتراض المسلم غير إقراض يجوز - ٣",
                      "y2":  753
                  },
                  {
                      "y":  819,
                      "x":  277,
                      "text":  "الشرعية. للضوابط وفقا بأموره، القيام في عنه بدلا المسلم غير المسلم يوكل أن يجوز - ٤",
                      "y2":  835
                  },
                  {
                      "y":  900,
                      "x":  259,
                      "text":  "وغيرها، والكتب الأدوات من يحتاجه ما المسلم غير من الاستعارة للمسلم",
                      "y2":  918
                  },
                  {
                      "y":  912,
                      "x":  1216,
                      "text":  "يجور - ٥",
                      "y2":  921
                  },
                  {
                      "y":  981,
                      "x":  417,
                      "text":  "لهم. جائز وهو الإحسان، من لأنها محارب، غير كان إذا إعارته وكذلك",
                      "y2":  999
                  },
                  {
                      "y":  1068,
                      "x":  259,
                      "text":  "مع يشترمط- الايداع حال في لكن وإيداعهم، المسلمين، غير ودائع قبول للمسلم يجوز --",
                      "y2":  1073
                  },
                  {
                      "y":  1143,
                      "x":  872,
                      "text":  "أمناء. كونهم محاربينـ غير كونهم",
                      "y2":  1153
                  },
                  {
                      "y":  1229,
                      "x":  259,
                      "text":  "ملك المقوقس هدية ج النبي قبل كما وإهدائه، المسلم غير هدية قبول للمسلم",
                      "y2":  1232
                  },
                  {
                      "y":  1234,
                      "x":  1188,
                      "text":  "يجوز ٧-",
                      "y2":  1236
                  },
                  {
                      "y":  1305,
                      "x":  303,
                      "text":  "حلة مشركا له أخا ته عمر أهدى وكما القبطية، مارية ضمنها من وكانت مصر،",
                      "y2":  1325
                  },
                  {
                      "y":  1324,
                      "x":  258,
                      "text":  "من",
                      "y2":  1324
                  },
                  {
                      "y":  1386,
                      "x":  871,
                      "text":  ". عمر أعطاها ة النبي كان حرير",
                      "y2":  1414
                  },
                  {
                      "y":  1467,
                      "x":  256,
                      "text":  "يجوز لا محترمة، بها الانتفاع على الإسلام أقرهم التي المحاربين غير الكفار ٨-أموال",
                      "y2":  1479
                  },
                  {
                      "y":  1553,
                      "x":  709,
                      "text":  "حيازتها. للمسلم يجوز لا مما كانت ولو إتلافها،",
                      "y2":  1560
                  }
              ],
    "image":  "page-097.png"
}