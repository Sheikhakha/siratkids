{
    "lines":  [
                  {
                      "y":  396,
                      "x":  561,
                      "text":  "من الرحيم الرحمن الله بسم",
                      "y2":  421
                  },
                  {
                      "y":  507,
                      "x":  561,
                      "text":  "هرقل إلى ورسوله عبدالله محمد،",
                      "y2":  526
                  },
                  {
                      "y":  618,
                      "x":  561,
                      "text":  "اتبع من على سلام الروم، عظيم",
                      "y2":  640
                  },
                  {
                      "y":  718,
                      "x":  561,
                      "text":  "أدعوك فإني بعد: أما الهدى",
                      "y2":  750
                  },
                  {
                      "y":  829,
                      "x":  561,
                      "text":  "يؤتك تسلم أسلم الإسلام، بدعاية",
                      "y2":  846
                  },
                  {
                      "y":  940,
                      "x":  561,
                      "text":  "فإن توليت فإن مرتين، أجرك الله",
                      "y2":  957
                  },
                  {
                      "y":  1050,
                      "x":  836,
                      "text":  "الأريسيين إثم عليك",
                      "y2":  1061
                  },
                  {
                      "y":  1331,
                      "x":  1179,
                      "text":  "والمواثيق بالعهود وفاؤه",
                      "y2":  1333
                  },
                  {
                      "y":  1442,
                      "x":  214,
                      "text":  "خرجت أني إلا بدرا أشهد أن منعني ما قال: يزفا اليمان بن حذيفة عن",
                      "y2":  1467
                  },
                  {
                      "y":  1533,
                      "x":  553,
                      "text":  "إنكم قالوا: قريش، كفار فأخذنا قال: حسيل، وأبي أنا",
                      "y2":  1545
                  },
                  {
                      "y":  1543,
                      "x":  216,
                      "text":  "؟ محمدا تريدون",
                      "y2":  1547
                  },
                  {
                      "y":  1622,
                      "x":  214,
                      "text":  "إلى لننصرفن وميثاقه الله عهد منا فأخذوا المدينة إلا نريد ما نريده، ما فقلنا:",
                      "y2":  1644
                  },
                  {
                      "y":  1720,
                      "x":  214,
                      "text":  "لهم نفي انصرفا فقال: الخبر، فأخبرناه ج الله رسول فأتينا معه، نقاتل ولا المدينة",
                      "y2":  1745
                  },
                  {
                      "y":  1813,
                      "x":  1045,
                      "text":  "» الله ونستعين بعهدهم",
                      "y2":  1833
                  },
                  {
                      "y":  1976,
                      "x":  231,
                      "text":  "١٠٩ ص ١٢ ج للنووي مسلم صحيح شرح انظر بانقيادك، وينقادون يتبعونك الذين رعاياك إثم عليك أن ومعناه والزراعون الفلاحون أي (١)",
                      "y2":  1989
                  },
                  {
                      "y":  2019,
                      "x":  876,
                      "text":  "١٧٨٧ برقم بالعهد الوفاء باب والسير الجهاد كتاب في مسلم أخرجه (٢)",
                      "y2":  2022
                  },
                  {
                      "y":  2053,
                      "x":  87,
                      "text":  "٨٩",
                      "y2":  2053
                  }
