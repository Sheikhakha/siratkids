                      "text":  "اللرس",
                      "y2":  114
                  },
                  {
                      "y":  167,
                      "x":  226,
                      "text":  ") (٢ الصخار مع التعامل في هديه",
                      "y2":  172
                  },
                  {
                      "y":  1029,
                      "x":  869,
                      "text":  "يكلا: النبي الصغارعند مكانة على أتعرف",
                      "y2":  1038
                  },
                  {
                      "y":  1138,
                      "x":  188,
                      "text":  "يوليهم كان فقد لديه، الخاصة مكانتهم للصغار أن إلا ، الجميع مع التعامل حسن كلا النبي",
                      "y2":  1168
                  },
                  {
                      "y":  1218,
                      "x":  568,
                      "text":  "ذلك: على الأمثلة بعض يلي وفيما والرعاية، الاهتمام من مزيدا",
                      "y2":  1254
                  },
                  {
                      "y":  1324,
                      "x":  1016,
                      "text":  "بالصغار: ßß رحمته على أتعرف",
                      "y2":  1333
                  },
                  {
                      "y":  1415,
                      "x":  188,
                      "text":  "في الصفة تلك وتتجلى الرحمة صفاته من",
                      "y2":  1424
                  },
                  {
                      "y":  1467,
                      "x":  187,
                      "text":  "المنبر على يخطب لا كان فقد الأطفال، مع تعامله ،سهر",
                      "y2":  1527
                  },
                  {
                      "y":  1587,
                      "x":  188,
                      "text":  "أحمران قميصان عليهما هيئتيه، والحسين الحسن فأقبل",
                      "y2":  1598
                  },
                  {
                      "y":  1677,
                      "x":  188,
                      "text":  "ثم المنبر، بهما فصعد فأخذهما، فنزل ويقومان، يعثران",
                      "y2":  1691
                  },
                  {
                      "y":  1759,
                      "x":  396,
                      "text":  "وكتة ثر وأولـد أمالكم إنـما : الله صدق قال:",
                      "y2":  1776
                  },
                  {
                      "y":  1762,
                      "x":  188,
                      "text":  "أث",
                      "y2":  1762
                  },
                  {
                      "y":  1858,
                      "x":  591,
                      "text":  "الخطبة في أخذ ثم أصبر، فلم هذين",
                      "y2":  1869
                  },
                  {
                      "y":  1740,
                      "x":  1321,
                      "text":  "تج",
                      "y2":  1740
                  },
