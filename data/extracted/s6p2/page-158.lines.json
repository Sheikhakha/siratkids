{
    "lines":  [
                  {
                      "y":  211,
                      "x":  214,
                      "text":  "له أحد كل ولان لهما، إجلالا الوالدين قدم أجمعين: والناس وولده والده من",
                      "y2":  236
                  },
                  {
                      "y":  310,
                      "x":  548,
                      "text":  "غيرهما. من المرء على أعز لأنهما والولد الوالد وذكر والدان،",
                      "y2":  330
                  },
                  {
                      "y":  701,
                      "x":  1029,
                      "text":  "الحديث من يستفاد مما",
                      "y2":  714
                  },
                  {
                      "y":  827,
                      "x":  1032,
                      "text":  ". ك الرسول محبة منزلة عظم",
                      "y2":  872
                  },
                  {
                      "y":  917,
                      "x":  857,
                      "text":  "الإيمان. واجبات من ي الرسول محبة",
                      "y2":  948
                  },
                  {
                      "y":  1008,
                      "x":  214,
                      "text":  "يحبه مما ذلك وغير والولد، النفس على ي الرسول محبة تقديم يجب",
                      "y2":  1039
                  },
                  {
                      "y":  1110,
                      "x":  1210,
                      "text":  "المحبة. غاية الناس",
                      "y2":  1110
                  },
                  {
                      "y":  1187,
                      "x":  1176,
                      "text":  "ء. صإاله",
                      "y2":  1201
                  },
                  {
                      "y":  1198,
                      "x":  518,
                      "text":  "أثرهما. و الوالدين فضل من أعظم واتره عيي الرسول فضل",
                      "y2":  1220
                  },
                  {
                      "y":  1284,
                      "x":  306,
                      "text":  "مستحلف. هناك يكن لم وإن له توكيدا المهم الأمر على الحلف جواز",
                      "y2":  1291
                  },
                  {
                      "y":  1368,
                      "x":  210,
                      "text":  "أو منزلته فوق بإنزاله فيه الغلو يجوز فلا المشروع، ضمن سكون يه محبته",
                      "y2":  1393
                  },
                  {
                      "y":  1470,
                      "x":  1229,
                      "text":  "ودعائه. به التوسل",
                      "y2":  1482
                  },
                  {
                      "y":  2054,
                      "x":  89,
                      "text":  "١٥٧",
                      "y2":  2054
                  }
              ],
