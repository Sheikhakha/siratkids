                  },
                  {
                      "y":  527,
                      "x":  770,
                      "text":  "احفظ ، يحفظك الله احفظ كلمات؛ أعلسك",
                      "y2":  564
                  },
                  {
                      "y":  605,
                      "x":  771,
                      "text":  "وإذا الله، فاسال سألت إذا تجاهك، تجده الله",
                      "y2":  622
                  },
                  {
                      "y":  688,
                      "x":  769,
                      "text":  "لو الأمة أن واغلم بالله، فاستعن استعنت",
                      "y2":  695
                  },
                  {
                      "y":  758,
                      "x":  770,
                      "text":  "إلا ينفغوك لم بشيء ينفعوك أن على اجتمعت",
                      "y2":  778
                  },
                  {
                      "y":  839,
                      "x":  770,
                      "text":  "أن على اجتمعوا ولو لك، الله كتبه قد بشيء",
                      "y2":  854
                  },
                  {
