{
    "lines":  [
                  {
                      "y":  115,
                      "x":  1440,
                      "text":  "الدرس",
                      "y2":  115
                  },
                  {
                      "y":  176,
                      "x":  458,
                      "text":  "جلسائه مع هديه",
                      "y2":  191
                  },
                  {
                      "y":  470,
                      "x":  250,
                      "text":  "السجاد على الجلوس يرفض سليمان فكان ، مجلس في وسليمان وأحمد خالد جلس",
                      "y2":  495
                  },
                  {
                      "y":  554,
                      "x":  221,
                      "text":  "بالحديث، يستأثر أن يحب المجلس في خالد وكان ، لمكانته التقدير عدم من ذلك أن ويرى",
                      "y2":  580
                  },
                  {
                      "y":  627,
                      "x":  220,
                      "text":  "عليه يظهر لم الوجه مكفهر عابسا أحمد فبقي ، قاطعهما سليمان أو أحمد تكلم فكلما",
                      "y2":  662
                  },
                  {
                      "y":  722,
                      "x":  1026,
                      "text":  "أصدقائه. بمجالسة الرضا أو السرور",
                      "y2":  730
                  },
                  {
                      "y":  850,
                      "x":  246,
                      "text":  "وانظر وأصدقاؤه، خالد فيها وقع التي الأخطاء اكتشف زملائك مع بالتعاون",
                      "y2":  879
                  },
                  {
                      "y":  931,
                      "x":  525,
                      "text":  ": يجذ هديه في وردت كما المجلس آداب إلى",
                      "y2":  956
                  },
                  {
                      "y":  1115,
                      "x":  968,
                      "text":  "جلسائه: مع جا النبي صفات من",
                      "y2":  1143
                  },
                  {
                      "y":  1235,
                      "x":  1137,
                      "text":  "مجلسه: في نز تواضعه",
                      "y2":  1243
                  },
                  {
                      "y":  1348,
                      "x":  188,
                      "text":  "فلا الغريب فيجيء أصحابه مع يجلس فكان ومجلسه، ومركبه وملبسه مأكله في التواضع",
                      "y2":  1377
                  },
                  {
                      "y":  1447,
                      "x":  984,
                      "text":  ". يسأل حتى يجلا الله رسول أيهم يدري",
                      "y2":  1484
                  },
                  {
                      "y":  1447,
                      "x":  996,
                      "text":  "١)",
                      "y2":  1447
                  },
                  {
                      "y":  1543,
                      "x":  189,
                      "text":  "لم : عيد أنس قال ، المجلس دخل إذا له أصحابه يقوم أن كراهته تواضعه: ومن",
                      "y2":  1571
                  },
                  {
                      "y":  1641,
                      "x":  188,
                      "text":  "يعلمون لما يقوموا لم رأوه إذا وكانوا ج، الله رسول من إليهم أحب شخص يكن",
                      "y2":  1669
                  },
                  {
                      "y":  1744,
                      "x":  1176,
                      "text":  "\"، لذلك. كراهيته من",
                      "y2":  1765
                  },
                  {
                      "y":  1940,
                      "x":  1002,
                      "text":  "(٤٩٩١). برقم: والنسائي (٦٣)، برقم: داود أبو أخرجه (١)",
                      "y2":  1943
                  },
                  {
                      "y":  1983,
                      "x":  716,
