                  },
                  {
                      "y":  1435,
                      "x":  1154,
                      "text":  "الصالحة.",
                      "y2":  1435
                  },
                  {
                      "y":  1501,
                      "x":  272,
                      "text":  "أول التوحيد ليكون اليمنى أذنه في يؤذن وأن اسمه، اختيار حسن",
                      "y2":  1526
                  },
                  {
                      "y":  1585,
                      "x":  1087,
                      "text":  "يسمعه. شىء",
                      "y2":  1594
                  },
                  {
                      "y":  1651,
                      "x":  528,
                      "text":  "له. والطهارة النظافة لتحقيق وذلك الذكور، ختان",
                      "y2":  1653
                  },
                  {
                      "y":  1723,
                      "x":  273,
                      "text":  "المولود، تغذية في كبيرة فوائد لها والتي الطبيعية الرضاعة على حث",
                      "y2":  1732
                  },
                  {
