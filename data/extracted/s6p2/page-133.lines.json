{
    "lines":  [
                  {
                      "y":  243,
                      "x":  1534,
                      "text":  "معلومة",
                      "y2":  243
                  },
                  {
                      "y":  306,
                      "x":  218,
                      "text":  "الأرض على بكبدي لأعتمد كنت إن هو إلا إله لا الذي الله : قال شويقه هريرة أبي عن",
                      "y2":  323
                  },
                  {
                      "y":  330,
                      "x":  1533,
                      "text":  "إثرائية",
                      "y2":  330
                  },
                  {
                      "y":  357,
                      "x":  220,
                      "text":  "على يوما قعدت ولقد الجوع، من بطني على الحجر لأشد كنت وإن الجوع، من",
                      "y2":  391
                  },
                  {
                      "y":  428,
                      "x":  219,
                      "text":  "سألته ما الله كتاب من آية عن فسالته بكر أبو فمر منه، يخرجون الذي طريقهم",
                      "y2":  451
                  },
                  {
                      "y":  491,
                      "x":  220,
                      "text":  "ما الله كتاب من آية عن فسألته عمر، بي مر ثم يفعل، ولم فمر ليشبعني، إلا",
                      "y2":  512
                  },
                  {
                      "y":  548,
                      "x":  220,
                      "text":  "رآني حين فتبسم نه القاسم أبو بي مر ثم يفعل، فلم فمر ليشبعني إلا سالته",
                      "y2":  576
                  },
                  {
                      "y":  617,
                      "x":  220,
                      "text":  "رسول يا لبيك قلت: هر، أبا يا قال: ثم وجهي، في وما نفسي في ما وعرف",
                      "y2":  634
                  },
                  {
                      "y":  675,
                      "x":  221,
                      "text":  "قدح، في لبنا فوجد فدخل لي، فأذن فاستأذن فدخل فتبعته، ومضي، الحق : قال الله،",
                      "y2":  690
                  },
                  {
                      "y":  739,
                      "x":  220,
                      "text":  "يا لبيك قلت: هر أبا قال: فلانة، أو فلان لك أهداه قالوا اللبن هذا أين من فقال:",
                      "y2":  757
                  },
                  {
                      "y":  794,
                      "x":  220,
                      "text":  "الإسلام أضياف الضفة وأهل : قال لي، فادعهم الصفة أهل إلى الجق : قال الله، رسول",
                      "y2":  814
                  },
                  {
                      "y":  862,
                      "x":  220,
                      "text":  "يتناول ولم إليهم، بها بعث صدقة أتته إذا أحد؛ على ولا مال، ولا أهل إلى يأوون لا",
                      "y2":  870
                  },
                  {
                      "y":  926,
                      "x":  221,
                      "text":  "ذلك، فساءني فيها، وأشركهم منها وأصاب إليهم أرسل هدية أتته وإذا شيئا، منها",
                      "y2":  930
                  },
                  {
                      "y":  979,
                      "x":  219,
                      "text":  "شربة اللبن هذا من أصيب أن أنا أحق كنت الضفة؟! أهل في اللبن هذا وما فقلت:",
                      "y2":  1003
                  },
                  {
                      "y":  1044,
                      "x":  221,
                      "text":  "اللبن، هذا من يبلغني أن عسى وما أعطيهم، أنا فكنت أمرني جاؤا فإذا بها، أتقوى",
                      "y2":  1066
                  },
                  {
                      "y":  1100,
                      "x":  221,
                      "text":  "فاستاذنوا، فأقبلوا فدعوتهم، فاتيتهم بد، ن رسوله وطاعة الله طاعة من يكن ولم",
                      "y2":  1127
                  },
                  {
                      "y":  1168,
                      "x":  221,
                      "text":  "الله، رسول يا لبيك قلت: هر، أبا يا قال: البيت، من مجالسهم وأخأوا لهم،",
                      "y2":  1189
                  },
                  {
                      "y":  1172,
                      "x":  1418,
                      "text":  "فاذن",
                      "y2":  1172
                  },
                  {
                      "y":  1232,
                      "x":  221,
                      "text":  "يروى، حتى فيشرب الرجل أعطيه فجعلت القدح فأخذت : قال فأعطهم، خذ : قال",
                      "y2":  1246
                  },
                  {
                      "y":  1294,
                      "x":  220,
                      "text":  "فيشرب القدح علي يرد ثم يروى، حتى فيشرب الرجل فأعطيه القدح علي يرد ثم",
                      "y2":  1308
                  },
                  {
                      "y":  1345,
                      "x":  221,
                      "text":  "كلهم، القوم روي وقد ج النبي إلى انتهيت حتى القدح علي يرد ثم يروى، حتى",
                      "y2":  1370
                  },
                  {
                      "y":  1407,
                      "x":  220,
                      "text":  "رسول يا لبيك : قلت هر، أبا : فقال فتبسم، إلي فنظر يده، على فوضعه القدح فاخذ",
                      "y2":  1432
                  },
                  {
                      "y":  1474,
                      "x":  220,
                      "text":  "فقعدت فاشرب اقعد : قال الله، رسول يا صدقت قلت: وأنت، أنا بقيت قال: الله،",
                      "y2":  1491
                  },
                  {
                      "y":  1538,
                      "x":  220,
                      "text":  "بعثك والذي لا قلت: حتى اشرب يقول: زال فما فشربت اشرب، فقال: فشربت،",
                      "y2":  1554
                  },
                  {
                      "y":  1597,
                      "x":  220,
                      "text":  "وشرب وسمى الله فحمد القدح، فأعطيته فأرني، قال: مسلكا، له أجد ما بالحق",
                      "y2":  1619
                  },
                  {
                      "y":  1653,
                      "x":  1324,
                      "text":  ". الفضلة",
                      "y2":  1691
                  },
                  {
                      "y":  2012,
                      "x":  1189,
                      "text":  "٦٤٥٢). ( برقم: البخاري، أخرجه ) ١ (",
