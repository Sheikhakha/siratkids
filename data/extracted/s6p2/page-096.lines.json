    "lines":  [
                  {
                      "y":  199,
                      "x":  1341,
                      "text":  ": صفاتها من",
                      "y2":  209
                  },
                  {
                      "y":  318,
                      "x":  218,
                      "text":  "سخية هييي بكر أبي بنت أسماء كانت قال: المنكدر، بن محمد عن : والجود السخاء",
                      "y2":  344
                  },
                  {
                      "y":  424,
                      "x":  218,
                      "text":  "ترتني؛ وأسماء عائشة من أجود قط امرأة رأيت ما يقول: الزبيريوتؤيها ابن وكان النفس،",
                      "y2":  450
                  },
                  {
                      "y":  529,
                      "x":  218,
                      "text":  "عندها اجتمع إذا حتى الشيء، إلى الشيء تجمع فكانت عائشة، أما مختلف: وجودهما",
                      "y2":  549
                  },
                  {
                      "y":  630,
                      "x":  709,
                      "text":  "لغد. شيئا تدخر لا فكانت أسماء، وأما مواضعه، وضعته",
                      "y2":  649
                  },
                  {
                      "y":  963,
                      "x":  245,
                      "text":  "أمر على التحري في يتيقا أسماء حرص على دلالة الحديث في",
                      "y2":  984
                  },
                  {
                      "y":  1038,
                      "x":  1071,
                      "text":  "ذلك. وضح دينها،",
                      "y2":  1040
                  },
                  {
                      "y":  1403,
                      "x":  1323,
                      "text":  "ه",
                      "y2":  1403
                  },
                  {
                      "y":  1553,
                      "x":  691,
                      "text":  "كافرا. كان ولو للقريب للإحسان يدعو الإسلام",
                      "y2":  1585
                  },
                  {
                      "y":  1659,
                      "x":  677,
                      "text":  "جائز. أمر والصلح الهدنة زمن في الكفار معاملة",
                      "y2":  1676
                  },
                  {
                      "y":  2053,
                      "x":  83,
                      "text":  "AO",
                      "y2":  2053
