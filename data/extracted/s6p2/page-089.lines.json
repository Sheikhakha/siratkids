{
    "lines":  [
                  {
                      "y":  101,
                      "x":  1439,
                      "text":  "الدرس",
                      "y2":  101
                  },
                  {
                      "y":  175,
                      "x":  184,
                      "text":  "المسامين غير",
                      "y2":  175
                  },
                  {
                      "y":  555,
                      "x":  240,
                      "text":  "فيها انتشر قد بعثته موطن العرب جزيرة وكانت كافة، الناس إلى تكة النبي",
                      "y2":  564
                  },
                  {
                      "y":  623,
                      "x":  240,
                      "text":  "العرب مع الجزيرة يسكن وكان فيها، حد المو فقل الأوثان، وعبادة بالله الشرك",
                      "y2":  660
                  },
                  {
                      "y":  727,
                      "x":  239,
                      "text":  "تعامل كان فكيف نجران، في النصارى وبعض المدينة، في اليهود بعض",
                      "y2":  737
                  },
                  {
                      "y":  815,
                      "x":  240,
                      "text":  "الغلظة عل مبنية معهم معاملته كانت هل ؟ الكفار هؤلاء مع بكه النبي",
                      "y2":  836
                  },
                  {
                      "y":  897,
                      "x":  935,
                      "text":  "والشفقة؟ الرحمة عل أم ؟ والعنف",
                      "y2":  907
                  },
                  {
                      "y":  1174,
                      "x":  519,
                      "text":  "المسلمين: غير مع التعامل في يلا النبي هدي على أتعرف",
                      "y2":  1197
                  },
                  {
                      "y":  1290,
                      "x":  799,
                      "text":  "الإسلام: إلى الكفار دعوة في النبي هدي",
                      "y2":  1303
                  },
                  {
                      "y":  1385,
                      "x":  187,
                      "text":  "جا وكان الإسلام، إلى الناس وإرشاد الله إلى للدعوة مسخرة بعثته بعد لا النبي حياة كانت",
                      "y2":  1403
                  },
                  {
                      "y":  1479,
                      "x":  188,
                      "text":  "الدعوة في المتنوعة الوسائل ويستخدم أذى، من الدعوة هذه سبيل في يصيبه ما على يصبر",
                      "y2":  1504
                  },
                  {
                      "y":  1578,
                      "x":  188,
                      "text":  "إلى لدعوتهم العربية الجزيرة خارج الكفار يراسل وكان ، الحسنة والموعظة بالحكمة الله إلى",
                      "y2":  1598
                  },
                  {
                      "y":  1669,
                      "x":  188,
                      "text":  "ليدعوهم وغيرها الحبشة ونجاشي الفرس وكسرى الروم قيصر إلى بالرسائل فبعث الإسلام،",
                      "y2":  1678
                  },
                  {
                      "y":  1764,
                      "x":  993,
                      "text":  "الروم: لقيصر ماكتبه فكان الإسلام، إلى",
                      "y2":  1766
                  },
                  {
                      "y":  2054,
                      "x":  1647,
                      "text":  "٨",
                      "y2":  2054
                  }
              ],
    "image":  "page-089.png"
}