{
    "lines":  [
                  {
                      "y":  149,
                      "x":  481,
                      "text":  "يج لنبيه الله حفظ",
                      "y2":  198
                  },
                  {
                      "y":  120,
                      "x":  1519,
                      "text":  "الدرس",
                      "y2":  120
                  },
                  {
                      "y":  584,
                      "x":  194,
                      "text":  "، تكي النبي سيرة عن تتحدث التى الكتب في وبخاصة بالقراءة، يهتم أحمد كان",
                      "y2":  613
                  },
                  {
                      "y":  660,
                      "x":  261,
                      "text":  "الرياضية. والتمارين بالتغذية جسمه وتقوية الرياضة يهوى خالد أخوه وكان",
                      "y2":  691
                  },
                  {
                      "y":  778,
                      "x":  246,
                      "text":  "الآتي: الحوار بينهما وجرى المكتبة في يقرا وهو أحمد على خالد دخل",
                      "y2":  809
                  },
                  {
                      "y":  894,
                      "x":  169,
                      "text":  "من نفسي أحفظ شجاعا، وأكون قوتي تزيد كي كثيرا اليوم تدربت لقد خالد:",
                      "y2":  935
                  },
                  {
                      "y":  1033,
                      "x":  1258,
                      "text":  ". بي يتحل خطر أي",
                      "y2":  1065
                  },
                  {
                      "y":  1140,
                      "x":  628,
                      "text":  ". الله فالحافظ الحماية، يعطى لا وحده التدريب أحمد:",
                      "y2":  1181
                  },
                  {
                      "y":  1243,
                      "x":  1023,
                      "text":  "عبده؟ الله يحفظ وكيف خالد:",
                      "y2":  1268
                  },
                  {
                      "y":  1373,
                      "x":  185,
                      "text":  ". محمدا نبينا حفظ كما شاه، بما عبده فيحفظ والارض، السماوات جنود لله أحمد:",
                      "y2":  1414
                  },
                  {
                      "y":  1484,
                      "x":  171,
                      "text":  "أعلم فأنا ، تمي نبيه فيها الله حفظ مواقف عن تخبرني أحمد يا لعلك خالد:",
                      "y2":  1516
                  },
                  {
                      "y":  1605,
                      "x":  1086,
                      "text":  ". ا سيرته بقراءة اهتمامك",
                      "y2":  1647
                  },
                  {
                      "y":  1713,
                      "x":  450,
                      "text":  ". بن نبيه فيها الله حفظ بمواقف سأخبرك خالد، يا حسنا أحمد:",
                      "y2":  1765
                  },
                  {
                      "y":  1847,
                      "x":  781,
                      "text":  ". ذلك لسماع أتشوق فأنا أحمد يا هيا خالد:",
                      "y2":  1883
                  },
                  {
                      "y":  1950,
                      "x":  316,
                      "text":  ": منها لنبيه الله حفظ على تدل كثيرة مواقف خالد يا قرات أحمد:",
                      "y2":  1980
                  },
                  {
                      "y":  2054,
                      "x":  1645,
                      "text":  "١٣",
                      "y2":  2054
                  }
              ],
