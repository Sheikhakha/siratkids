{
    "lines":  [
                  {
                      "y":  234,
                      "x":  476,
                      "text":  "؟ المسلم أخلاق من التواضع أن على الحديث دل كيف أبين",
                      "y2":  257
                  },
                  {
                      "y":  367,
                      "x":  1470,
                      "text":  "٢",
                      "y2":  367
                  },
                  {
                      "y":  803,
                      "x":  1296,
                      "text":  "ي",
                      "y2":  803
                  },
                  {
                      "y":  963,
                      "x":  695,
                      "text":  "مجلسه. من أحدا أقيم لا أن المجلس آداب من",
                      "y2":  995
                  },
                  {
                      "y":  1062,
                      "x":  575,
                      "text":  "المجلس. بي ينتهي حيث أجلس أن المجلس آداب من",
                      "y2":  1092
                  },
                  {
                      "y":  1259,
                      "x":  1039,
                      "text":  "المجالس: آداب من",
                      "y2":  1281
                  },
                  {
                      "y":  1342,
                      "x":  530,
                      "text":  "منه. الخروج وعند المجلس، إلى الدخول عند السلام -",
                      "y2":  1361
                  },
                  {
                      "y":  1417,
                      "x":  385,
                      "text":  "متواضع. مكان إلى به انتهى ولو المجلس، ينتهي حيث -الجلوس",
                      "y2":  1430
                  },
                  {
                      "y":  1486,
                      "x":  247,
                      "text":  "فقيرا. رجلا أو صغيرا طفلا كان ولو فيه؛ والجلوس مكانه عن أحد إبعاد تجن -",
                      "y2":  1511
                  },
                  {
                      "y":  1566,
                      "x":  293,
                      "text":  "بينهما. له فسحا إذا إلا قبله بعضهما مع جلسا اثنين بين الجلوس تجنب -",
                      "y2":  1585
                  },
                  {
                      "y":  1641,
                      "x":  443,
                      "text":  "الناس. فيه تحلق مجلس في الحلقة وسط في الجلوس تجنب -",
                      "y2":  1658
                  },
                  {
                      "y":  1717,
                      "x":  826,
                      "text":  "الثالث. دون اثنين تناجي بجنب -",
                      "y2":  1735
                  },
                  {
                      "y":  1786,
                      "x":  246,
                      "text":  "جلوس، وهم ؛كالاستلقاء الحاضرين بين الأدب هيئة غير على الجلوس تجنب -",
                      "y2":  1809
                  },
                  {
                      "y":  1861,
                      "x":  413,
                      "text":  "الأرجل. مد أو الأرض، على وهم مرتفع مكان في القعود أو",
                      "y2":  1880
                  },
                  {
                      "y":  1936,
                      "x":  254,
                      "text":  "الخيانة. من فذلك أصحابها، عليه ائتمنه وما المجالس، أسرار إفشاء تجنب -",
                      "y2":  1960
                  },
                  {
                      "y":  1570,
                      "x":  1310,
                      "text":  "٤",
                      "y2":  1570
                  },
                  {
                      "y":  1326,
                      "x":  1414,
                      "text":  "معلومة",
                      "y2":  1326
                  },
                  {
                      "y":  1398,
                      "x":  1409,
                      "text":  "إثرائية؛",
                      "y2":  1398
                  },
                  {
                      "y":  2049,
                      "x":  1653,
                      "text":  "٤٦",
                      "y2":  2049
                  }
