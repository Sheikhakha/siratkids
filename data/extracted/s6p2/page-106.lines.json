                      "y2":  215
                  },
                  {
                      "y":  503,
                      "x":  253,
                      "text":  "بالحيوان، الرفق جماعات جهود عن ، تقريرا الجريدة في قرأت",
                      "y2":  532
                  },
                  {
                      "y":  508,
                      "x":  1393,
                      "text":  ". الله عبد",
                      "y2":  543
                  },
                  {
                      "y":  587,
                      "x":  253,
                      "text":  "الحيوانات؛ من كبيرة وأعداد أنواع حياة إنقاذ في ساهمت وكيف",
                      "y2":  615
                  },
                  {
                      "y":  671,
                      "x":  253,
                      "text":  "تحمي قوانين وضعت الدول من عددا وأن العابثين، من وحمايتها",
                      "y2":  699
                  },
                  {
                      "y":  744,
                      "x":  250,
                      "text":  "تقدما هذا أليس ، المخالفين وتعاقب ، حقوقها وتحفظ الحيوانات",
                      "y2":  782
                  },
                  {
                      "y":  847,
                      "x":  1245,
                      "text":  "م ب كبيرا",
                      "y2":  849
                  },
                  {
                      "y":  934,
                      "x":  1474,
                      "text":  "صالح",
                      "y2":  934
                  },
                  {
                      "y":  937,
                      "x":  574,
                      "text":  "اليوم؟ حضارة وليد هذا إن قال من ولكن بلى،",
                      "y2":  956
                  },
                  {
                      "y":  1023,
                      "x":  1393,
                      "text":  ". الله عبد",
                      "y2":  1060
                  },
                  {
                      "y":  1027,
                      "x":  1184,
                      "text":  "تقصد؟ ماذا",
                      "y2":  1029
                  },
                  {
                      "y":  1109,
                      "x":  254,
                      "text":  "وهذا إليه الإسلام سبق بالحيوان الرفق عن ذكرته ما أن أقصد :",
                      "y2":  1134
                  },
                  {
                      "y":  1114,
                      "x":  1474,
                      "text":  "صالح",
                      "y2":  1114
                  },
                  {
                      "y":  1194,
                      "x":  879,
                      "text":  "أقول: ما على مثال الحديث",
                      "y2":  1206
                  },
                  {
                      "y":  1446,
                      "x":  282,
                      "text":  "ربطئها هرة في النار امرأة دخلث « قال: جلا النبي عن برها عمر ابن عن",
                      "y2":  1474
                  },
                  {
                      "y":  1561,
                      "x":  684,
                      "text":  "الأرض خشاش من تأكل تدعها ولم تطعمها فلم",
                      "y2":  1573
