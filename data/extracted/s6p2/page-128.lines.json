                  {
                      "y":  178,
                      "x":  214,
                      "text":  "رسول يا قالوا: مجاعة، الناس أصاب تبوك غزوة كان لما : قال رمويثيه هريرة أبي وعن",
                      "y2":  192
                  },
                  {
                      "y":  261,
                      "x":  213,
                      "text":  "الله رسول فقال واذهنا، فأكلنا عليها نركب التي إبلنا فنحرنا لنا أذنت لو الله",
                      "y2":  272
                  },
                  {
                      "y":  342,
                      "x":  277,
                      "text":  "المركو قل فعلت إن الله رسول يا : فقال وفيه عمر فجاء : قال «افعلوا»، :",
                      "y2":  371
                  },
                  {
                      "y":  378,
                      "x":  217,
                      "text":  "ب",
                      "y2":  378
                  },
                  {
                      "y":  423,
                      "x":  213,
                      "text":  "يجعل أن الله لعل بالبركة عليها لهم الله ادع ثم أزوادهم، بفضل ادعهم ولكن",
                      "y2":  443
                  },
                  {
                      "y":  513,
                      "x":  213,
                      "text":  "بفضل دعا ثم فبسطه، بجلد فدعا : قال «نعم»، : ف الله رسول فقال ذلك، في",
                      "y2":  546
                  },
                  {
                      "y":  605,
                      "x":  217,
                      "text":  "تمر، بكف الاخر ويجيء قال: ذرة، بكف يجيء الرجل فجعل قال: أزوادهم،",
                      "y2":  631
                  },
                  {
                      "y":  683,
                      "x":  217,
                      "text":  ": قال يسير، شيء ذلك من النطع على اجتمع حتى بكسرة، الاخر ويجيء : قال",
                      "y2":  713
                  },
                  {
                      "y":  765,
                      "x":  214,
                      "text":  "فاخذوا : قال أوعيتكم»، في «خذوا : قال ثم بالبركة، عليه ته الله رسول فدعا",
                      "y2":  798
                  },
                  {
                      "y":  858,
                      "x":  214,
                      "text":  "شبعوا حتى فأكلوا : قال ملأوه، إلا وعاء العسكر في تركوا ما حتى أوعيتهم في",
                      "y2":  880
                  },
                  {
                      "y":  936,
                      "x":  213,
                      "text":  "لا الله رسول وأني الله إلا إله لا أن «أشهد : مي الله رسول فقال فضلة، وفضلت",
                      "y2":  969
                  },
                  {
                      "y":  1017,
                      "x":  678,
                      "text":  "، الجنة».. عن فيحجب شاك غير عبده بهما الله يلقى",
                      "y2":  1048
                  },
                  {
                      "y":  1115,
                      "x":  777,
                      "text":  "نبوته: على خ يديه بين الطعام تكثير دلائل",
