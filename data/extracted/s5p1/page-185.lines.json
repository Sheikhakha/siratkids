    "lines":  [
                  {
                      "y":  306,
                      "x":  246,
                      "text":  "الدرسي",
                      "y2":  306
                  },
                  {
                      "y":  412,
                      "x":  294,
                      "text":  "الثالث",
                      "y2":  412
                  },
                  {
                      "y":  336,
                      "x":  569,
                      "text":  "(٣) الصلاة صفة",
                      "y2":  357
                  },
                  {
                      "y":  659,
                      "x":  547,
                      "text":  "الصلاة صفة من الشابقين الدرسين في تعلمناه لما عملي بتطبيق الدرس نبدأ",
                      "y2":  688
                  },
                  {
                      "y":  809,
                      "x":  1025,
                      "text":  "الثانية الركعة ثامنا:",
                      "y2":  811
                  },
                  {
                      "y":  938,
                      "x":  536,
                      "text":  ". اكبر الله :\" قائلا الثانية، للركعة قائما ، الثانية السجدة من رأسه يرفع ثم",
                      "y2":  974
                  },
                  {
                      "y":  1034,
                      "x":  619,
                      "text":  "الاستفتا دعاء عدا ما الأولي، الركعة كصلاته الثانية الركعة ويصلي",
                      "y2":  1049
                  },
                  {
                      "y":  1197,
                      "x":  887,
                      "text":  "الأول للتشهد الجلوس تاسعا:",
                      "y2":  1207
                  },
                  {
                      "y":  1346,
                      "x":  980,
                      "text":  "للتشهد. جلس الثانية الركعة من فرغ فإذا",
                      "y2":  1365
                  },
                  {
                      "y":  1412,
                      "x":  1281,
                      "text":  "كما مفترشا ويجلس",
                      "y2":  1432
                  },
                  {
                      "y":  1430,
                      "x":  1003,
                      "text":  "السجد",
                      "y2":  1430
                  },
                  {
                      "y":  1441,
                      "x":  1143,
                      "text":  "بجن سبق",
                      "y2":  1446
                  },
                  {
                      "y":  1494,
                      "x":  888,
                      "text":  ". اليمنى ركبته أو فخذه على اليمنى كفه ويضغ",
                      "y2":  1536
                  },
                  {
                      "y":  1570,
                      "x":  891,
                      "text":  "والوسطى الإبهام ويحلق والبنصر الخنصر ويقبض",
                      "y2":  1594
                  },
                  {
                      "y":  1664,
                      "x":  1270,
                      "text":  "السبابة بأصبعه ويشير",
                      "y2":  1671
                  },
                  {
                      "y":  1733,
                      "x":  863,
                      "text":  "اليسرى ركبته أو فخذه على اليسرى كفه سسط",
                      "y2":  1753
                  },
                  {
                      "y":  1767,
                      "x":  1536,
                      "text":  "-",
                      "y2":  1767
                  },
                  {
                      "y":  1832,
                      "x":  1271,
                      "text":  "وهو: ، التشهد ويقرأ",
                      "y2":  1846
                  },
                  {
                      "y":  1911,
                      "x":  248,
                      "text":  "علينا السلام وبركاته، الله ورحمة النبي أيها عليك السلام والطيبات، والصلوات لله التحيات",
                      "y2":  1924
                  },
                  {
                      "y":  1994,
                      "x":  408,
                      "text":  "ورسوله. عبده محمدا أن وأشهد الله، إلا إله لا أن أشهد الصالحين، الله عباد وعلى",
                      "y2":  2010
                  }
              ],
    "image":  "page-185.png"
}