{
    "lines":  [
                  {
                      "y":  300,
                      "x":  1423,
                      "text":  "نشاط",
                      "y2":  300
                  },
                  {
                      "y":  469,
                      "x":  235,
                      "text":  "ما له: قلت به ما رايت فلما والالم، الحزن آثار وعليه ، يوما إليك أتى أصدقائك أحد سعد",
                      "y2":  497
                  },
                  {
                      "y":  541,
                      "x":  235,
                      "text":  "وكلما عنها، ويتكاسل الصلاة في يتهاون أخي أن صديقي يا يحزئني : قال يحزنك؟ الذي",
                      "y2":  564
                  },
                  {
                      "y":  605,
                      "x":  233,
                      "text":  "لعل ، نصحه على وداوم ، تياس ولا ، سعد يا اصبر له: قلت استجابة. منه أرى لا لصحته",
                      "y2":  641
                  },
                  {
                      "y":  683,
                      "x":  232,
                      "text":  "يمكن التي الحلول بعض لديك اليس ياصديقي لكن سعد: قال يهديه. أن تعالى الله",
                      "y2":  704
                  },
                  {
                      "y":  758,
                      "x":  237,
                      "text":  "له: قلت ؟ الصلاة ترك في مشكلته وعلاج ، أخي نصح في منها لأستفيد بها، تساعدني أن",
                      "y2":  785
                  },
                  {
                      "y":  832,
                      "x":  233,
                      "text":  "علاج إيجاد وسنحاول ، القادم العلمي اللقاء في النقاش موضع سيكون الصلاة في التهاون",
                      "y2":  858
                  },
                  {
                      "y":  902,
                      "x":  1085,
                      "text":  ". تعالى الله شاء إن المشكلة لهذه",
                      "y2":  939
                  },
                  {
                      "y":  1009,
                      "x":  271,
                      "text":  "لها. حل إيجاد ثم ، أسبابها في بالنظر ، المشكلة هذه لتدارس زملائي مع الآن أجتمع -",
                      "y2":  1039
                  }
              ],
    "image":  "page-173.png"
}