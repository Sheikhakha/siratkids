                  },
                  {
                      "y":  675,
                      "x":  787,
                      "text":  "الإقامة سماع عند المشروعة الآداب",
                      "y2":  685
                  },
                  {
                      "y":  823,
                      "x":  251,
                      "text":  "التبكير على حريص ، صلاته على محافظ ، الابتدائي الخامس الصف في طالت معاذ",
                      "y2":  855
                  },
                  {
                      "y":  908,
                      "x":  715,
                      "text":  "سمع وإذا ، وتدبر بخشوع تعالى الله كتاب يقرا إليها،",
                      "y2":  929
                  },
                  {
                      "y":  912,
                      "x":  256,
                      "text":  "وفي ، الصلاة إلى بادر الأذان",
                      "y2":  928
                  },
                  {
                      "y":  972,
                      "x":  256,
                      "text":  "إلى طريقه في وهو الإقامة وسمع ، عادته غير على الصلاة إلى الحضور عن تأخر يوم ذات",
                      "y2":  1000
                  },
                  {
                      "y":  1041,
                      "x":  258,
                      "text":  "النافلة، يصل ولم المسجد، ودخل ووقر، بسكينة مشى وإنما ، يسرج فلم ، المسجد",
