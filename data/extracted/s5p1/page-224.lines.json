{
    "lines":  [
                  {
                      "y":  272,
                      "x":  624,
                      "text":  "المسافر خلف والمقيم المقيم، خلف المسافر صلاة",
                      "y2":  274
                  },
                  {
                      "y":  403,
                      "x":  261,
                      "text":  "معه يدرك لم ولو الصلاة، إتمام عليه وجب مقيم إمام خلف المسافر صلى إذا",
                      "y2":  438
                  },
                  {
                      "y":  505,
                      "x":  1225,
                      "text":  "الاخير. التشهد إلا",
                      "y2":  512
                  },
                  {
                      "y":  593,
                      "x":  255,
                      "text":  "سلام بعد صلاته إتمام عليه وجب الصلاة يقصر مسافر خلف المقيم صلى إذا",
                      "y2":  616
                  },
                  {
                      "y":  690,
                      "x":  1430,
                      "text":  "الإمام.",
                      "y2":  690
                  },
                  {
                      "y":  922,
                      "x":  314,
                      "text":  "مع العصر صلاة من ركعتين وأدرك الدمام، إلى الرياض من أحمد سافر",
                      "y2":  957
                  },
                  {
                      "y":  1022,
                      "x":  1230,
                      "text":  "المساجد: أحد إمام",
                      "y2":  1030
                  },
                  {
                      "y":  1108,
                      "x":  306,
                      "text":  "أم مسافر، لانه الصلاة فيقصر الإمام مع يسلم أن لأحمد يجوز هل",
                      "y2":  1141
                  },
                  {
                      "y":  1202,
                      "x":  546,
                      "text":  "؟ مقيم خلف صلى لأنه الصلاة، يتم أن عليه",
                      "y2":  1215
                  },
                  {
                      "y":  1492,
                      "x":  917,
                      "text":  "والتأخير التقديم جمع",
                      "y2":  1515
                  },
                  {
                      "y":  1651,
                      "x":  256,
                      "text":  "التاخير وجمع ، الاولى الصلاة وقت في الصلاتين أداء على التقديم جمع يطلق",
                      "y2":  1680
                  },
                  {
                      "y":  1743,
                      "x":  838,
                      "text":  "الثانية. الصلاة وقت في الصلاتين أداء على",
                      "y2":  1747
                  },
                  {
                      "y":  1816,
                      "x":  261,
                      "text":  "المغرب بين والجمع ، إحداهما وقت في والعصر الظهر بين الجمع للمسافر يجوز ى",
                      "y2":  1840
                  },
                  {
                      "y":  1894,
                      "x":  261,
                      "text":  "يتسع مكان في استقر إذا الجمع ترك له والأفضل إحداهما، وقت في والعشاء",
                      "y2":  1910
                  },
                  {
                      "y":  1974,
                      "x":  941,
                      "text":  "وقتها. في صلاة كل داء لا فيه الوقت",
                      "y2":  1990
                  }
              ],
    "image":  "page-224.png"
}