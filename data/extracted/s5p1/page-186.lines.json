                  },
                  {
                      "y":  1081,
                      "x":  641,
                      "text":  "الركعة ويصلي الأصابع ممدودتي يديه ويرفع أكبر). الله ( قائلا:",
                      "y2":  1109
                  },
                  {
                      "y":  1166,
                      "x":  644,
                      "text":  "الفاتحة. سورة فيهما ويقرا الثانية، الركعة كصلاته ، والرابعة الثالثة",
                      "y2":  1192
                  },
                  {
                      "y":  1317,
                      "x":  881,
                      "text":  "الأخير التشهد عشر: حادي",
                      "y2":  1327
                  },
                  {
                      "y":  1435,
                      "x":  606,
                      "text":  "والرباعية، الثلاثية الصلاة في متوركا الأخير تشهده في يجلس ثم",
                      "y2":  1457
                  },
                  {
                      "y":  1507,
                      "x":  602,
                      "text":  "ويجعل للقبلة، أصابعها جاعلا اليمنى، قدمه ينصب أن هو: والتورك",
                      "y2":  1535
                  },
                  {
                      "y":  1589,
                      "x":  603,
                      "text":  "ويجلس اليمين، جهة من ويخرجها اليمنى، ساق تحت اليسرى القدم",
                      "y2":  1610
                  },
                  {
                      "y":  1661,
                      "x":  999,
                      "text":  "التشهد. ويقرأ الأيسر. الورك على معتمدا",
                      "y2":  1670
                  },
                  {
                      "y":  1718,
                      "x":  1127,
                      "text":  ": فيقول ، يتيق النبي على ويصلي",
                      "y2":  1755
                  },
                  {
                      "y":  1808,
                      "x":  318,
                      "text":  "إنك إبراهيم آل وعلى إبراهيم على صليت كما محمد آل وعلى محمد على صل اللهم",
                      "y2":  1825
                  },
                  {
                      "y":  1889,
                      "x":  317,
                      "text":  "وعلى إبراهيم على باركت كما محمد آل وعلى محمد على بارك اللهم مجيد حميده",
                      "y2":  1910
                  },
                  {
                      "y":  1977,
