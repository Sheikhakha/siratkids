                      "text":  "الزجاء",
                      "y2":  278
                  },
                  {
                      "y":  470,
                      "x":  1159,
                      "text":  "الرجاء تعريف",
                      "y2":  470
                  },
                  {
                      "y":  601,
                      "x":  542,
                      "text":  ". ومغفرته وكرمه ورحمته الله بفضل العبد طمع : هو الرجاء",
                      "y2":  652
                  },
                  {
                      "y":  704,
                      "x":  375,
                      "text":  ". يرجو ثم الجار، إكرام مثل: صالخا، عملا المسلم يعمل أن ذلك: مثال",
                      "y2":  742
                  },
                  {
                      "y":  707,
                      "x":  214,
                      "text":  "هذا تعمله",
                      "y2":  709
                  },
                  {
                      "y":  778,
                      "x":  1392,
                      "text":  "الله. رحمة",
                      "y2":  795
                  },
                  {
                      "y":  855,
                      "x":  217,
                      "text":  "ويدعونا الخـيزت ف يـكترعور كائوا إذهم تعالى: الله قال الرغبة، الرجاء معاني ومن",
                      "y2":  893
                  },
                  {
                      "y":  945,
                      "x":  947,
                      "text":  ". \u003c تشعيرك لنا وكانوا ورهبا رعبا",
                      "y2":  956
                  },
                  {
                      "y":  1097,
                      "x":  1098,
                      "text":  "والكاذب النافع الزجاء",
                      "y2":  1115
                  },
                  {
                      "y":  1227,
                      "x":  283,
                      "text":  "رضاه. بأسباب خذ والا تعالي، الله بطاعة بالعمل المصحوب : هو النافع الرجاء",
                      "y2":  1258
                  },
                  {
                      "y":  1318,
                      "x":  611,
                      "text":  "وتمن. غرور فهو عمل، بدون الرجاء : هو الكاذب والرجاء",
                      "y2":  1342
                  },
                  {
                      "y":  1563,
                      "x":  1309,
                      "text":  "تعالى: الله قال",
                      "y2":  1584
                  },
                  {
                      "y":  1572,
                      "x":  320,
                      "text":  "احدا ربي بعبادة يشرلة ولا صلحا عملا فليعمل ربه لقاء يرجوا ان فن",
                      "y2":  1600
                  },
                  {
                      "y":  1649,
                      "x":  891,
                      "text":  ": النافع الرجاء شروط الآية من استنبط",
                      "y2":  1673
                  },
                  {
                      "y":  2005,
                      "x":  1104,
                      "text":  "،و. آية: الأنبياء، سورة ) ١ (",
                      "y2":  2010
                  },
