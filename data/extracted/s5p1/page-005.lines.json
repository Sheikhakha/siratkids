{
    "lines":  [
                  {
                      "y":  253,
                      "x":  148,
                      "text":  "العامة والباطنة، الظاهرة الله نعم لهم ونبين وتعظيمه، الله محبة",
                      "y2":  275
                  },
                  {
                      "y":  265,
                      "x":  1302,
                      "text":  "قلوبهم في نغرس",
                      "y2":  281
                  },
                  {
                      "y":  366,
                      "x":  151,
                      "text":  "قلوبهم فـي ونغرس ونعمه، آلائه وذكر الله، محبة",
                      "y2":  393
                  },
                  {
                      "y":  366,
                      "x":  1114,
                      "text":  "قلوبهم فـي لترسخ والخاصة؛",
                      "y2":  390
                  },
                  {
                      "y":  468,
                      "x":  149,
                      "text":  "الغير ين يديه علـن حصل ما ونبين وسلم، عليو الله صلـن النبي محبة كذلـك-",
                      "y2":  491
                  },
                  {
                      "y":  576,
                      "x":  150,
                      "text":  "وآنره محبنه تقديم يجب الـذي المطاع الإمام وسلم عليه الله صلئ وأنه لأمته، العظيم",
                      "y2":  606
                  },
                  {
                      "y":  690,
                      "x":  1289,
                      "text":  "المخلوقين. جميع علن",
                      "y2":  704
                  },
                  {
                      "y":  792,
                      "x":  152,
                      "text":  "وما رإيتهقنةة، الكريمة أصحابه وأخلاق وسلم، عليه الله صلن النبي أخلاق لادنا لأز نبين",
                      "y2":  815
                  },
                  {
                      "y":  904,
                      "x":  151,
                      "text":  "وأقـام الإسلام، بهم الله نصر حتن العظيمة، والأعمال الجليلة العبادات من به قاموا",
                      "y2":  939
                  },
                  {
                      "y":  1015,
                      "x":  1502,
                      "text":  "الدين. نهم",
                      "y2":  1051
                  },
                  {
                      "y":  1120,
                      "x":  150,
                      "text":  "في والسنة التوحيد «منهاج المباركة: المناهج من السلسلة هذه كانتت المنطلق هذا ومن",
                      "y2":  1144
                  },
                  {
                      "y":  1225,
                      "x":  151,
                      "text":  "الامة لاد أز تربية علـئ والمعلمين والأمهـات الآباء لمساعدة للأطفال»؛ الشرعية العلوم",
                      "y2":  1243
                  },
                  {
                      "y":  1334,
                      "x":  644,
                      "text":  "الفاضلة. والأخلاق القويمة، والعبادة الصحيحة، العقيدة على",
                      "y2":  1345
                  },
                  {
                      "y":  1443,
                      "x":  151,
                      "text":  "الدراسية المناهـج من مجموعة وهي المناهـج من الخامسة المرحلة هي وهذه",
                      "y2":  1477
                  },
                  {
                      "y":  1548,
                      "x":  152,
                      "text":  "كتابيـن، مـن تتكون وهي المسلمين، بـلاد وجميع ومصر الله حفظها - التوحيـد لبـلاد",
                      "y2":  1566
                  },
                  {
                      "y":  1653,
                      "x":  665,
                      "text":  "والفقه،. «التوحيد مادتي يشمل الذي الأول الكتاب مو ومذا",
                      "y2":  1672
                  },
                  {
                      "y":  1764,
                      "x":  151,
                      "text":  "المسلمين آزلاد المناهـج بهـذه ينفع آن المثلـئ وصفاته الحسنن بأسمائه الله سائلين",
                      "y2":  1785
                  },
                  {
                      "y":  1871,
                      "x":  1456,
                      "text":  "مكان. كل في",
                      "y2":  1900
                  },
                  {
                      "y":  1977,
                      "x":  563,
                      "text":  "أجمعين. وأصحابه آله وعلن محمد، نبينا علن وسلم الله وصلن",
                      "y2":  1996
                  }
