{
    "lines":  [
                  {
                      "y":  288,
                      "x":  784,
                      "text":  "المقدمة",
                      "y2":  288
                  },
                  {
                      "y":  462,
                      "x":  289,
                      "text":  "وسلم. عليه الله صلن محمد نبينا علن والسلام والصلاة العالمين، رب لله الحمد",
                      "y2":  484
                  },
                  {
                      "y":  574,
                      "x":  1502,
                      "text":  "بعد: أما",
                      "y2":  577
                  },
                  {
                      "y":  678,
                      "x":  153,
                      "text":  "من بذلـك ليختبر لعبـاده؛ فتنة ذلك وجعل بـالآزلاد، عبـاده علن من الـذي لله فالحمد",
                      "y2":  704
                  },
                  {
                      "y":  789,
                      "x":  152,
                      "text":  "خسارة فيكونـون هملا، ويتركهم يضيعهم ممن الفساد عن ويصونهم بحقهم، يقـوم",
                      "y2":  810
                  },
                  {
                      "y":  898,
                      "x":  1113,
                      "text":  "الأشهاد. يقوم ويوم الدنيا في عليه",
                      "y2":  923
                  },
                  {
                      "y":  1006,
                      "x":  153,
                      "text":  "رعاتتهم مـن عليتا الله أوجب بما نقوم أن أبنائتا: فـي عليتا الله نعمة شكر من إن",
                      "y2":  1031
                  },
                  {
                      "y":  1113,
                      "x":  1064,
                      "text":  "والأعمال. الأخلاق بأحسن وتأديبهم",
                      "y2":  1127
                  },
                  {
                      "y":  1218,
                      "x":  162,
                      "text":  "مكة عليها والجارة الناش رفودها نارا رأفي أنفس ثوا -امموا النين تأنها",
                      "y2":  1233
                  },
                  {
                      "y":  1226,
                      "x":  1383,
                      "text":  "تعالـئ: الله قـال",
                      "y2":  1226
                  },
                  {
                      "y":  1329,
                      "x":  753,
                      "text":  "ي يؤمرون ما ويفعلون أمرهم ما ألته يعصون ا شدا؟ فذلا",
                      "y2":  1343
                  },
                  {
                      "y":  1343,
                      "x":  462,
                      "text":  "I٦. التحريم:",
                      "y2":  1348
                  },
                  {
                      "y":  1436,
                      "x":  154,
                      "text":  "ببيـان عليها؛ وتشجيعهم إليها، وتوجيههم لهم، الخير أبواب بفتح النار أبناءنا نقـي",
                      "y2":  1454
                  },
                  {
                      "y":  1544,
                      "x":  411,
                      "text":  "عنه. وتحذيرهم لهم، ومضاره الباطل وببيان به، وآمرهم لهم، ومنافعه الحق",
                      "y2":  1579
                  },
                  {
                      "y":  1641,
                      "x":  946,
                      "text":  "و",
                      "y2":  1641
                  },
                  {
                      "y":  1648,
                      "x":  154,
                      "text":  "رعاينه بحسن فمن رعينه، عن مسؤول راع وكل عليهم، رعاة والأمهات الآبـاء فإن",
                      "y2":  1670
                  },
                  {
                      "y":  1760,
                      "x":  750,
                      "text":  "وخسر. خاب لهم رعاينه في فرط ومن ونجا، أفلح فيهم",
                      "y2":  1784
                  },
                  {
                      "y":  1865,
                      "x":  155,
                      "text":  "عليها ونضربهم لسبع، الصبها فنعلمهم الاسلام؛ وأزكان الإيمان، أصول نعلم",
                      "y2":  1883
                  },
                  {
                      "y":  1973,
                      "x":  1337,
                      "text":  "كيف. نعلمهم لعشه،",
                      "y2":  1984
                  }
              ],
    "image":  "page-004.png"
}