                      "text":  "شاظ",
                      "y2":  174
                  },
                  {
                      "y":  316,
                      "x":  266,
                      "text":  "سبحانه الله ربوبية على الدلالة أمامك التى الله مخلوقات من استخرج",
                      "y2":  347
                  },
                  {
                      "y":  408,
                      "x":  1347,
                      "text":  "وتعالى:",
                      "y2":  408
                  },
                  {
                      "y":  1241,
                      "x":  1078,
                      "text":  "تعالى الله لعبادة أمثلة",
                      "y2":  1249
                  },
                  {
                      "y":  1337,
                      "x":  708,
                      "text":  ". الصلاة بإقامة أمر الله لان صلواتي، على أحافظ",
                      "y2":  1380
                  },
                  {
                      "y":  1415,
                      "x":  703,
                      "text":  "للإسلام. وهداني ورزقني خلقني لأنه الله، أحث",
                      "y2":  1435
                  },
                  {
                      "y":  1493,
                      "x":  968,
                      "text":  "العقاب. شديد لأنه الله، أخاف",
                      "y2":  1513
                  },
                  {
                      "y":  1571,
                      "x":  921,
                      "text":  "رحيم. غفور لأنه الله، رحمة أرجو",
                      "y2":  1603
                  },
                  {
                      "y":  1661,
                      "x":  751,
                      "text":  "بالإجابة. ووعدنا بالدعاء، أمرنا لأنه الله، أدعو",
                      "y2":  1665
                  },
                  {
                      "y":  1731,
                      "x":  706,
                      "text":  ". بذلك أمرنا الله لألان أرحامي، وأصل والدي، أبز",
                      "y2":  1769
                  },
                  {
                      "y":  1800,
                      "x":  404,
                      "text":  "المعتدين. يح لا الله لأن بيدي، ولا بلساني أحد على أعتدي لا",
                      "y2":  1837
                  },
                  {
                      "y":  1894,
                      "x":  455,
                      "text":  "بالويل. المطففين توعد تعالى الله لان والشراء، البيع في أغش لا",
                      "y2":  1905
                  },
                  {
                      "y":  1967,
                      "x":  608,
                      "text":  ". التوابين يحب الله لأن الذنوب، من التوبة على أحرص",
                      "y2":  2002
                  },
                  {
                      "y":  2084,
                      "x":  1625,
                      "text":  "٤٨",
                      "y2":  2084
                  }
