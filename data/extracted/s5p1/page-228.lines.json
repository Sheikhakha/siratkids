{
    "lines":  [
                  {
                      "y":  207,
                      "x":  1478,
                      "text":  "نشاط",
                      "y2":  207
                  },
                  {
                      "y":  252,
                      "x":  418,
                      "text":  ". السابق الحديث من الصلاة في الإمامة مكانة أهمية",
                      "y2":  287
                  },
                  {
                      "y":  515,
                      "x":  1104,
                      "text":  "الإمامة أحكام من",
                      "y2":  533
                  },
                  {
                      "y":  656,
                      "x":  681,
                      "text":  "فـلا الفاتخة، قراءة يحسن أن الإمام: صفات أهم من",
                      "y2":  666
                  },
                  {
                      "y":  658,
                      "x":  250,
                      "text":  "لا من الناس يؤم أن يصح",
                      "y2":  665
                  },
                  {
                      "y":  753,
                      "x":  1205,
                      "text":  ". الفاتحة قراءة يحسن",
                      "y2":  789
                  },
                  {
                      "y":  841,
                      "x":  266,
                      "text":  "أما الصلاة، إعادة عليه",
                      "y2":  855
                  },
                  {
                      "y":  845,
                      "x":  648,
                      "text":  "وجب محدثا، كان أنه تذكر ثم بالناس، الإمام صلى إذا",
                      "y2":  858
                  },
                  {
                      "y":  933,
                      "x":  1074,
                      "text":  "صحيحة. فصلاتهم المامومون",
                      "y2":  949
                  },
                  {
                      "y":  1080,
                      "x":  1478,
                      "text":  "نشاط",
                      "y2":  1080
                  },
                  {
                      "y":  1145,
                      "x":  274,
                      "text":  "يكن لم أنه تذكر الصلاة وبعد الظهر، صلاة ماموما عبدالعزيز صلى",
                      "y2":  1177
                  },
                  {
                      "y":  1272,
                      "x":  1026,
                      "text":  "يفعل؟ فماذا طهارة، على",
                      "y2":  1274
                  },
                  {
                      "y":  1366,
                      "x":  882,
                      "text":  ". الصلاة ويعيد يتطهر",
                      "y2":  1408
                  },
                  {
                      "y":  1370,
                      "x":  457,
                      "text":  ". الصلاة يعيد لا",
                      "y2":  1407
                  },
                  {
                      "y":  1517,
                      "x":  240,
                      "text":  "من اقتداء يصح كما ، النفل صلاة يؤدي بمن الفرض صلاة يؤدي من اقتداء يصح",
                      "y2":  1543
                  },
                  {
                      "y":  1599,
                      "x":  1036,
                      "text":  ". فريضة يصلي بمن نافلة يصلي",
                      "y2":  1644
                  },
                  {
                      "y":  1689,
                      "x":  744,
                      "text":  ": نافلة يؤدي من خلف فريضة يصلي من مثال",
                      "y2":  1717
                  },
                  {
                      "y":  1793,
                      "x":  701,
                      "text":  "العشاء. بنية التراويح صلاة في الإمام مع دخل من",
                      "y2":  1814
                  },
                  {
                      "y":  1869,
                      "x":  731,
                      "text":  ": فريضة يؤدي من خلف نافلة يصلي من مثال",
                      "y2":  1897
                  }
              ],
