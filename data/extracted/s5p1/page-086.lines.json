                      "text":  "الذين مراتب على السنة من الدليل ألام الدرى",
                      "y2":  258
                  },
                  {
                      "y":  488,
                      "x":  1327,
                      "text":  "تمهه",
                      "y2":  488
                  },
                  {
                      "y":  603,
                      "x":  1177,
                      "text":  "الثلاثة؟ الأصول ما",
                      "y2":  614
                  },
                  {
                      "y":  836,
