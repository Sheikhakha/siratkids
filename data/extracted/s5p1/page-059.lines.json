                      "text":  "الاستغاثة",
                      "y2":  244
                  },
                  {
                      "y":  436,
                      "x":  1091,
                      "text":  "الاستغاثة تعريف",
                      "y2":  439
                  },
                  {
                      "y":  552,
                      "x":  849,
                      "text":  "والكرب. الشدة إزالة طلب : هي الاستغاثة",
                      "y2":  584
                  },
                  {
                      "y":  717,
                      "x":  1060,
                      "text":  "تعالى بالله الاستغاثة",
                      "y2":  717
                  },
                  {
                      "y":  848,
                      "x":  670,
                      "text":  "وجل. عز الله من إلا تطلب لا عظيمة عبادة الاستغائة",
                      "y2":  868
                  },
                  {
                      "y":  1025,
                      "x":  1131,
                      "text":  "ي النبي استغاثة",
                      "y2":  1043
                  },
                  {
                      "y":  1139,
                      "x":  211,
                      "text":  "الله فأمده المشركين، كثرة إلى نظر لما بدر غزوة في وعلا جل بربه بيل النبي استغاث",
                      "y2":  1168
                  },
                  {
                      "y":  1216,
                      "x":  220,
                      "text":  "ممدكم أن لكم فأستجاب ربم تستغيثون إد",
                      "y2":  1224
                  },
                  {
                      "y":  1217,
                      "x":  953,
                      "text":  ": تعالى الله قال ، المبين بالنصر سبحانه",
                      "y2":  1248
                  },
                  {
                      "y":  1290,
                      "x":  1056,
                      "text":  "مرد: الملتكة من بألف",
                      "y2":  1293
                  },
                  {
                      "y":  1439,
                      "x":  1090,
                      "text":  "الله بغير الاستغاثة",
                      "y2":  1454
                  },
                  {
                      "y":  1547,
                      "x":  212,
                      "text":  "استغاث ومن تعالى، الله إلا عليه يقدر لا فيما تعالى، الله بغير الاستغاثة",
                      "y2":  1585
                  },
                  {
                      "y":  1563,
                      "x":  1359,
                      "text":  "تجور لا",
                      "y2":  1563
                  },
                  {
                      "y":  1635,
                      "x":  536,
                      "text":  "أشرك. فقد تعالى الله إلا عليه يقدر لا فيما تعالى الله بغير",
                      "y2":  1658
                  },
                  {
                      "y":  1731,
                      "x":  963,
                      "text":  ". بالأموات الاستغاثة مثالذلك:",
                      "y2":  1762
                  },
                  {
                      "y":  1803,
                      "x":  356,
                      "text":  "جائز. فهذا عليه، يقدرون فيما الحاضرين حياء الا بالناس الاستغاثة أما",
                      "y2":  1823
                  },
                  {
                      "y":  1902,
                      "x":  516,
                      "text":  "الحاضرين. الناس من ينقذه بمن الغريق استغاثة ذلك: مثال",
                      "y2":  1921
                  },
                  {
                      "y":  2054,
                      "x":  1127,
                      "text":  "٩. آية: الأنفال، سورة (١)",
                      "y2":  2058
                  },
                  {
                      "y":  2085,
                      "x":  1624,
                      "text":  "٨",
                      "y2":  2085
                  }
