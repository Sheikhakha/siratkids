                      "text":  "الساعد",
                      "y2":  1058
                  },
                  {
                      "y":  168,
                      "x":  509,
                      "text":  ": التالية الصور من الإحرام تكبيرة عند اليدين رفع لصفة الصحيحة الصورة حدد",
                      "y2":  197
                  },
                  {
                      "y":  707,
                      "x":  1183,
                      "text":  "القيام ثانيا:",
                      "y2":  714
                  },
                  {
                      "y":  847,
                      "x":  1282,
                      "text":  "الوضع: صفة",
                      "y2":  851
                  },
                  {
                      "y":  971,
                      "x":  1213,
                      "text":  "ظهر على اليمنى كفه يضع",
                      "y2":  984
                  },
                  {
                      "y":  1041,
                      "x":  1215,
                      "text":  "الزمن وعلى اليسرى كفه",
                      "y2":  1049
                  },
                  {
                      "y":  1108,
                      "x":  1336,
                      "text":  "صدره. على والشاعد",
                      "y2":  1114
                  },
                  {
                      "y":  1303,
                      "x":  1270,
                      "text":  "القبض: صفة",
                      "y2":  1305
                  },
                  {
                      "y":  1418,
                      "x":  1014,
                      "text":  "صدره. على اليمنى بيده اليسرى يده يقبض",
                      "y2":  1426
                  },
                  {
                      "y":  1684,
                      "x":  532,
                      "text":  "وتبارك وبحشدك، اللهم سبحانك يقول: ثم سجوده موضع إلى قيامه في وينظز",
                      "y2":  1709
                  },
                  {
                      "y":  1752,
                      "x":  532,
                      "text":  "الشيطان من بالله أعوذ سرا: يقول ثم غيرك إله ولا جدك، وتعالى اسسك،",
                      "y2":  1768
                  },
                  {
                      "y":  1824,
                      "x":  533,
                      "text":  "بعد يقرا أن ويسن (الفاتحة)، سورة يقرأ ثم الرجيم الرحمن الله بشم الرجيم",
                      "y2":  1835
                  },
                  {
                      "y":  1886,
                      "x":  532,
                      "text":  "إن بالقراءة ويجهز الأوليين الركعتين في الايات بعض أو أخرى، سورة",
                      "y2":  1902
                  },
                  {
                      "y":  1897,
                      "x":  1553,
                      "text":  "الفاتحة",
                      "y2":  1897
                  },
                  {
                      "y":  1946,
                      "x":  531,
                      "text":  "في بها ويسؤ والعشاء. المغرب صلاة من والأوليين الصبح، صلاة في إماما كان",
                      "y2":  1964
                  },
                  {
                      "y":  2009,
                      "x":  533,
                      "text":  "العشاء. صلاة من والأخريين المغرب، صلاة من الثالثة وفي والعصر، الظهر صلاة",
                      "y2":  2028
                  }
              ],
