{
    "lines":  [
                  {
                      "y":  281,
                      "x":  906,
                      "text":  "يزالتؤز بالرسل الإيمان الرابع: الركن",
                      "y2":  300
                  },
                  {
                      "y":  412,
                      "x":  984,
                      "text":  "، طملشكدلا الرسل بجميع نؤمن",
                      "y2":  444
                  },
                  {
                      "y":  481,
                      "x":  616,
                      "text":  ". بوي محمد وخاتمهم شكة، نوح أولهم بان نؤمن",
                      "y2":  525
                  },
                  {
                      "y":  567,
                      "x":  213,
                      "text":  "الله توحيد إلى الناس ودعوا الأمانة، وأدوا الرسالة، بلغوا بانهم نؤمن",
                      "y2":  585
                  },
                  {
                      "y":  658,
                      "x":  1327,
                      "text":  ". تعالى",
                      "y2":  688
                  },
                  {
                      "y":  720,
                      "x":  215,
                      "text":  "الكريم، القرآن في أقوامهم مع قصصهم من به تعالى الله أخبرنا بما نؤمن",
                      "y2":  758
                  },
                  {
                      "y":  806,
                      "x":  578,
                      "text":  "الصحيحة. الاحاديث في يلج الله رسول به أخبر وبما",
                      "y2":  834
                  },
                  {
                      "y":  967,
                      "x":  923,
                      "text":  "الأخر باليوم الإيمان الخامس: الركن",
                      "y2":  976
                  },
                  {
                      "y":  1100,
                      "x":  665,
                      "text":  "مثل: الأدلة، في ثبت مما الموت بعد يكون بما نؤمن",
                      "y2":  1117
                  },
                  {
                      "y":  1190,
                      "x":  1107,
                      "text":  "وعذابه. القبر، نعيم",
                      "y2":  1194
                  },
                  {
                      "y":  1255,
                      "x":  215,
                      "text":  "وآخرهم، أولهم جميعا الخلق تعالى الله",
                      "y2":  1274
                  },
                  {
                      "y":  1262,
                      "x":  884,
                      "text":  "يبعث حيث الموت، بعد البعث",
                      "y2":  1276
                  },
                  {
                      "y":  1354,
                      "x":  777,
                      "text":  "المحشر. أرض إلى قبورهم من فيخرجون",
                      "y2":  1371
                  },
                  {
                      "y":  1422,
                      "x":  1163,
                      "text":  "حيث الحساب،",
                      "y2":  1431
                  },
                  {
                      "y":  1432,
                      "x":  675,
                      "text":  "أعمالهم. على الناس يحاسب",
                      "y2":  1434
                  },
                  {
                      "y":  1501,
                      "x":  763,
                      "text":  "للمتقين. أعدت النعيم، دار وأنها الجنة،",
                      "y2":  1516
                  },
                  {
                      "y":  1579,
                      "x":  465,
                      "text":  ". والمنافقين للكافرين أعدث الأليم، العذاب دار وأنها النار،",
                      "y2":  1597
                  },
                  {
                      "y":  1794,
                      "x":  849,
                      "text":  "وشزه خيره بالقدر الإيمان السادس: الركن",
                      "y2":  1806
                  },
                  {
                      "y":  1927,
                      "x":  392,
                      "text":  "وقدره. الله بقضاء فهو شر أو خير من الكون هذا في شيء كل أن نؤمن",
                      "y2":  1959
                  }
              ],
    "image":  "page-101.png"
}