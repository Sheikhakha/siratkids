                      "text":  "الدرس",
                      "y2":  232
                  },
                  {
                      "y":  263,
                      "x":  371,
                      "text":  "الثانى المريض صلاة",
                      "y2":  276
                  },
                  {
                      "y":  475,
                      "x":  667,
                      "text":  "أو العبد مرض وإذا : تيو الله رسسول",
                      "y2":  503
                  },
                  {
                      "y":  488,
                      "x":  1202,
                      "text":  "قال بكيخ موسى أبي معن",
                      "y2":  507
                  },
                  {
                      "y":  562,
                      "x":  820,
                      "text":  "\". صحيحا»! مقيما يعمل كان ما مثل له كتب سافر",
                      "y2":  581
                  },
                  {
                      "y":  656,
                      "x":  672,
                      "text":  "وسفره، ، مرضه عند المسلم صلاة صفة تختلف قد",
                      "y2":  688
                  },
                  {
                      "y":  753,
                      "x":  669,
                      "text":  "الاوضاع فما بعباده. الله رحمة من وهذا ، أجره ينقص ولا",
                      "y2":  777
                  },
                  {
                      "y":  837,
                      "x":  838,
                      "text":  "صلاته؟ حال المريض عليها يكون أن يجوز التي",
                      "y2":  851
                  },
                  {
                      "y":  991,
                      "x":  1074,
                      "text":  "المريض صلاة صفة",
                      "y2":  991
                  },
                  {
                      "y":  1099,
                      "x":  904,
                      "text":  "حسب الصلاة يؤدي أن المريض على يجب",
                      "y2":  1129
                  },
                  {
                      "y":  1101,
                      "x":  219,
                      "text":  "دام ما الصلاة ترك له يجوز ولا استطاعته،",
                      "y2":  1122
                  },
                  {
                      "y":  1173,
                      "x":  221,
                      "text":  "بالماء، والوضوء القبلة استقبال مثل: عليه، يقدر ما الصلاة شروط من ويفعل صحيحا،",
                      "y2":  1195
                  },
                  {
                      "y":  1262,
                      "x":  221,
                      "text":  "عنه، سقط ذلاك من شيء عن عجز وإذا النجاسات، من والطهارة العجز، عند التيمم أو",
                      "y2":  1292
                  },
                  {
                      "y":  1340,
                      "x":  489,
                      "text":  "ذلك. إلى احتاج إذا الصلاتين بين يجمع أن وله حاله، حسب ويصلي",
                      "y2":  1370
                  },
                  {
                      "y":  1432,
                      "x":  800,
                      "text":  "يلي: كما هي بالتفصيل المريض صلاة صفة بيان و",
                      "y2":  1453
                  },
                  {
                      "y":  1546,
                      "x":  329,
                      "text":  "على يصلي",
                      "y2":  1546
                  },
                  {
                      "y":  1595,
                      "x":  259,
                      "text":  "القبلة إلى ووجهه",
                      "y2":  1604
                  },
                  {
                      "y":  1552,
                      "x":  759,
                      "text":  "وهو يصلي",
                      "y2":  1561
                  },
                  {
                      "y":  1596,
                      "x":  745,
                      "text":  "متربعا جالس",
                      "y2":  1600
                  },
                  {
                      "y":  1554,
                      "x":  1216,
                      "text":  "قائما يصلي",
                      "y2":  1558
                  },
                  {
                      "y":  1607,
                      "x":  1191,
                      "text":  "استطاعته حسب",
                      "y2":  1620
                  },
                  {
                      "y":  1772,
