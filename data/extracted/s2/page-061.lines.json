                  {
                      "y":  233,
                      "x":  449,
                      "text":  "الأول التشهد",
                      "y2":  241
                  },
                  {
                      "y":  223,
                      "x":  1032,
                      "text":  "الدرسن",
                      "y2":  223
                  },
                  {
                      "y":  286,
                      "x":  1037,
                      "text":  "الثامن",
                      "y2":  286
                  },
                  {
                      "y":  439,
                      "x":  548,
                      "text":  "للتشهد تجلس الثانية الركعة بعد",
                      "y2":  446
                  },
                  {
                      "y":  536,
                      "x":  528,
                      "text":  "والأول ثنائية، الصلاة كانت إذا الأخير",
                      "y2":  552
                  },
                  {
                      "y":  634,
                      "x":  616,
                      "text":  "رباعية. أو ثلاثية الصلاة كانت إذا",
                      "y2":  649
                  },
                  {
                      "y":  726,
                      "x":  541,
                      "text":  "الأزض علن اليسرى رجلك وتفرش",
                      "y2":  743
                  },
                  {
                      "y":  819,
                      "x":  535,
                      "text":  "جاعلا اليمنن وتنصب عليها، فتجلس",
                      "y2":  826
                  },
                  {
                      "y":  914,
                      "x":  537,
                      "text":  "علن يديك وتضع القبلة، إلن أصابعها",
                      "y2":  920
                  },
                  {
                      "y":  1010,
                      "x":  868,
                      "text":  "وركبتيك. فخذيك",
                      "y2":  1010
                  },
                  {
                      "y":  1102,
                      "x":  526,
                      "text":  "وتشير والوسطئ، بالإبهام وتحلق",
                      "y2":  1116
                  },
                  {
                      "y":  1200,
                      "x":  597,
                      "text":  "إليها. تنظر وأنت بها تدعو بالسبابة",
                      "y2":  1213
                  },
                  {
                      "y":  1294,
                      "x":  528,
                      "text":  "والصلوات لله، «التحيات وتقول:",
                      "y2":  1310
                  },
                  {
                      "y":  1389,
                      "x":  528,
                      "text":  "النبي أيها عليك السلام والطيبات،",
                      "y2":  1399
                  },
                  {
                      "y":  1488,
                      "x":  526,
                      "text":  "وعلى علينا السلام وبركاته، الله ورحمة",
                      "y2":  1503
                  },
                  {
                      "y":  1579,
                      "x":  520,
                      "text":  "إلا إله لا أن أشهد الصالحين، الله عباد",
                      "y2":  1596
                  },
                  {
                      "y":  1677,
                      "x":  612,
                      "text":  "ورسو عبده محمدا أن وأشهد الله،",
                      "y2":  1683
                  },
                  {
                      "y":  1681,
                      "x":  547,
                      "text":  "له.",
                      "y2":  1681
                  }
              ],
    "image":  "page-061.png"
}