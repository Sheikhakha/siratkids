{
    "lines":  [
                  {
                      "y":  325,
                      "x":  185,
                      "text":  "من الثلائة: الأسئلة درس الأولئ المرحلة في الطفل أن المثال- شبيل علن - فنرى",
                      "y2":  344
                  },
                  {
                      "y":  407,
                      "x":  183,
                      "text":  "الأصول هي الأسئلة هذه أن علم المزحلة هذه في ثم نبيك؟ ومن دينك؟ وما ربك؟",
                      "y2":  435
                  },
                  {
                      "y":  493,
                      "x":  383,
                      "text":  "عليها. الدليل وعلم معرفتها، ومسلمة مسلم كل علن يجب التي الثلاثة",
                      "y2":  506
                  },
                  {
                      "y":  576,
                      "x":  181,
                      "text":  "أن يعلم المرحلة هذه وفي السابقة، المرحلة في التوحيد معنتئ درس قد أنه ونرى",
                      "y2":  594
                  },
                  {
                      "y":  655,
                      "x":  184,
                      "text":  "الدين مراتب ودرس والصفات؛ والأسماء والربوبية، الألوهية، أفسام: ثلاثة التوحيد",
                      "y2":  674
                  },
                  {
                      "y":  740,
                      "x":  512,
                      "text":  "لها. وأمثلة منها كل تعريف يدرس الـمزحلة هذه وفي الثلائة،",
                      "y2":  755
                  },
                  {
                      "y":  819,
                      "x":  185,
                      "text":  "الاجتماع علن كالحت الطفل؛ يحتاجها التي الجديدة الدروس بعفر أضيف وأيقا",
                      "y2":  835
                  },
                  {
                      "y":  906,
                      "x":  182,
                      "text":  "منذ العظيم الأصل هذا علن الطفل فيربن والاختلافي؛ الفرقة عن والبعد والانتلافي",
                      "y2":  916
                  },
                  {
                      "y":  987,
                      "x":  181,
                      "text":  "الأصل هذا غرس بعد عليه وحرص تحقيقه، في سعن وشت كبر فكلما أظفاره، نعومة",
                      "y2":  1005
                  },
                  {
                      "y":  1154,
                      "x":  181,
                      "text":  "أهل عند مشهورة معلومة منهجية علمية طريقة وهي كله، الكثاب في الأمر هكذا",
                      "y2":  1172
                  },
                  {
                      "y":  1233,
                      "x":  193,
                      "text":  "والمنة. الحمد ولله باهرا ظاهرا نجاحا أثبتن وقد الأمور، بهذه والاهتمام الاختصاص",
                      "y2":  1252
                  },
                  {
                      "y":  1320,
                      "x":  181,
                      "text":  "الأرض في القبول لنا ويكتب ويسددنا، يوفقنا أن المجيب القريت الله فنسال",
                      "y2":  1337
                  },
                  {
                      "y":  1403,
                      "x":  190,
                      "text":  "الإسلام عز ويجعل بهم، ينفع وأن المسلمين، وأبناء أبنائنا في يبارك وأن والسماء،",
                      "y2":  1417
                  },
                  {
                      "y":  1485,
                      "x":  1122,
                      "text":  "أيديهم. علن",
                      "y2":  1490
                  },
                  {
                      "y":  1565,
                      "x":  399,
                      "text":  "أجمعين. وأصحابه آله وعلن محمد، نبينا علن وسلم النه وصلن",
                      "y2":  1578
                  }
              ],
    "image":  "page-007.png"
}