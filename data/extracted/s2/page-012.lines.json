                  },
                  {
                      "y":  518,
                      "x":  381,
                      "text":  "المسلمة: الطفله وأينها المسلم الطفل أيها اعلم 7-",
                      "y2":  542
                  },
                  {
                      "y":  624,
                      "x":  244,
                      "text":  "كل على واجب بها والعمل الثلاثة الأصول معرفة أن",
                      "y2":  646
                  },
                  {
                      "y":  730,
                      "x":  243,
                      "text":  "يسأله شيء أول فإن قبره؛ في وضع إذا العبد لأن الناس؛",
                      "y2":  754
                  },
                  {
                      "y":  828,
                      "x":  557,
                      "text":  "الثلاثة. الأصول هذه هو: عنه، الملكان",
                      "y2":  856
                  },
                  {
                      "y":  929,
                      "x":  1051,
                      "text":  "له: لان فيقو",
                      "y2":  933
                  },
                  {
                      "y":  941,
                      "x":  437,
                      "text":  "نبيك؟ ومن دينك؟ وما ربك؟ من",
                      "y2":  950
                  },
                  {
                      "y":  1103,
                      "x":  233,
                      "text":  "وتعلمها، الثلاثة، الأصول بهذه آمن ممن العبد كان فإن",
                      "y2":  1123
                  },
                  {
                      "y":  1203,
                      "x":  243,
                      "text":  "فكان الصحيح، بالجواب أجاب الدنيا؛ حياته في بها وعمل",
                      "y2":  1222
                  },
                  {
                      "y":  1304,
                      "x":  253,
                      "text":  "القيامة. ويوم قبره في والنعيم والسرور الراحة أصحاب من",
                      "y2":  1334
                  },
                  {
                      "y":  1484,
                      "x":  254,
                      "text":  "الدنيا؛ حياته في بها يعمل ولم يعرفها لم ممن كان إن أما",
                      "y2":  1504
                  },
                  {
                      "y":  1579,
                      "x":  257,
                      "text":  "ذلك فيكون الأسئلة، هذه عن يجيب أن يستطيع لن فإنه",
                      "y2":  1593
                  },
                  {
                      "y":  1687,
                      "x":  619,
                      "text":  "القيامة. ويوم قبره في عذابه في سببا",
                      "y2":  1703
                  },
                  {
                      "y":  1836,
                      "x":  683,
                      "text":  "مم.",
