{
    "lines":  [
                  {
                      "y":  278,
                      "x":  501,
                      "text":  "العلماء مع الأدب",
                      "y2":  293
                  },
                  {
                      "y":  478,
                      "x":  243,
                      "text":  "نسألهم وأن نوقرهم، وأن علماءنا، نحترم أن علينا",
                      "y2":  491
                  },
                  {
                      "y":  586,
                      "x":  773,
                      "text":  "ديننا. أمور من نعلمه لا عما",
                      "y2":  599
                  },
                  {
                      "y":  691,
                      "x":  242,
                      "text":  "وأيطيمواألرمول أله أيطيعوا امثوا الذين يتاها عنهجل: الله قال",
                      "y2":  714
                  },
                  {
                      "y":  802,
                      "x":  710,
                      "text":  "٥٩) النساء: ه من: الار وأولي",
                      "y2":  823
                  },
                  {
                      "y":  902,
                      "x":  245,
                      "text":  "ه تغامون لا كثـثم إن الذر آهل فتفلوا تعالى: وقال",
                      "y2":  917
                  },
                  {
                      "y":  1057,
                      "x":  284,
                      "text":  "نست أو نشتم أن لنا يجوز ولا",
                      "y2":  1073
                  },
                  {
                      "y":  1159,
                      "x":  283,
                      "text":  "الشنة أهل علماء من أحد أي",
                      "y2":  1165
                  },
                  {
                      "y":  1269,
                      "x":  281,
                      "text":  "السعادة نحقق لن لأننا والجماعة؛",
                      "y2":  1274
                  },
                  {
                      "y":  1376,
                      "x":  653,
                      "text":  "\" - بطا إلا",
                      "y2":  1381
                  },
                  {
                      "y":  1381,
                      "x":  282,
                      "text":  "يبلغون فيما وتوقيرهم عيهم",
                      "y2":  1398
                  },
                  {
                      "y":  1475,
                      "x":  285,
                      "text":  "البدع أهل وأما ورسوله، الله عن",
                      "y2":  1489
                  },
                  {
                      "y":  1583,
                      "x":  283,
                      "text":  "فليس والأحزاب؛ كالجماعات",
                      "y2":  1591
                  },
                  {
                      "y":  1683,
                      "x":  288,
                      "text":  "الفتن. شيوخ هم وإنما علماء، فيهم",
                      "y2":  1695
                  },
                  {
                      "y":  341,
                      "x":  1290,
                      "text":  ".",
                      "y2":  341
                  },
                  {
                      "y":  561,
                      "x":  1325,
                      "text":  "وا",
                      "y2":  561
                  }
              ],
