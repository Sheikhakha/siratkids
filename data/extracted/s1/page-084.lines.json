{
    "lines":  [
                  {
                      "y":  67,
                      "x":  638,
                      "text":  "المقدمة",
                      "y2":  67
                  },
                  {
                      "y":  429,
                      "x":  299,
                      "text":  "محمد. نبينا بعده نبي لا من علن والسلام والصلاة وحده، لله الحمد",
                      "y2":  442
                  },
                  {
                      "y":  521,
                      "x":  1134,
                      "text":  "بعد: أما",
                      "y2":  523
                  },
                  {
                      "y":  602,
                      "x":  161,
                      "text":  "وبفساده كله، الجسد يصلح فبصلاجه كلها، الجسد أغضاء قائد مو القلت فإن",
                      "y2":  616
                  },
                  {
                      "y":  691,
                      "x":  162,
                      "text":  "القلب لصلاح أن شك ولا محمد، ورشولنا نبينا هذا بين كما كله، الجسد يفشد",
                      "y2":  708
                  },
                  {
                      "y":  785,
                      "x":  901,
                      "text":  "أسبابا. لفساده أن كما أسبابا،",
                      "y2":  793
                  },
                  {
                      "y":  877,
                      "x":  162,
                      "text":  "تسبيح، من خ؛ الله ذكر من الإكثار وسلامته: القلب صلاح أسباب أعظم ومن",
                      "y2":  889
                  },
                  {
                      "y":  964,
                      "x":  163,
                      "text":  "تعالن: قال النبوية، للأحاديث ودراسة للقرآن، وقراءة وتهليل، وتكبير، وتحميد،",
                      "y2":  979
                  },
                  {
                      "y":  1053,
                      "x":  218,
                      "text":  "٢٨). الرعد: القلوب تطـمين الله ينكر الا الله بدر لوبهم وتطمين عاموا لزين",
                      "y2":  1068
                  },
                  {
                      "y":  1140,
                      "x":  163,
                      "text":  "عليها: والمحافظة وفهمها، جفظها، مسلم لكل ينبغي التي الأذكار وأهم أغظم ومن",
                      "y2":  1158
                  },
                  {
                      "y":  1233,
                      "x":  161,
                      "text":  "سنة من وصح العظيم، القرآن في ورد ما حتب -علن حالي أو بوقت المقيدة الأذكار",
                      "y2":  1247
                  },
                  {
                      "y":  1320,
                      "x":  160,
                      "text":  "كثرة في سبب عليها المحافظة فإن والمشاء، الصباح أذكار مثل الكريمف-؛ النبي",
                      "y2":  1337
                  },
                  {
                      "y":  1410,
                      "x":  161,
                      "text":  "سبب أنها كما الخلد، جنة في ودرجات درجات والرفعة السيئات، وتكفير الحسنات،",
                      "y2":  1427
                  },
                  {
                      "y":  1501,
                      "x":  829,
                      "text":  "والمؤذيات. الشرور من الوقاية في",
                      "y2":  1515
                  },
                  {
                      "y":  1586,
                      "x":  162,
                      "text":  "أيها - جفظك في سبب فإنها النوم؛ عند تقال التي الأذكار أيضا: الأذكار تلك ومن",
                      "y2":  1604
                  },
                  {
                      "y":  1676,
                      "x":  162,
                      "text":  "وكذلك سيئاتك، تكفير في وسبب وكوابيسه، ووساوسه الشيطان شر من المشلم-",
                      "y2":  1694
                  },
                  {
                      "y":  1765,
                      "x":  161,
                      "text":  "الواحد لله توحيدك كمال علن يدل الاستيقاظ بعد قوله لك المشروع الذكر -أيضا-",
                      "y2":  1778
                  },
                  {
                      "y":  1856,
                      "x":  1187,
                      "text":  "الأحد.",
                      "y2":  1856
                  }
              ],
    "image":  "page-084.png"
}