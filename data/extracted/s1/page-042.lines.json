{
    "lines":  [
                  {
                      "y":  99,
                      "x":  635,
                      "text":  "المقدمة",
                      "y2":  99
                  },
                  {
                      "y":  396,
                      "x":  311,
                      "text":  "محمد. نبينا بعده نبي لا من علن والسلام والصلاة وحده، لله الحمد",
                      "y2":  409
                  },
                  {
                      "y":  482,
                      "x":  1101,
                      "text":  "بعد: أما",
                      "y2":  484
                  },
                  {
                      "y":  561,
                      "x":  182,
                      "text":  "تتعلق به إذ وأشرفها؛ العظيم الإسلام دين في العلوم أعظم من الدين في الفقه فإن",
                      "y2":  586
                  },
                  {
                      "y":  645,
                      "x":  184,
                      "text":  "الله أمره التي العبادات أداء كيفية المسلم يعرف فبالفقه والجماعة، الفرد أنشطة جميع",
                      "y2":  658
                  },
                  {
                      "y":  727,
                      "x":  183,
                      "text":  "عليها يقوم التي العبادات من وغيرها والحج، والصوم، والزكاة، كالصلاة، بها؛ تعالئ",
                      "y2":  742
                  },
                  {
                      "y":  812,
                      "x":  471,
                      "text":  "الفقه. خلالي من إلا عبادة يقيم أن المرء يستطيع فلا الدين، هذا",
                      "y2":  824
                  },
                  {
                      "y":  895,
                      "x":  182,
                      "text":  "وزوجته، الزوج بين العلاقة فيتظم المسلمين، بين العلاقة يتظم الفقه فإن وكذا",
                      "y2":  907
                  },
                  {
                      "y":  972,
                      "x":  184,
                      "text":  "بين العلاقة ويتظم واجبات، من عليه وما حقوي، من له ما منهما كل حلاله من فيغرف",
                      "y2":  994
                  },
                  {
                      "y":  1058,
                      "x":  181,
                      "text":  "أمور من ها وغير والهبات، والإجارات، كالبيوع، المعاملات؛ مختلف في الأفراد",
                      "y2":  1078
                  },
                  {
                      "y":  1144,
                      "x":  184,
                      "text":  "فيجتنبه، والحرام إنيانه، على ص ويحر فيفعله، الحلال المرء يعرف وبالفقه الحياة،",
                      "y2":  1156
                  },
                  {
                      "y":  1232,
                      "x":  1022,
                      "text":  "تركه. في ويجتهد",
                      "y2":  1242
                  },
                  {
                      "y":  1311,
                      "x":  182,
                      "text":  "جليلة؛ كبيرة والمجتمع الفرد حياة في وأهميئه عظيمة، جخ الله دين في الفقه فمكانه",
                      "y2":  1334
                  },
                  {
                      "y":  1393,
                      "x":  182,
                      "text":  "وأعمارهم، وأفهامهم عقولهم يناسب بما تعلمه على أبناءنا نربي أن علينا",
                      "y2":  1407
                  },
                  {
                      "y":  1399,
                      "x":  1109,
                      "text":  "وجب لدا",
                      "y2":  1407
                  },
                  {
                      "y":  1475,
                      "x":  182,
                      "text":  "ولا مكلفين غير كانوا -وإن تركه علن ويربوا صغرهم، من الحرام فيعرفوا",
                      "y2":  1490
                  },
                  {
                      "y":  1554,
                      "x":  182,
                      "text":  "رشولتا علمنا كما وبغضه، الحرام اجتناب علن منهم الواجد ينشأ لكن محاسبين-؛",
                      "y2":  1570
                  },
                  {
                      "y":  1643,
                      "x":  182,
                      "text":  "فجعلها الصدقة، تمر من تمرة علي بن الحسن أخذ قال: ظلي، هرة أبى فعن",
                      "y2":  1657
                  },
                  {
                      "y":  1720,
                      "x":  182,
                      "text":  "تأكل لا آنا علمت أما بها، ارم كخ، «كخ لاله:",
                      "y2":  1739
                  },
                  {
                      "y":  1731,
                      "x":  960,
                      "text":  "رسو فقال فيه، في",
                      "y2":  1742
                  },
                  {
                      "y":  1810,
                      "x":  884,
                      "text":  "عليه. متفق الصدقة؟!».",
                      "y2":  1812
                  }
              ],
    "image":  "page-042.png"
}