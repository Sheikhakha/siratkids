{
    "lines":  [
                  {
                      "y":  67,
                      "x":  638,
                      "text":  "المقدمة",
                      "y2":  67
                  },
                  {
                      "y":  431,
                      "x":  146,
                      "text":  "ودخولي منه، والخروج البيت ودخولي منه، والخروج المسجد دخولي أذكار وكذلك",
                      "y2":  438
                  },
                  {
                      "y":  511,
                      "x":  146,
                      "text":  "حال أو بوقت المقيدة المشروعة الأذكار من ذلك غير إلى منه، والخروج الخلاء",
                      "y2":  523
                  },
                  {
                      "y":  590,
                      "x":  461,
                      "text":  "والاخرة. الدنيا في جدا كثيرة فوائد لها الأذكار هذه كل معين،",
                      "y2":  605
                  },
                  {
                      "y":  672,
                      "x":  145,
                      "text":  "أنها ومنها: عظيمة، فوائد لها الإسلامية الآداب على المحافظة -أيضا- وكذلك",
                      "y2":  677
                  },
                  {
                      "y":  750,
                      "x":  377,
                      "text":  "رسو ومع ك، الله مع والتأدب وتهذيبه، الخلق، حسن الإنسان تعلم",
                      "y2":  765
                  },
                  {
                      "y":  751,
                      "x":  146,
                      "text":  "الناس ومع ،",
                      "y2":  765
                  },
                  {
                      "y":  828,
                      "x":  409,
                      "text":  "والاخرة. الدنيا في وفاجه العبد سعادة أسباب من وهي أجمعين،",
                      "y2":  846
                  },
                  {
                      "y":  912,
                      "x":  145,
                      "text":  "السامية؛ الدرجة ويلك العالية، المنزلة بهذه الإسلامية والآداب الأذكار كانت فلما",
                      "y2":  924
                  },
                  {
                      "y":  992,
                      "x":  145,
                      "text":  "وفوائدها فضائلها وتجلية للمسلمين، والآداب الأذكار تلك إظهار منه: بد لا مما كان",
                      "y2":  1002
                  },
                  {
                      "y":  1074,
                      "x":  1109,
                      "text":  "للموحدين.",
                      "y2":  1074
                  },
                  {
                      "y":  1150,
                      "x":  145,
                      "text":  "والآداب؛ الأذكار هذه أمثال تعليمهم علن الحرص ينبغي من أولن من والأطفال",
                      "y2":  1163
                  },
                  {
                      "y":  1231,
                      "x":  144,
                      "text":  "هذه على المحافظة على يكبروا أن أجل ومن بالخير، مبتدأة حياتهم تكون أن أجل من",
                      "y2":  1241
                  },
                  {
                      "y":  1313,
                      "x":  658,
                      "text":  "الرفيعة. الآداب بتلك والقيام العظيمة، الأذكار",
                      "y2":  1320
                  },
                  {
                      "y":  1390,
                      "x":  145,
                      "text":  "البابين هذين في للأطفال الأساسية المراجل من الأولن المرحلة هي وهذه",
                      "y2":  1416
                  },
                  {
                      "y":  1471,
                      "x":  145,
                      "text":  "للأطفال»، والشنة التوحيد «منهاج سليلة: من الشرعية» والآداب «الأذكار الشريفين",
                      "y2":  1481
                  },
                  {
                      "y":  1547,
                      "x":  145,
                      "text":  "تكون وأن أجمعين، المسلمين بها ينفع أن الله وأسأل وبنات-، بنين - لأطفالنا أقدمها",
                      "y2":  1566
                  },
                  {
                      "y":  1630,
                      "x":  143,
                      "text":  "خالصة يجعلها وأن أجمع، العالم أقطار كل في المسلمين لأطفال ونبراسا منهاجا",
                      "y2":  1648
                  },
                  {
                      "y":  1714,
                      "x":  1066,
                      "text":  "الكريم. لوجهه",
                      "y2":  1721
                  },
                  {
                      "y":  1790,
                      "x":  149,
                      "text":  "أجمعين. والصحب الآلي وعلى والآخرين، الأولين سيد علن وبارك وسلم الله وصلئ",
                      "y2":  1803
                  },
