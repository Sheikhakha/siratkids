{
    "lines":  [
                  {
                      "y":  87,
                      "x":  613,
                      "text":  "المقدمة",
                      "y2":  87
                  },
                  {
                      "y":  410,
                      "x":  195,
                      "text":  "سيثات ومن أنفينا",
                      "y2":  422
                  },
                  {
                      "y":  412,
                      "x":  431,
                      "text":  "شرور من بالله ونعوذ ونستغفره، ونستعينه نحمده، لله الحمد إن",
                      "y2":  426
                  },
                  {
                      "y":  491,
                      "x":  188,
                      "text":  "الته إلا إله آلا وأشهد له، هادي فلا يضلل ومن له، مضل فلا الله يهده من أعمالنا،",
                      "y2":  506
                  },
                  {
                      "y":  575,
                      "x":  593,
                      "text":  "ورسو عبده محمدا أن وأشهد له، شريك لا وحده",
                      "y2":  590
                  },
                  {
                      "y":  576,
                      "x":  500,
                      "text":  "ه. له",
                      "y2":  581
                  },
                  {
                      "y":  660,
                      "x":  1110,
                      "text":  "بعد: أما",
                      "y2":  662
                  },
                  {
                      "y":  738,
                      "x":  193,
                      "text":  "الأمور وشر محمد، هذي الهذي وخير الله، كتاب الحديث أصدق فإن",
                      "y2":  754
                  },
                  {
                      "y":  823,
                      "x":  288,
                      "text":  "النار. في ضلالة وكل ضلالة، بدعة وكل بدعة، محدثة وكل محدثاتها،",
                      "y2":  841
                  },
                  {
                      "y":  910,
                      "x":  1111,
                      "text":  "بعد: أما",
                      "y2":  912
                  },
                  {
                      "y":  987,
                      "x":  191,
                      "text":  "بأكملها؛ أمة أمل هم بل فحسب، وأمهاتهم آبائهم أمل ليشوا الصغار الأطفال فإت",
                      "y2":  1000
                  },
                  {
                      "y":  1069,
                      "x":  192,
                      "text":  "ومجد سليب عز صاحبة أمة مقتلها، تبلغ كادت إصابة أعداؤها أصابها جريحة أمة",
                      "y2":  1088
                  },
                  {
                      "y":  1153,
                      "x":  194,
                      "text":  "ولا عز، من منها نغصب وما مجد، من منها اسئلت ما استرداد في الأمة تلك تأمل تليد،",
                      "y2":  1174
                  },
                  {
                      "y":  1238,
                      "x":  197,
                      "text":  "الذي الأول الجيل عليه تربن ما على تربن جيل أيدي علن إلا يكون ولن هذا يكون",
                      "y2":  1255
                  },
                  {
                      "y":  1318,
                      "x":  194,
                      "text":  "أشيه علن المجد ذلك إقامة في سببا وكان العز، هذا يديه على تك الله جعل",
                      "y2":  1337
                  },
                  {
                      "y":  1404,
                      "x":  449,
                      "text":  "أولها». أمر عليه صلح بما إلا الأمة هذه آخر يصلح فالن وسوقه،",
                      "y2":  1419
                  },
                  {
                      "y":  1488,
                      "x":  194,
                      "text":  "المفقود العز ذلك وتحصيل المنشود، الأمل هذا تحقيق أراد من كل على وجت يذا",
                      "y2":  1502
                  },
                  {
                      "y":  1571,
                      "x":  192,
                      "text":  "علما السالفون عليه كان بما والتمشك الأولون، عليه كان ما إلن الرجوع في يسعن د",
                      "y2":  1593
                  },
                  {
                      "y":  1653,
                      "x":  193,
                      "text":  "هذا على خطوة أيديكم بين التي المناهج تلك فكانت واعتقادا؛ وتنشأة وتربية وعملا",
                      "y2":  1666
                  },
                  {
                      "y":  1738,
                      "x":  191,
                      "text":  "في والروضات، الحضانات في الصغار الأطفال عليها يربن مناهج المبارك، الشبيل",
                      "y2":  1754
                  },
                  {
                      "y":  1823,
                      "x":  326,
                      "text":  "النظامية. المدارس وفي بل الصيفية؛ الدورات في التحفيظ، ودور الكتاتيب",
                      "y2":  1836
                  }
              ],
    "image":  "page-006.png"
