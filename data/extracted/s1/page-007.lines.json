                  },
                  {
                      "y":  375,
                      "x":  198,
                      "text":  "أدائها، وكيفية العبادات ويعرف معتقده، صحيح الطفل فيها يتعلم المناهج هذه",
                      "y2":  389
                  },
                  {
                      "y":  456,
                      "x":  198,
                      "text":  "الدين وآداب الإسلامية، الأخلاق علن ويتشا يعود ش، الشه بذكر التحضن علن يربن",
                      "y2":  477
                  },
                  {
                      "y":  547,
                      "x":  197,
                      "text":  "سلفه وسير يكبر وقلبه، روحه تخالط عينيه بين النبوية السيرة وأحداث ينمو السامية،",
                      "y2":  559
                  },
                  {
                      "y":  636,
                      "x":  588,
                      "text":  "يحتذئ. ومثلا قدوة له صاروا وقد عقله في الصالجين",
                      "y2":  649
                  },
                  {
                      "y":  717,
                      "x":  199,
                      "text":  "البيان، وسيدة القرآن لغة جعلها بأن يتخ الله شرفها التي الجميلة لغته الطفل يعرف",
                      "y2":  730
                  },
                  {
                      "y":  805,
                      "x":  197,
                      "text":  "شبهة ولا مشوه، تشويه عليه يروج فلا عظمته، ويدرك دينه، حقيقة يعرف وهو يشب",
                      "y2":  827
                  },
                  {
                      "y":  892,
                      "x":  193,
                      "text":  "بغيره يرضن فا وشرايينه، عروقه في الدين هذا محبة تجري هون، صاحب أو عدو",
                      "y2":  908
                  },
                  {
                      "y":  980,
                      "x":  776,
                      "text":  "نجاة. ولا مخلصا سواه فيما ولا بديلا،",
                      "y2":  993
                  },
                  {
                      "y":  1063,
                      "x":  192,
                      "text":  "سن من للأطفال معدة والشنة»- التوحيد «منهاج سلسلة: -وهي المناهج وهذه",
                      "y2":  1075
                  },
                  {
                      "y":  1144,
                      "x":  192,
                      "text":  "تمهيدية، مراحل بثلاث تبدا متدرجة، مراجل هينة علن أثبر، هو ما إلن سنوات الثلاث",
                      "y2":  1163
                  },
                  {
                      "y":  1230,
                      "x":  195,
                      "text":  "هي: مواد؛ ثلاث وتضم الأولئ، الأساسية المرحلة هي وهذه أساسية،",
                      "y2":  1259
                  },
                  {
                      "y":  1243,
                      "x":  1189,
                      "text":  "ثم",
                      "y2":  1243
                  },
                  {
                      "y":  1321,
                      "x":  193,
                      "text":  "سنوات، ست من أكثر للأطفال الإسلامية» والآداب والأذكار والفقه، «التوحيد،",
                      "y2":  1330
                  },
                  {
                      "y":  1401,
                      "x":  192,
                      "text":  "وتوحيد الثلاثة، كالأصول والعملية؛ العقدية الدين هذا أصول ين شيئا الطفل فبها يذرس",
                      "y2":  1420
                  },
                  {
                      "y":  1492,
                      "x":  192,
                      "text":  "من يسيرا وشيئا وأركانه، وتعريفة الإسلام وكذا العبادة، توحيد من يستلزمه وما الربوبية",
                      "y2":  1506
                  },
                  {
                      "y":  1576,
                      "x":  194,
                      "text":  "والصلاة. الوضوء وصفة وآدابها، الطهارة ويتعلم وصفاته، وأخلاقه، النبيه، سيرة",
                      "y2":  1593
                  },
                  {
                      "y":  1663,
                      "x":  230,
                      "text":  "في الهامة الإسلامية الآداب من جملة المرحلة هذه في -كذلك- الطفل ويدرس",
