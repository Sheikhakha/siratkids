                      "text":  "الجمعة: صلاة خطبتا",
                      "y2":  306
                  },
                  {
                      "y":  425,
                      "x":  346,
                      "text":  "يلي: ما على تشتملان خطبتان، يسبقها أن الجمعة صحة شروط من",
                      "y2":  455
                  },
                  {
                      "y":  565,
                      "x":  207,
                      "text":  ". الكرم القرآن من شيء قراءة ٢",
                      "y2":  613
                  },
                  {
                      "y":  792,
                      "x":  223,
                      "text":  "تعالى الله بتقوى والوصية الموعظة ٤",
                      "y2":  827
                  },
                  {
                      "y":  1044,
                      "x":  328,
                      "text":  "كاته وبر الله ورحمة عليكم السلام",
                      "y2":  1049
                  },
                  {
                      "y":  562,
                      "x":  1128,
                      "text":  ". تعالى الله حمد",
                      "y2":  619
                  },
                  {
                      "y":  799,
                      "x":  1019,
                      "text":  "بكلا. النبي على الصلاة",
                      "y2":  824
                  },
                  {
                      "y":  998,
                      "x":  1124,
                      "text":  "للخطيب: يسن ما",
                      "y2":  1018
                  },
                  {
                      "y":  1202,
                      "x":  779,
                      "text":  "المن. صعد إذا الناس على يسلم أن ١",
                      "y2":  1215
                  },
                  {
                      "y":  1353,
                      "x":  893,
                      "text":  "خفيفة. بجلسة الخطبتين بين يفصل أن ٢",
                      "y2":  1378
                  },
                  {
                      "y":  1495,
                      "x":  1090,
                      "text":  ". للمسلمين يدعو أن ٣",
                      "y2":  1556
                  },
                  {
                      "y":  1652,
                      "x":  1024,
                      "text":  "م الخطبتين. يقصر أن ؛",
                      "y2":  1710
                  },
                  {
                      "y":  1801,
                      "x":  548,
                      "text":  "والسلمين.. الإسلام أعز اله",
                      "y2":  1817
                  },
                  {
                      "y":  1919,
                      "x":  234,
                      "text":  "على الإذاعة في ألقيها ثم الوحدة هذه في درسته ما مراعاة مع للجمعة خطبة أكتب",
                      "y2":  1954
                  },
                  {
                      "y":  2031,
