                  },
                  {
                      "y":  213,
                      "x":  1309,
                      "text":  ". الث ة",
                      "y2":  259
                  },
                  {
                      "y":  302,
                      "x":  683,
                      "text":  "الصوم أحكام",
                      "y2":  320
                  },
                  {
                      "y":  511,
                      "x":  1445,
                      "text":  "ي",
                      "y2":  511
                  },
                  {
                      "y":  530,
                      "x":  821,
                      "text":  "رمضان في الفطر لهم يباح من",
                      "y2":  545
                  },
                  {
                      "y":  685,
                      "x":  243,
                      "text":  "الهـدئ من وبينتت للتاي هدى القـرءان فيـه أنزل الذ رمضان شهر : تعالى الله قال",
                      "y2":  698
                  },
                  {
                      "y":  755,
                      "x":  243,
                      "text":  "أمتكاو ين فعـذة سفر علن أو مريضا كان ومن فليصمه المتهر منكم شهـد فمن والفرقـان",
                      "y2":  772
                  },
                  {
                      "y":  829,
                      "x":  240,
                      "text":  "ما ع ألله ولتكيروا أأمدة ولثكملوا ألمسر بكم يريد ولا اليسر بكم ألنه يرييد أخر",
                      "y2":  839
                  },
                  {
                      "y":  896,
                      "x":  1057,
                      "text":  "وا تشكرون ولملكم هدتك:",
                      "y2":  907
                  },
                  {
                      "y":  1006,
                      "x":  327,
                      "text":  ". هما ، الناس من لصنفين رمضان في الفطر جواز على الكريمة الآية هذه دلت",
                      "y2":  1056
                  },
                  {
                      "y":  1185,
                      "x":  734,
                      "text":  ". عليهما القضاء وجوب على الكريمة الآية دلت كما",
                      "y2":  1230
                  },
                  {
                      "y":  1287,
                      "x":  735,
                      "text":  ": الكريمة الآية من ذلك على يدل الذي الموضع استخرج",
                      "y2":  1308
                  },
                  {
                      "y":  1507,
                      "x":  550,
                      "text":  ": مثل مستمرا عجزا الصيام عن للعاجز أيضاـ - رمضان في الفطر ويجوز",
                      "y2":  1535
                  },
                  {
                      "y":  1593,
                      "x":  970,
                      "text":  ". الصيام عن العاجز السن كبير -",
                      "y2":  1631
                  },
                  {
                      "y":  1674,
                      "x":  876,
                      "text":  ". منه شفاؤه يرجى لا مرضا والمريض",
                      "y2":  1714
                  },
                  {
                      "y":  1766,
                      "x":  683,
                      "text":  "وسعها نفساإلا الله يكلف لا : تعالى قوله الدليل و",
                      "y2":  1797
                  },
                  {
                      "y":  1845,
                      "x":  700,
                      "text":  ". مسكينا يوم كل عن الصيام بدل يطعم أن عليه يجب لكن",
                      "y2":  1892
                  },
                  {
                      "y":  1994,
                      "x":  1370,
                      "text":  ". الاية١٥ البقرة سورة (١)",
                      "y2":  2010
                  },
                  {
