                  },
                  {
                      "y":  248,
                      "x":  264,
                      "text":  ":لأوتعاونوا تعالى الله قال والإصلاح، الخير على وإعانتهم والتقوى البر على معهم التعاون ى",
                      "y2":  280
                  },
                  {
                      "y":  329,
                      "x":  942,
                      "text":  "مه٥و وه رر ه",
                      "y2":  336
                  },
                  {
                      "y":  333,
                      "x":  825,
                      "text":  "٠). ها والعدري الإثم على نماونوا ولا والكقوى الير عل",
                      "y2":  342
                  },
                  {
                      "y":  418,
                      "x":  742,
                      "text":  ". والإصلاح والصلاح والسداد بالتوفيق لهم الدعاء ى)",
                      "y2":  450
                  },
                  {
                      "y":  499,
                      "x":  256,
                      "text":  "ووقوع الفتنة وحدوث والتنازع الفرقة من ذلك في لما عليهم؛ الخروج تحريم",
                      "y2":  518
                  },
                  {
                      "y":  573,
                      "x":  1057,
                      "text":  "كثيرة. وشرور عظيمة مفاسد",
                      "y2":  579
                  },
                  {
                      "y":  649,
                      "x":  837,
                      "text":  "معهم. الشرعية عياد والا والجمع الحج إقامة (S)",
                      "y2":  669
                  },
                  {
                      "y":  897,
                      "x":  295,
                      "text":  "إذ علتكم الله يعمت روا واذ تفـرقوا ولا جميعا الله عبل وغتصموا",
                      "y2":  908
                  },
                  {
                      "y":  904,
                      "x":  1296,
                      "text":  "تعالى: الله قال",
                      "y2":  906
                  },
                  {
                      "y":  972,
                      "x":  745,
                      "text":  "ها) إهوا بنعمتد فأصبحتم قلومكة بين فألف أعداه كن",
                      "y2":  981
                  },
                  {
                      "y":  976,
                      "x":  300,
                      "text":  ": الآية من فوائد ثلاث استنبط",
                      "y2":  1000
                  },
                  {
                      "y":  1409,
                      "x":  775,
                      "text":  "والمشورة الرأي وأهل المسلمين علماء حقوق",
                      "y2":  1417
                  },
                  {
                      "y":  1510,
                      "x":  429,
                      "text":  "أهمها: من حقوقا والمشورة الرأي وأهل المسلمين علماء تجاه علينا",
                      "y2":  1544
                  },
                  {
                      "y":  1606,
                      "x":  1031,
                      "text":  ". واحترامهم وتوقيرهم محبتهم",
                      "y2":  1633
                  },
                  {
                      "y":  1679,
                      "x":  676,
                      "text":  ". الدين أمور في أشكل عما وسؤالهم عنهم العلم أخذ ى",
                      "y2":  1714
                  },
                  {
                      "y":  1760,
                      "x":  786,
                      "text":  "وتنقصهم. وسبهم أعراضهم في الكلام",
                      "y2":  1782
                  },
                  {
