                      "text":  "همل",
                      "y2":  1538
                  },
                  {
                      "y":  1609,
                      "x":  624,
                      "text":  "الأرل لباب",
                      "y2":  1611
                  },
                  {
                      "y":  1359,
                      "x":  980,
                      "text":  "فريض ستار جبل",
                      "y2":  1360
                  },
                  {
                      "y":  1523,
                      "x":  965,
                      "text":  "محرم وأدي ميقات",
                      "y2":  1530
                  },
                  {
                      "y":  1538,
                      "x":  781,
                      "text":  "الحصن و غارض حمل",
                      "y2":  1539
                  },
                  {
                      "y":  2057,
                      "x":  111,
                      "text":  "٥3",
                      "y2":  2057
                  },
                  {
                      "y":  1724,
                      "x":  732,
                      "text":  "بالمواقيت المتعلقة الأحكام بعض",
                      "y2":  1746
                  },
                  {
                      "y":  1869,
                      "x":  556,
                      "text":  "إحرام. غير من الميقات يتجاوز أن العمرة أو الحج أراد لمن يجوز لا",
                      "y2":  1882
                  },
                  {
                      "y":  1957,
                      "x":  234,
                      "text":  "إذا يحرم فإنه جوا؛ أو بحرا أو برا كورة؛ المذ المواقيت بأحد يمر لا مكة إلى طريقه كان من",
                      "y2":  1975
                  },
                  {
                      "y":  2056,
