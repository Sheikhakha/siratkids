{
    "lines":  [
                  {
                      "y":  178,
                      "x":  744,
                      "text":  "حسب إحرامه فمكان ، السابقة المواقيت دون كان من",
                      "y2":  211
                  },
                  {
                      "y":  192,
                      "x":  277,
                      "text":  ": التالي الجدول في التفصيل",
                      "y2":  207
                  },
                  {
                      "y":  415,
                      "x":  230,
                      "text":  "التنعيم في ة عائشة مسجد",
                      "y2":  422
                  },
                  {
                      "y":  303,
                      "x":  637,
                      "text":  "ميقاتهم",
                      "y2":  303
                  },
                  {
                      "y":  411,
                      "x":  755,
                      "text":  "مكة. من يحرمون لحج:",
                      "y2":  416
                  },
                  {
                      "y":  505,
                      "x":  631,
                      "text":  "خارج مكان أي من يحرمون : لعمرة",
                      "y2":  526
                  },
                  {
                      "y":  606,
                      "x":  631,
                      "text":  "غيرهما. أو عرفات أو كالتنعيم، الحرم؛ حدود",
                      "y2":  613
                  },
                  {
                      "y":  696,
                      "x":  267,
                      "text":  "هم التي القرية أو البلد يتجاوزون ولا فيه، هم الذي البلد من يحرمون",
                      "y2":  706
                  },
                  {
                      "y":  785,
                      "x":  623,
                      "text":  "إحرام. غغير من الحج أو العمرة أرادوا إذا فيها",
                      "y2":  793
                  },
                  {
                      "y":  296,
                      "x":  1374,
                      "text":  "البلد أهل",
                      "y2":  301
                  },
                  {
                      "y":  496,
                      "x":  1389,
                      "text":  "مكة أهل",
                      "y2":  508
                  },
                  {
                      "y":  684,
                      "x":  1303,
                      "text":  "الحرم حدود خارج كان من",
                      "y2":  695
                  },
                  {
                      "y":  772,
                      "x":  1273,
                      "text":  "كأهل المواقيت؛ ودون المكى",
                      "y2":  783
                  },
                  {
                      "y":  854,
                      "x":  1351,
                      "text":  "والشرائع، وبحرة جدة",
                      "y2":  868
                  },
                  {
                      "y":  959,
                      "x":  1552,
                      "text":  "وغيرها.",
                      "y2":  959
                  },
                  {
                      "y":  1055,
                      "x":  352,
                      "text":  "الكى اخرم ود",
                      "y2":  1070
                  },
                  {
                      "y":  1149,
                      "x":  466,
                      "text":  "طرق أعلام جبال",
                      "y2":  1151
                  },
                  {
                      "y":  1170,
                      "x":  364,
                      "text":  "ا",
                      "y2":  1170
                  },
                  {
                      "y":  1255,
                      "x":  361,
                      "text":  "الأعشاش أعلا المرير رع",
                      "y2":  1262
                  },
                  {
                      "y":  1503,
                      "x":  440,
                      "text":  "الخشفات جبل",
                      "y2":  1503
                  },
                  {
                      "y":  1158,
                      "x":  871,
                      "text":  "المفطع جبل",
                      "y2":  1159
                  },
                  {
                      "y":  1185,
                      "x":  977,
                      "text":  "المنازل قرن",
                      "y2":  1195
                  },
                  {
                      "y":  1186,
                      "x":  741,
                      "text":  "نعماده جبل",
                      "y2":  1193
                  },
                  {
                      "y":  1258,
                      "x":  1059,
                      "text":  "أ جبل",
                      "y2":  1261
                  },
                  {
                      "y":  1343,
                      "x":  699,
                      "text":  "الحرام المسجد",
                      "y2":  1344
                  },
                  {
                      "y":  1287,
                      "x":  1200,
                      "text":  "الكرم كد شهاية",
                      "y2":  1291
                  },
                  {
                      "y":  1538,
