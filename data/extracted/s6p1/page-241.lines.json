    "lines":  [
                  {
                      "y":  125,
                      "x":  811,
                      "text":  "التطوع صوم - الثامنة الوحدة",
                      "y2":  133
                  },
                  {
                      "y":  269,
                      "x":  1211,
                      "text":  "، جماعى تمرين",
                      "y2":  273
                  },
                  {
                      "y":  389,
                      "x":  221,
                      "text":  "مجموعتك، مع بالتعاون ، وقتها في يؤديها ولا ، الصلاة عن ينام من الصائمين من",
                      "y2":  416
                  },
                  {
                      "y":  463,
                      "x":  848,
                      "text":  ". علاجها ووسائل ، المشكلة هذه أسباب حدد",
                      "y2":  497
                  },
                  {
                      "y":  697,
                      "x":  233,
                      "text":  "مثل ، والأفعال الأقوال من بكة ورسوله الله حرم ما جميع الصائم يجتنب أن",
                      "y2":  731
                  },
                  {
                      "y":  812,
                      "x":  689,
                      "text":  ".....،و ..",
                      "y2":  825
                  },
                  {
                      "y":  812,
                      "x":  929,
                      "text":  ". .",
                      "y2":  825
                  },
                  {
                      "y":  790,
                      "x":  1411,
                      "text":  "و. الكذب،",
                      "y2":  815
                  },
                  {
                      "y":  812,
                      "x":  1191,
                      "text":  ". »",
                      "y2":  825
                  },
                  {
                      "y":  885,
                      "x":  1254,
                      "text":  "فردي تمرين",
                      "y2":  893
                  },
                  {
                      "y":  1038,
                      "x":  307,
                      "text":  "جوارحه وجميع ، وبصره ، سمعه حفظ في المسلم سلوك على الصيام أثر بين",
                      "y2":  1061
                  },
                  {
                      "y":  1296,
                      "x":  1247,
                      "text":  "جماعي تمرين",
                      "y2":  1300
                  },
                  {
                      "y":  1431,
                      "x":  217,
                      "text":  "الموضع في يكون الصائم فإن ، الله إلا عليه يطلع لا ، ربه وبين",
                      "y2":  1464
                  },
                  {
                      "y":  1442,
                      "x":  1210,
                      "text":  "العبد بين عبادة الصوم",
                      "y2":  1449
                  },
                  {
                      "y":  1508,
                      "x":  270,
                      "text":  "يعلم لأنه ؛ يتناوله فلا بالصيام عليه الله حرم ما تناول من متمكنا الناس من الخالى",
                      "y2":  1537
                  },
                  {
                      "y":  1520,
                      "x":  220,
                      "text":  "أن",
                      "y2":  1520
                  },
                  {
                      "y":  1574,
                      "x":  220,
                      "text":  "في ورغبة عقابه من خوفا لله فيتركه ذلك عليه حرم وقد ، خلوته في عليه يطلع ربا له",
                      "y2":  1609
                  },
                  {
                      "y":  1664,
                      "x":  1500,
                      "text":  "ثوابه.",
                      "y2":  1664
                  },
                  {
                      "y":  1720,
                      "x":  218,
                      "text":  "السر في تعالى الله بمراقبة وعلاقتها العبادة هذه أثر بين ، مجموعتك مع بالتعاون",
                      "y2":  1758
                  },
                  {
                      "y":  1815,
                      "x":  1450,
                      "text":  ". والهلن",
                      "y2":  1842
                  }
              ],
