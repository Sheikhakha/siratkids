                      "text":  "الن. ة",
                      "y2":  213
                  },
                  {
                      "y":  226,
                      "x":  351,
                      "text":  "الدرس",
                      "y2":  226
                  },
                  {
                      "y":  278,
                      "x":  689,
                      "text":  "العيدين سنن",
                      "y2":  301
                  },
                  {
                      "y":  342,
                      "x":  361,
                      "text":  "الثالث",
                      "y2":  342
                  },
                  {
                      "y":  530,
                      "x":  443,
                      "text":  "العيد؟ لصلاة الذهاب قبل فعله أسرته وأفراد تمحمد يمكن الذي ما",
                      "y2":  538
                  },
                  {
                      "y":  753,
                      "x":  214,
                      "text":  "هذا في للمسلم ويستحب ، وسرور فرح ويوم ، وشكر عبادة يوم العيد يوم",
                      "y2":  786
                  },
                  {
                      "y":  819,
                      "x":  992,
                      "text":  ": منها المستحبات من عدة اليوم",
                      "y2":  846
                  },
                  {
                      "y":  1501,
                      "x":  250,
                      "text":  "في الصلاة أداء",
                      "y2":  1508
                  },
                  {
                      "y":  1804,
                      "x":  361,
                      "text":  "ت",
                      "y2":  1804
                  },
                  {
                      "y":  1497,
                      "x":  716,
                      "text":  "إلى الخروج",
                      "y2":  1503
                  },
                  {
                      "y":  1571,
                      "x":  768,
                      "text":  "مشيا. المصلى",
                      "y2":  1573
                  },
                  {
                      "y":  1518,
                      "x":  1187,
                      "text":  "لصلاة الخروج قل تمرات أكل",
                      "y2":  1525
                  },
                  {
                      "y":  1566,
                      "x":  1188,
                      "text":  "وترا، ويأكلهن الفطر. عيد",
                      "y2":  1574
                  },
                  {
                      "y":  1615,
                      "x":  1186,
                      "text":  "يأكل فلا الأضحى عيد فى وأما",
                      "y2":  1624
                  },
                  {
                      "y":  1655,
                      "x":  1187,
                      "text":  "المصلى من يرجع حتى شينا",
                      "y2":  1676
                  },
                  {
                      "y":  1701,
                      "x":  1187,
                      "text":  "لم وإن أضحيته. من فياكل",
                      "y2":  1714
                  },
                  {
                      "y":  1759,
                      "x":  1184,
                      "text":  "- شاء إن - أكل أضحية له يكن",
                      "y2":  1780
                  },
                  {
                      "y":  1809,
                      "x":  1389,
                      "text":  "خروجه. قبل",
                      "y2":  1813
                  },
                  {
                      "y":  2006,
                      "x":  522,
                      "text":  "طريق، من المصلى إلى الذهاب",
                      "y2":  2032
                  },
                  {
                      "y":  2073,
                      "x":  608,
                      "text":  "آخر. طريق من والرجوع",
                      "y2":  2084
                  }
              ],
    "image":  "page-169.png"
}