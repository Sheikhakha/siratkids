                  },
                  {
                      "y":  264,
                      "x":  280,
                      "text":  "صدق في الشك أو بتف، الله رسول أخبار أو الكريم القرآن أخبار صدق في الشك @",
                      "y2":  291
                  },
                  {
                      "y":  369,
                      "x":  1317,
                      "text":  "ونبوته. سالته",
                      "y2":  371
                  },
                  {
                      "y":  432,
                      "x":  279,
                      "text":  "يكفرهم لم ومن كفرهم الله لأن معتقدهم، تصحيح أو المشركين كفر في الشك @",
                      "y2":  473
                  },
                  {
                      "y":  519,
                      "x":  1109,
                      "text":  "والسنة. بالقرآن مكذب فهو",
                      "y2":  542
                  },
                  {
                      "y":  600,
                      "x":  489,
                      "text":  "ذلك. ونحو والزنا، الزبا تحريم أو والزكاة، الصلاة فزضية في الشك @",
                      "y2":  630
                  },
                  {
                      "y":  773,
                      "x":  950,
                      "text":  "الله دين عن الإعراض كفر",
                      "y2":  782
                  },
                  {
                      "y":  921,
                      "x":  581,
                      "text":  "به. يعمل ولا يتعلمه فلا الإسلام، دين المرء يترك أن وهو المرادبه،",
                      "y2":  949
                  },
                  {
                      "y":  1133,
                      "x":  1285,
                      "text":  "أمثلته",
                      "y2":  1133
                  },
                  {
                      "y":  1246,
                      "x":  254,
                      "text":  "من حصل كما به، يعمل ولا يتعلمه فلا كله، عنه فيعرض الإسلام دين إلى يدعى من @",
                      "y2":  1285
                  },
                  {
                      "y":  1329,
                      "x":  256,
                      "text":  "تبا لهب: أبو قال بل فاعرضوا، بالله الإيمان إلى بيؤ الله رسول دعاهم حين مكة كفار",
                      "y2":  1368
                  },
                  {
                      "y":  1415,
                      "x":  551,
                      "text":  "ممرشون أنذروا عما كفروا والذين تعالى: الله قال جمعننا؟ الهذا لك",
                      "y2":  1434
                  },
                  {
                      "y":  1505,
                      "x":  258,
                      "text":  "صلاة، لا ظاهرا، واجبا يؤد لم وهو الإيمان يدعي من مثل: الدين؛ عن يعرض أن",
                      "y2":  1535
                  },
                  {
                      "y":  1587,
                      "x":  254,
                      "text":  "أعرض عمن الإيمان نفى تعالى والله ذلك، وغير حجا ولا صياما، ولا زكاة، ولا",
                      "y2":  1607
                  },
                  {
                      "y":  1666,
                      "x":  263,
                      "text":  "تولوا إن والرهو ألقه أطيعوا قلق تعالى: الله قـال عزوجل، الله ديسن عن وتولى",
                      "y2":  1698
                  },
                  {
                      "y":  1758,
                      "x":  1250,
                      "text":  "الكفرة يث ا الله كإن",
