                  },
                  {
                      "y":  1035,
                      "x":  303,
                      "text":  "إلى وافدا ثعلبة بن ضمام بكر بن سعد بنو بعثت قال: فيج عباس بن الله عبد (عن",
                      "y2":  1067
                  },
                  {
                      "y":  1113,
                      "x":  306,
                      "text":  "المسجد دخل ثم عقله، ثم المسجد، باب على بعيره وأناخ عليه فقدم ه، الله رسول",
                      "y2":  1131
                  },
                  {
                      "y":  1182,
                      "x":  1005,
                      "text":  "أصحابه.... في جالس يله الله ورسول",
                      "y2":  1202
                  },
                  {
                      "y":  1198,
                      "x":  303,
                      "text":  "فكان إليه فاجتمعوا قومه على قدم حتى خرج ثم",
                      "y2":  1205
                  },
                  {
                      "y":  1251,
                      "x":  1245,
                      "text":  "قال: أن به تكلم ما أول",
                      "y2":  1278
                  },
                  {
                      "y":  1255,
                      "x":  303,
                      "text":  "اتق والجذام، البرص اتق ضمام، يا مه قالوا: والعرى اللات بئست",
                      "y2":  1271
                  },
                  {
                      "y":  1325,
                      "x":  303,
                      "text":  "وأنزل رسولا بعث قد وجل عز الله إن ينفعان ولا يصران لا والله إنهما ويلكم قال: الجنون،",
                      "y2":  1348
                  },
                  {
                      "y":  1403,
                      "x":  303,
                      "text":  "وأن له شريك لا وحده الله الا إله لا أن أشهد وإني فيه كنتم مما به استنقذكم كتابا عليه",
                      "y2":  1425
                  },
                  {
                      "y":  1474,
                      "x":  306,
                      "text":  "ما فوالله قال: عنه، ونهاكم به أمركم بما عنده من جئتكم قد إني ورسوله عبده محمدا",
                      "y2":  1494
                  },
                  {
                      "y":  1547,
                      "x":  306,
                      "text":  "في: عباس ابن يقول قال: مسلما، إلا امرأة ولا رجل حاضره وفي اليوم ذلك من أمسى",
                      "y2":  1567
                  },
                  {
                      "y":  1619,
                      "x":  800,
                      "text":  "ثعلبة) بن ضمام من أفضل كان قوم بوافد سمعنا فما",
                      "y2":  1638
                  },
                  {
