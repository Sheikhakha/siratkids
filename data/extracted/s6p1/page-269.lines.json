                      "text":  "الحاوسر",
                      "y2":  364
                  },
                  {
                      "y":  285,
                      "x":  711,
                      "text":  "العمرة صفة",
                      "y2":  285
                  },
                  {
                      "y":  209,
                      "x":  1319,
                      "text":  "الت ة",
                      "y2":  209
                  },
                  {
                      "y":  358,
                      "x":  1373,
                      "text":  "وا",
                      "y2":  358
                  },
                  {
                      "y":  506,
                      "x":  322,
                      "text":  "\" بالعمرة الإحرام قبل عمله لك",
                      "y2":  529
                  },
                  {
                      "y":  514,
                      "x":  837,
                      "text":  "يستحب الذي ما ، السابقة دراستك خلال من",
                      "y2":  544
                  },
                  {
                      "y":  719,
                      "x":  372,
                      "text":  "؟ العمرة أعمال في تدخل لكي الميقات في به تقوم الذي الأساس الركن ما",
                      "y2":  738
                  },
                  {
                      "y":  872,
                      "x":  782,
                      "text":  "التالي: النحو على العمرة أعمال في تشرع ذلك بعد",
                      "y2":  880
                  },
                  {
                      "y":  978,
                      "x":  248,
                      "text":  "خلف ركعتين صلاة",
                      "y2":  988
                  },
                  {
                      "y":  986,
                      "x":  702,
                      "text":  "سبعة بالبيت الطواف",
                      "y2":  990
                  },
                  {
                      "y":  990,
                      "x":  1156,
                      "text":  "فيها وتستمر ، التلبية",
                      "y2":  1005
                  },
                  {
                      "y":  1075,
                      "x":  349,
                      "text":  ". المقام",
                      "y2":  1104
                  },
                  {
                      "y":  1052,
                      "x":  673,
                      "text":  "الحجر من ابتدا ، أشواط",
                      "y2":  1077
                  },
                  {
                      "y":  1081,
                      "x":  1139,
                      "text":  ". الطواف في تشرع حتى",
                      "y2":  1108
                  },
                  {
                      "y":  1123,
                      "x":  723,
                      "text":  "به وانتهاء الأسود،",
                      "y2":  1143
                  },
                  {
                      "y":  1520,
                      "x":  320,
                      "text":  "والحلق للنساء، التقصير",
                      "y2":  1533
                  },
                  {
                      "y":  1600,
                      "x":  253,
                      "text":  "أفضل. والحلق للرجال، أوالتقصير",
                      "y2":  1602
                  },
                  {
                      "y":  1530,
                      "x":  944,
                      "text":  "أشواط، سبعة والمروة الصفا بين السعي",
                      "y2":  1544
                  },
                  {
                      "y":  1602,
                      "x":  994,
                      "text":  ". بالمروة وانتهاء ، بالصفا ابتداء",
                      "y2":  1635
                  },
                  {
                      "y":  1979,
                      "x":  1116,
                      "text":  "سرع في تشتغل أن والافضل",
                      "y2":  2018
                  },
                  {
                      "y":  1997,
                      "x":  253,
                      "text":  "والتسبيح ، القرآن كقراءة تعالى، الله بذكر الأعمال هذه",
                      "y2":  2016
                  },
                  {
                      "y":  2066,
                      "x":  1231,
                      "text":  ". والدعاء ، والاستغفار",
                      "y2":  2095
                  }
              ],
