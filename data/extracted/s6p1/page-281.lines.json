                      "text":  "... تت بيته وأهل ج الرسول خقوق السادسة: الوخدة",
                      "y2":  519
                  },
                  {
                      "y":  558,
                      "x":  972,
                      "text":  ".. يج الرسول حقوق عشر: الخامس الدرس",
                      "y2":  592
                  },
                  {
                      "y":  634,
                      "x":  751,
                      "text":  "خقوقزوجاتا عشر: السادس الدرس",
                      "y2":  648
                  },
                  {
                      "y":  709,
                      "x":  861,
                      "text":  "النبي...... بيت أهل خقوق عشر: السابع الدرس",
                      "y2":  723
                  },
                  {
                      "y":  785,
                      "x":  808,
                      "text":  ".......... أجمعين ن الصحابة خقوق السابعة: الوخدة",
                      "y2":  816
                  },
                  {
                      "y":  857,
                      "x":  862,
                      "text":  ". أجمعين يرت، الصحابه خقوق عشر: الثامن الدرس",
                      "y2":  891
                  },
                  {
                      "y":  929,
                      "x":  755,
                      "text":  ". أجمعين الزاشدينن الخلفاء خقوق عشر: التاسع الدرس",
                      "y2":  966
                  },
                  {
                      "y":  1008,
                      "x":  961,
                      "text":  "الأمور........... ولاة خقوق الثامنة: الوخدة",
                      "y2":  1015
                  },
                  {
                      "y":  1083,
                      "x":  1005,
                      "text":  "المسلمين لأثمة الواجب العشرون: الدرس",
                      "y2":  1087
                  },
                  {
                      "y":  1156,
                      "x":  1038,
                      "text":  "........... الأخر اليؤم التاسعة: الوخدة",
                      "y2":  1187
                  },
                  {
                      "y":  1226,
                      "x":  944,
                      "text":  "الأخر باليوم الإيمان والعشزون: الحادي الدرس",
                      "y2":  1236
                  },
                  {
                      "y":  1305,
                      "x":  985,
                      "text":  ". الشاعة علامات والعشرون: الثاني الدرس",
                      "y2":  1337
                  },
                  {
                      "y":  1379,
                      "x":  852,
                      "text":  ". وعذابة ونعيمة القبر فتنة والعشرون: الثالث الدرس",
                      "y2":  1410
                  },
                  {
                      "y":  1452,
                      "x":  948,
                      "text":  ". القيامة يوم أخوال والعشزون: الزابع الدرس",
                      "y2":  1484
                  },
                  {
                      "y":  1523,
                      "x":  1070,
                      "text":  "الشفاعة والعشزون: الخامس الدرس",
                      "y2":  1531
                  },
                  {
                      "y":  1597,
                      "x":  1010,
                      "text":  ". والنار الجنة والعشزون: الشادس الدرس",
