                  },
                  {
                      "y":  401,
                      "x":  316,
                      "text":  "يوم يقضى الناس أول «إن يقول: ه الله رسول سمعت",
                      "y2":  435
                  },
                  {
                      "y":  408,
                      "x":  1187,
                      "text":  "- لله",
                      "y2":  422
                  },
                  {
                      "y":  409,
                      "x":  1143,
                      "text":  "فال: برعيه هريرة أبي عن",
                      "y2":  428
                  },
                  {
                      "y":  467,
                      "x":  315,
                      "text":  "قاتلت قال: فيها: عملت فما قال فعرفها، نعمه فعرفه به فأتي استشهد، رجل عليه القيامة",
                      "y2":  496
                  },
                  {
                      "y":  546,
                      "x":  315,
                      "text":  "به أمر ثم قيل، فقد جريء، يقال لأن قاتلت؛ ولكنك كذبت، قال: استشهدت حتى فيك",
                      "y2":  567
                  },
                  {
                      "y":  605,
                      "x":  315,
                      "text":  "به فأتي القرآن، وقرأ وعلمه، العلم تعلم ورجل النار، في ألقي حتى وجهه على فسحب",
                      "y2":  634
                  },
                  {
                      "y":  674,
                      "x":  317,
                      "text":  "القرآن، فيك وقرأت وعلمته العلم تعلمت قال: فيها: عملت فما قال فعرفها، نعمه فعرفه",
                      "y2":  698
                  },
                  {
                      "y":  753,
                      "x":  317,
                      "text":  "، قيل فقد قارئ، هو ليقال: القرآن وقرأت عالم، ليقال: العلم تعلمت ولكنك كذبت، قال:",
                      "y2":  781
                  },
                  {
                      "y":  814,
                      "x":  315,
                      "text":  "أصناف من وأعطاه عليه الله وشع ورجل النار، في ألقي حتى وجهه على فحب به أمر ثم",
                      "y2":  842
                  },
                  {
                      "y":  883,
                      "x":  315,
                      "text":  "تحب سبيل من تركت ما قال فيها: عملت فما قال فعرفها، نعمه فعرفه به فأتي كله، المال،",
                      "y2":  911
                  },
                  {
                      "y":  959,
                      "x":  316,
                      "text":  "ثم قيل، فقد جواد هو ليقال: فعلت ولكنك كذبت، قال: لك، فيها أنفقت إلا فيها ينفق أن",
                      "y2":  980
                  },
                  {
                      "y":  1021,
                      "x":  944,
                      "text":  "الناره في ألقي ثم وجهه، على فسحب به أمر",
                      "y2":  1046
                  },
                  {
                      "y":  1279,
                      "x":  1140,
                      "text":  "ب",
                      "y2":  1279
                  },
                  {
                      "y":  1422,
                      "x":  1062,
                      "text":  "الأصغز. الشرك عزف",
                      "y2":  1435
                  },
                  {
                      "y":  1532,
                      "x":  770,
                      "text":  "بالفعل. وآخز ، باللفظ أصغر لشرك مثل",
                      "y2":  1564
                  },
                  {
                      "y":  1645,
