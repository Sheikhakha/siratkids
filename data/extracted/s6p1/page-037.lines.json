{
    "lines":  [
                  {
                      "y":  286,
                      "x":  870,
                      "text":  "والضفات الأسماء في الشرك على الدليل",
                      "y2":  294
                  },
                  {
                      "y":  393,
                      "x":  213,
                      "text":  "القه أنزل ما اباؤكم رء أنشم معيـتموها سحاة دوندهإللا ين ماتتبدوت : تعالى الله قول",
                      "y2":  428
                  },
                  {
                      "y":  480,
                      "x":  558,
                      "text":  "» القيم اليي ذليق إياه نكبدواإلا ألا آمر ينه إلا الحكم إن شلطـن ين يها",
                      "y2":  492
                  },
                  {
                      "y":  604,
                      "x":  1214,
                      "text":  "نتثتلاظ",
                      "y2":  604
                  },
                  {
                      "y":  758,
                      "x":  632,
                      "text":  ": التالي الجدول حسب الصحيح مكانها في الأمثلة ضع",
                      "y2":  781
                  },
                  {
                      "y":  879,
                      "x":  1157,
                      "text":  "المثال",
                      "y2":  879
                  },
                  {
                      "y":  957,
                      "x":  1069,
                      "text":  "وصفاته الله أسماء ينكر من",
                      "y2":  974
                  },
                  {
                      "y":  1054,
                      "x":  914,
                      "text":  "الكون يصرف من الله مع أن يعتقد",
                      "y2":  1089
                  },
                  {
                      "y":  1169,
                      "x":  1041,
                      "text":  "والأضرحة القبور أصحاب دعاء",
                      "y2":  1176
                  },
                  {
                      "y":  1332,
                      "x":  1107,
                      "text":  ". ؟ نتتتظ",
                      "y2":  1332
                  },
                  {
                      "y":  1497,
                      "x":  258,
                      "text":  "فأصابهم البحر يشلمـفركب أن قبل ـ مزيؤة عكرمة هرب مكة بي النبي فتح حين",
                      "y2":  1541
                  },
                  {
                      "y":  1580,
                      "x":  258,
                      "text":  "شيئا ههنا عنكم تغني لا آلهتكم فإن أخلصوا السفينة: أصحاب فقال عاصف،",
                      "y2":  1599
                  },
                  {
                      "y":  1658,
                      "x":  254,
                      "text":  "البر في ينجيني لا الإخلاص إلا البحر في ينجني لم لتن والله : ميهة عكرمة فقان",
                      "y2":  1695
                  },
                  {
                      "y":  1752,
                      "x":  258,
                      "text":  "يدي أضع حتى محمدا آتي أن فيه أنا مما عافيتني إن عهدا علي لك إن اللهم غيره،",
                      "y2":  1779
                  },
                  {
                      "y":  1836,
                      "x":  662,
                      "text":  "\"\") فا فجاء : قال كريما، عفوا إلا أجده فلا يده في",
                      "y2":  1861
                  },
                  {
                      "y":  2009,
                      "x":  1158,
                      "text":  "،؛. آية بوسف سورة ١)",
                      "y2":  2012
                  },
