                      "text":  "الدرس",
                      "y2":  203
                  },
                  {
                      "y":  312,
                      "x":  301,
                      "text":  "الثالث",
                      "y2":  312
                  },
                  {
                      "y":  270,
                      "x":  801,
                      "text":  "الإحرام",
                      "y2":  270
                  },
                  {
                      "y":  329,
                      "x":  1379,
                      "text":  "وأ",
                      "y2":  329
                  },
                  {
                      "y":  473,
                      "x":  417,
                      "text":  "؟ تفهمه الذي الإحرام ما ، العمرة أو بالحج المحرمين تشاهد ما كثيرا",
                      "y2":  503
                  },
                  {
                      "y":  1028,
                      "x":  232,
                      "text":  "متفقة فنختوننربسصم",
                      "y2":  1028
                  },
                  {
                      "y":  694,
                      "x":  913,
                      "text":  ". الآتي بالتعريف إليه توصلت ما قارن",
                      "y2":  740
                  },
                  {
                      "y":  789,
                      "x":  828,
                      "text":  ". العمرة أو الحج نسك في الدخول نية : الإحرام",
                      "y2":  836
                  },
                  {
                      "y":  920,
                      "x":  1097,
                      "text":  "الإحرام حكم",
                      "y2":  932
                  },
                  {
                      "y":  1048,
                      "x":  788,
                      "text":  "يكون ولا ، والعمرة الحج أركان من ركن الإحرام",
                      "y2":  1080
                  },
                  {
                      "y":  1117,
                      "x":  637,
                      "text":  "يريده. الذي النسك في الدخول نوى إذا إلا محرما الإتسان",
                      "y2":  1145
                  },
                  {
                      "y":  1403,
                      "x":  494,
                      "text":  ". الإحرام قبل الاغتسال",
                      "y2":  1447
                  },
                  {
                      "y":  1827,
                      "x":  162,
                      "text":  "الطيب. أنواع من يتيسر بما بدنه في الرجل تطيب",
                      "y2":  1847
                  },
                  {
                      "y":  1977,
                      "x":  201,
                      "text":  "نافلة. أو كانتث فريضة ، صلاة بعد الاحرام",
                      "y2":  2015
                  },
                  {
                      "y":  1230,
                      "x":  1382,
                      "text":  ". يع",
                      "y2":  1260
                  },
                  {
                      "y":  1262,
                      "x":  1011,
                      "text":  "الإحرام مسنونات",
                      "y2":  1262
                  },
                  {
                      "y":  1385,
                      "x":  1050,
                      "text":  "يلي: ما الإحرام أراد لمن يسن",
                      "y2":  1392
                  },
                  {
                      "y":  1502,
                      "x":  1023,
                      "text":  "ورداء إزار في الرجل إحرام",
                      "y2":  1512
                  },
                  {
                      "y":  1570,
                      "x":  1228,
                      "text":  "ونعلين. أبيضين",
                      "y2":  1575
                  },
                  {
                      "y":  1623,
                      "x":  1023,
                      "text":  "شاءت ما فتلبس الـمرأة أما",
                      "y2":  1641
                  },
                  {
                      "y":  1691,
                      "x":  1021,
                      "text":  "تتبرج لا أن غير ، الثياب من",
                      "y2":  1721
                  },
                  {
                      "y":  1767,
                      "x":  1021,
                      "text":  "ولا تتطيب، ولا بزينة،",
                      "y2":  1769
                  },
                  {
                      "y":  1833,
                      "x":  1024,
                      "text":  "، القفازين تلبس ولا تنتقب،",
                      "y2":  1851
                  },
                  {
                      "y":  1896,
                      "x":  1024,
                      "text":  "عند وكفيها وجهها وتغطي",
                      "y2":  1904
                  },
                  {
                      "y":  1961,
                      "x":  1099,
                      "text":  "لها. المحارم غير الرجال",
                      "y2":  1963
                  }
              ],
    "image":  "page-259.png"
}