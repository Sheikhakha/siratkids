                  },
                  {
                      "y":  472,
                      "x":  214,
                      "text":  "الطيور: وبعض والغنم والبقر والإبل كالخيل الحيوانات من أنواعا الناس بعض يربي",
                      "y2":  509
                  },
                  {
                      "y":  550,
                      "x":  666,
                      "text":  "؟ الزكاة فيه تجب مالا الحيوانات هذه تعد هل",
                      "y2":  575
                  },
                  {
                      "y":  720,
                      "x":  883,
                      "text":  "الزكاة؟ فيها تجب التي البهائم ما",
                      "y2":  743
                  },
                  {
                      "y":  904,
                      "x":  1411,
                      "text":  "مي",
                      "y2":  904
                  },
                  {
                      "y":  930,
                      "x":  959,
                      "text":  "الأنعام ببهيمة المراد",
                      "y2":  938
                  },
                  {
                      "y":  1048,
                      "x":  999,
                      "text":  ": هي و الانعام بهيمة في الزكاة",
                      "y2":  1081
                  },
                  {
                      "y":  1156,
