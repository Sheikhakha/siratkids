                      "y2":  1235
                  },
                  {
                      "y":  1261,
                      "x":  569,
                      "text":  "الأنعام بهيمة في الزكاة وجوب شروط",
                      "y2":  1283
                  },
                  {
                      "y":  1410,
                      "x":  217,
                      "text":  ": الزكاة،وهي وجوب شروط في ذكره سبق ما الأنعام بهيمة في الزكاة لوجوب يشترط",
                      "y2":  1434
                  },
                  {
                      "y":  1711,
                      "x":  1361,
                      "text":  "إليها: يضاف",
                      "y2":  1721
                  },
                  {
                      "y":  1807,
                      "x":  816,
                      "text":  "وتسمى ، العام أكثر العشب ترعى أن",
                      "y2":  1841
                  },
                  {
                      "y":  1818,
                      "x":  211,
                      "text":  "صاحبها لها يوفر التي وأما السائمة،",
                      "y2":  1825
                  },
                  {
