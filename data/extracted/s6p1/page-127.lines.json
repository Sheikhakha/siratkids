                  },
                  {
                      "y":  204,
                      "x":  1050,
                      "text":  "قبره في للمؤمن الله تثبيت",
                      "y2":  213
                  },
                  {
                      "y":  302,
                      "x":  213,
                      "text":  "للإجابة ويوفقه الصادق المؤمن يثبت أنه رحمته ومن بالمؤمنين، رحيم بعباده لطيف الله",
                      "y2":  339
                  },
                  {
                      "y":  381,
                      "x":  214,
                      "text":  "فيشقى الصحيح الجواب عن والمنافق الكافر الله ويضل ويسر، فينعم القبر في الصحيحة",
                      "y2":  409
                  },
                  {
                      "y":  458,
                      "x":  218,
                      "text":  "وي الدنيا الحيوة في التابت بالقول ،امثوا الذير ألله ثبت",
                      "y2":  474
                  },
                  {
                      "y":  463,
                      "x":  1113,
                      "text":  "تعالى: قوله والدليل ويخسر،",
                      "y2":  475
                  },
                  {
                      "y":  535,
                      "x":  726,
                      "text":  ". (٠\" يتكآه ما ألنه ويفعل الظلمي الله ويضل الأخرو",
                      "y2":  574
                  },
                  {
                      "y":  670,
                      "x":  1190,
                      "text":  "القبر نعيم",
                      "y2":  675
                  },
                  {
                      "y":  763,
                      "x":  215,
                      "text":  "الجنة، رياض من روضة قبره فيصبح قبره، في الدائم بالنعيم المؤمن على الله",
                      "y2":  795
                  },
                  {
                      "y":  834,
                      "x":  214,
                      "text":  "أبدلك قد النار، من مقعدك انظر له: ويقال والنشور، البعث يوم إلى فيه منغما يبقى",
                      "y2":  863
                  },
                  {
                      "y":  902,
                      "x":  926,
                      "text":  "جميعا. فيراهما الجنة، من مقعدا به الله",
                      "y2":  932
                  },
                  {
                      "y":  1042,
                      "x":  1177,
                      "text":  "القبر اب عذ",
                      "y2":  1048
                  },
                  {
                      "y":  1139,
                      "x":  211,
                      "text":  "النار حفر من حفرة قبورهم فتصبح قبورهم في والمنافقين الكافرين الله يعذب",
                      "y2":  1178
                  },
                  {
                      "y":  1214,
                      "x":  585,
                      "text":  "من بمطرقة ويضرب والنشور، البعث يوم إلى فيها يعذبون",
                      "y2":  1248
                  },
                  {
                      "y":  1232,
                      "x":  212,
                      "text":  "فيصيح ضربة، حديد",
                      "y2":  1239
                  },
                  {
                      "y":  1297,
                      "x":  979,
                      "text":  "الثقلين. غير يليه من يسمعها صيحة",
                      "y2":  1315
                  },
                  {
                      "y":  1389,
                      "x":  1205,
                      "text":  "نشثاظ",
                      "y2":  1389
                  },
                  {
                      "y":  1493,
                      "x":  266,
                      "text":  "بالتعاون المحرمات، وترك الواجبات فعل على حريصا كان إذا قبره في المسلم ينعم",
