{
    "lines":  [
                  {
                      "y":  182,
                      "x":  1361,
                      "text":  "معلوما",
                      "y2":  182
                  },
                  {
                      "y":  314,
                      "x":  710,
                      "text":  "عنهن: الله رضي المؤمنين أمهات عن المعلومات بعض",
                      "y2":  326
                  },
                  {
                      "y":  385,
                      "x":  1101,
                      "text":  "رجيعيي العامريه زمعة بنت سودة",
                      "y2":  395
                  },
                  {
                      "y":  437,
                      "x":  245,
                      "text":  "توفي فلما بدينهم، فروا الذين المسلمين مع الحبشة إلى وهاجرا وزوجها هي أسلمت المؤمنين أم",
                      "y2":  459
                  },
                  {
                      "y":  496,
                      "x":  250,
                      "text":  ". روفي خديجة وفاة بعد ته النبي تزوجها امرأة أول وهي مسنة أرملة وكانت ؤه النبي تزوجها زوجها",
                      "y2":  519
                  },
                  {
                      "y":  572,
                      "x":  1081,
                      "text":  "يعى الهلاليه خزيمة بنت زينب",
                      "y2":  575
                  },
                  {
                      "y":  624,
                      "x":  247,
                      "text":  "لكثرة المساكين؛ بأم تلقب فكانت المساكين، وحب والرأفة بالرحمة اشتهرت المؤمنين أم",
                      "y2":  644
                  },
                  {
                      "y":  682,
                      "x":  246,
                      "text":  "وعاشت يت الله رسول عليها وصلى المدينة في موتا ة النبي نساء أول وكانت للمساكين، إطعامها",
                      "y2":  698
                  },
                  {
                      "y":  743,
                      "x":  1077,
                      "text":  "أشهر. ثمانية يه الله رسول عند",
                      "y2":  757
                  },
                  {
                      "y":  810,
                      "x":  1154,
                      "text":  "ل",
                      "y2":  810
                  },
                  {
                      "y":  812,
                      "x":  1138,
                      "text":  "يعنها أمية بنت هند سلمة أم",
                      "y2":  823
                  },
                  {
                      "y":  868,
                      "x":  246,
                      "text":  "وفاة بعد ج النبي تزوجها والمدينة للحبشة وهاجرت للإسلام، السابقين من كانت المؤمنين أم",
                      "y2":  891
                  },
                  {
                      "y":  932,
                      "x":  253,
                      "text":  "رحوعو. مونا المؤمنين أمهات أخر وكانت والبر، العبادة على والحرص عقلها برجاحة صفت ،",
                      "y2":  958
                  },
                  {
                      "y":  941,
                      "x":  1381,
                      "text":  "ا زوجها",
                      "y2":  943
                  },
                  {
                      "y":  1001,
                      "x":  1208,
                      "text":  "رعن جحش بنت زينب",
                      "y2":  1008
                  },
                  {
                      "y":  1055,
                      "x":  243,
                      "text":  "كانت شأنها، في القرآن من آيات نزلت للإسلام السابقين من كانت خه، النبي عمة وابنة المؤمنين أم",
                      "y2":  1073
                  },
                  {
                      "y":  1117,
                      "x":  326,
                      "text":  ". سيففى وفاته بعد موتا ىؤج النبي نساء أول وكانت العبادة، على حريصة وكانت النفس سخية كريمة",
                      "y2":  1140
                  },
                  {
                      "y":  1191,
                      "x":  987,
                      "text":  "ميعنها المصطلقيه الحارث بنت جويرية",
                      "y2":  1195
                  },
                  {
                      "y":  1240,
                      "x":  280,
                      "text":  "بعا سلمة أم بعد ه النبي تزوجها جويرية ته الرسول فسماها برة، اسمها كان المؤمنين أم",
                      "y2":  1263
                  },
                  {
                      "y":  1303,
                      "x":  246,
                      "text":  "عاش المصطلق، بني بيوت من بيت مئة فه النبي من بزواجها أعتق حيث قومها، على بركة وكانت",
                      "y2":  1323
                  },
                  {
                      "y":  1367,
                      "x":  985,
                      "text":  "رثي. سفيان أبي بن معاوية خلافة حتى",
                      "y2":  1384
                  },
                  {
                      "y":  1441,
                      "x":  1222,
                      "text":  "رصعنها حيي بنت صفية",
                      "y2":  1452
                  },
                  {
                      "y":  1488,
                      "x":  430,
                      "text":  ". يثثو صداقها عتقها ة النبي وجعل النضير بني سادة من أخطب",
                      "y2":  1506
                  },
                  {
                      "y":  1501,
                      "x":  1300,
                      "text":  "بن حيي ابنة",
                      "y2":  1514
                  },
                  {
                      "y":  1556,
                      "x":  1040,
                      "text":  "تبلجا سفيان أبى بنت رملة حبيبة أم",
                      "y2":  1566
                  },
                  {
                      "y":  1616,
                      "x":  247,
                      "text":  "عم بنات من وهي رافي، سفيان أبي بن معاوية وأخوها حرب بن سفيان أبو أبوها المؤمنين أم",
                      "y2":  1637
                  },
                  {
                      "y":  1672,
                      "x":  247,
                      "text":  "منها، صداقا أكثر هي من نسائه في ولا منها إليه نسبا أقرب هي من أزواجه في ليس فه الرسول",
                      "y2":  1697
                  },
                  {
                      "y":  1745,
                      "x":  1055,
                      "text":  "هوكها. الورعات العابدات من وكانت",
                      "y2":  1755
                  },
                  {
                      "y":  1807,
                      "x":  1040,
                      "text":  "مقث الهلالية الحارث بنت ميمونة",
                      "y2":  1816
                  },
                  {
                      "y":  1861,
                      "x":  245,
                      "text":  "وهي فه للنبي نفسها وهبت حين القضاء عمرة من فراغه بعد ه النبي تزوجها المؤمنين أم",
                      "y2":  1883
                  },
                  {
                      "y":  1923,
                      "x":  918,
                      "text":  "عنها. الله رضي له النبي تزوجها امرأة آخر",
                      "y2":  1941
                  },
                  {
                      "y":  1899,
                      "x":  1692,
