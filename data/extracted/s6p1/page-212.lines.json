                      "text":  "الدرس",
                      "y2":  273
                  },
                  {
                      "y":  364,
                      "x":  382,
                      "text":  "الرابع",
                      "y2":  364
                  },
                  {
                      "y":  271,
                      "x":  707,
                      "text":  "والفضة الذهب زكاة",
                      "y2":  277
                  },
                  {
                      "y":  340,
                      "x":  772,
                      "text":  "التجارة وعروض",
                      "y2":  340
                  },
                  {
                      "y":  338,
                      "x":  1391,
                      "text":  "الزكي",
                      "y2":  338
                  },
                  {
                      "y":  957,
                      "x":  241,
                      "text":  "ويملك الملابس، لبيع محالا خالد ويملك والفضة، الذهب لبيع محلا محمد يملك",
                      "y2":  980
                  },
                  {
                      "y":  1048,
                      "x":  240,
                      "text":  "كهذه أموالا يمتلكون الناس من كثير وهناك السيارات، لبيع معرضا الله عبد",
                      "y2":  1086
                  },
                  {
                      "y":  1154,
                      "x":  1177,
                      "text":  "الشخصية: لاستعمالاتهم",
                      "y2":  1158
                  },
                  {
                      "y":  1238,
                      "x":  451,
                      "text":  "توفرها؟ من لابد شروطا هناك أن أو الزكاة جميعا عليهم تجب فهل",
                      "y2":  1248
                  },
                  {
                      "y":  1320,
                      "x":  411,
                      "text":  "الزكاة؟ فيه وجبت الأموال هذه من المسلم ملكه إذا الذي المقدار ما",
                      "y2":  1332
                  },
                  {
                      "y":  1402,
                      "x":  690,
                      "text":  "التجارية؟ المحلات أصحاب على الزكاة تجب متى -",
                      "y2":  1431
                  },
                  {
                      "y":  1508,
                      "x":  1442,
                      "text":  "مي",
                      "y2":  1508
                  },
                  {
                      "y":  1521,
                      "x":  493,
                      "text":  "النقدية والأوراق والفضة الذهب :زكاة أولا",
                      "y2":  1542
                  },
                  {
                      "y":  1563,
                      "x":  1442,
                      "text":  "ي",
                      "y2":  1563
                  },
                  {
                      "y":  1675,
                      "x":  313,
                      "text":  "الزكاة، وجوب شروط في ذكره سبق ما والفضة الذهب في الزكاة لوجوب يشترط",
                      "y2":  1699
                  },
                  {
                      "y":  1776,
                      "x":  1515,
                      "text":  ": وهي",
                      "y2":  1776
                  }
              ],
