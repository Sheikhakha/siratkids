                      "y2":  574
                  },
                  {
                      "y":  1209,
                      "x":  447,
                      "text":  "الميت. بدفن التعجيل",
                      "y2":  1227
                  },
                  {
                      "y":  1369,
                      "x":  267,
                      "text":  "والدعاء القبر، على الوقوف",
                      "y2":  1377
                  },
                  {
                      "y":  1446,
                      "x":  473,
                      "text":  "الدفن. بعد للميت",
                      "y2":  1456
                  },
                  {
                      "y":  1553,
                      "x":  267,
                      "text":  "ومنه: لفظ، بأي الميت أهل تعزية -",
                      "y2":  1579
                  },
                  {
                      "y":  1615,
                      "x":  264,
                      "text":  "الله أحسن أجرك، الله عظم",
                      "y2":  1631
                  },
                  {
                      "y":  1691,
                      "x":  397,
                      "text":  "لميتك. الله غفر عزاءك،",
                      "y2":  1709
                  },
                  {
                      "y":  624,
                      "x":  1005,
                      "text":  "الحالة؟ هذه في له يشرع الذي ما",
                      "y2":  639
                  },
                  {
                      "y":  918,
                      "x":  1190,
                      "text":  "الجنائز: سنن",
                      "y2":  920
                  },
                  {
                      "y":  1062,
                      "x":  1053,
                      "text":  "منها: مراعاتها ينبغي سنن بز",
                      "y2":  1091
                  },
                  {
                      "y":  1077,
                      "x":  1497,
                      "text":  "للجنا",
                      "y2":  1077
                  },
                  {
                      "y":  1212,
                      "x":  1018,
                      "text":  "النساء. دون للرجال القبور زيارة",
                      "y2":  1233
                  },
                  {
                      "y":  1375,
                      "x":  986,
                      "text":  "حتى والانتظار ، الجنازة مع المشى",
                      "y2":  1393
                  },
                  {
                      "y":  1439,
                      "x":  1418,
                      "text":  "تدفن.",
                      "y2":  1439
                  },
                  {
                      "y":  1558,
                      "x":  987,
                      "text":  "إليه وإنا لله إنا المصاب: قول ه",
                      "y2":  1577
                  },
                  {
                      "y":  1656,
                      "x":  1378,
                      "text":  "راجعون.",
                      "y2":  1656
                  },
                  {
                      "y":  1799,
                      "x":  1068,
                      "text":  ": المقبرة دخل إذا الزائر قول",
                      "y2":  1832
                  },
                  {
                      "y":  1884,
                      "x":  257,
                      "text":  "السستقدمين الله ويرحم والسسلمين، المؤمنين من الديار أهل على الشلام",
                      "y2":  1916
                  },
                  {
                      "y":  1960,
                      "x":  782,
